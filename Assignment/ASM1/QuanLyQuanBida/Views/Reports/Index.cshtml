@model QuanLyQuanBida.ViewModels.ReportsDashboardViewModel
@{
    ViewData["Title"] = "Doanh thu & Báo cáo - BOLT BILLIARDS";
    Layout = "_AdminLayout";
    decimal revBase = Model.TotalRevenue > 0 ? Model.TotalRevenue : 1m;
    int tablePct = (int)Math.Round(Model.TableRevenue * 100m / revBase);
    int fnbPct = Math.Max(0, 100 - tablePct);
    int cashPct = (int)Math.Round(Model.CashRevenue * 100m / revBase);
    int qrPct = (int)Math.Round(Model.TransferRevenue * 100m / revBase);
    int cardPct = Math.Max(0, 100 - cashPct - qrPct);

    // Tính tọa độ SVG biểu đồ động từ SQL Server (HourlyToday vs HourlyYesterday)
    decimal maxVal = Math.Max(500000m, Math.Max(Model.HourlyToday.Max(), Model.HourlyYesterday.Max()));
    string[] timeLabels = { "08:00", "10:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" };
    string todayPts = string.Join(" ", Enumerable.Range(0, 8).Select(i =>
    {
        int x = 60 + i * 98;
        int y = 210 - (int)Math.Round((double)(Model.HourlyToday[i] / maxVal) * 175);
        return $"{x},{y}";
    }));
    string yestPts = string.Join(" ", Enumerable.Range(0, 8).Select(i =>
    {
        int x = 60 + i * 98;
        int y = 210 - (int)Math.Round((double)(Model.HourlyYesterday[i] / maxVal) * 175);
        return $"{x},{y}";
    }));
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-controller="Reports" asp-action="Index">Quản trị & Báo cáo</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Doanh thu & Báo cáo</span>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="badge text-uppercase fw-bold px-2 py-1 mb-1" style="background: rgba(166, 255, 0, 0.15); color: var(--primary-neon);">
                <i class="bi bi-graph-up-arrow me-1"></i> PHÂN TÍCH TÀI CHÍNH THỜI GIAN THỰC
            </div>
            <h2 class="h3 fw-bold text-white mb-1 font-heading">
                Doanh thu <span style="color: var(--primary-neon);">&</span> Báo cáo
            </h2>
            <div class="text-muted small">Theo dõi hiệu quả kinh doanh, cơ cấu doanh thu tiền bàn - dịch vụ và cân đối thu chi toàn câu lạc bộ</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-danger btn-sm action-btn-labeled" data-bs-toggle="modal" data-bs-target="#expenseModal">
                <i class="bi bi-cash-coin"></i><span>Lập Phiếu Chi</span>
            </button>
            <button class="btn btn-dark btn-sm border-secondary text-light action-btn-labeled" onclick="window.print();">
                <i class="bi bi-printer"></i><span>In báo cáo</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-10 border-success text-success d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỘ LỌC KHOẢNG THỜI GIAN THẬT (GET /Reports?range=...) -->
    <div class="card bg-dark border-secondary border-opacity-50 mb-4">
        <div class="card-body py-3 px-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-semibold mb-1">Khoảng thời gian:</label>
                    <select name="range" class="form-select form-select-bolt" style="height: 38px;" onchange="this.form.submit();">
                        <option value="all" selected="@(Model.SelectedRange == "all" ? "selected" : null)">Toàn bộ dữ liệu (Đồng bộ Hóa đơn)</option>
                        <option value="today" selected="@(Model.SelectedRange == "today" ? "selected" : null)">Hôm nay (@DateTime.Today.ToString("dd/MM/yyyy"))</option>
                        <option value="yesterday" selected="@(Model.SelectedRange == "yesterday" ? "selected" : null)">Hôm qua (@DateTime.Today.AddDays(-1).ToString("dd/MM/yyyy"))</option>
                        <option value="7days" selected="@(Model.SelectedRange == "7days" ? "selected" : null)">7 ngày gần nhất</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label text-muted small fw-semibold mb-1">Từ ngày:</label>
                    <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-bolt" style="height: 38px;" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label text-muted small fw-semibold mb-1">Đến ngày:</label>
                    <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-bolt" style="height: 38px;" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-bolt-neon w-100" style="height: 38px;"><i class="bi bi-funnel-fill"></i><span>Áp dụng</span></button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4 THẺ KPI DOANH THU THẬT -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card p-3 bg-dark border border-secondary border-opacity-50">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-uppercase text-secondary small fw-bold" style="font-size: 0.72rem;">TỔNG DOANH THU</span>
                    <i class="bi bi-cash-stack" style="color: var(--primary-neon);"></i>
                </div>
                <div class="h3 fw-bold text-white mb-1 font-heading">@Model.TotalRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                <div class="small" style="color: var(--primary-neon);">Chi phí phiếu chi: @Model.TotalExpenses.ToString("N0") đ</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card p-3 bg-dark border border-secondary border-opacity-50">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-uppercase text-secondary small fw-bold" style="font-size: 0.72rem;">DOANH THU TIỀN BÀN</span>
                    <i class="bi bi-grid-3x3-gap text-info"></i>
                </div>
                <div class="h3 fw-bold text-white mb-1 font-heading">@Model.TableRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                <div class="small text-info">Chiếm @tablePct% • @Model.PlayingTableCount/@Model.TotalTableCount bàn đang chơi</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card p-3 bg-dark border border-secondary border-opacity-50">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-uppercase text-secondary small fw-bold" style="font-size: 0.72rem;">DOANH THU DỊCH VỤ F&B</span>
                    <i class="bi bi-cup-straw" style="color: #c084fc;"></i>
                </div>
                <div class="h3 fw-bold text-white mb-1 font-heading">@Model.ServiceRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                <div class="small" style="color: #c084fc;">Chiếm @fnbPct% • Giảm giá: -@Model.TotalDiscount.ToString("N0") đ</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card p-3 bg-dark border border-secondary border-opacity-50">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-uppercase text-secondary small fw-bold" style="font-size: 0.72rem;">HÓA ĐƠN HOÀN TẤT</span>
                    <i class="bi bi-receipt-cutoff text-warning"></i>
                </div>
                <div class="h3 fw-bold text-white mb-1 font-heading">@Model.CompletedInvoiceCount <small class="fs-6 text-muted fw-normal">Hóa đơn</small></div>
                <div class="small @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">Lợi nhuận ròng: @Model.NetProfit.ToString("N0") đ</div>
            </div>
        </div>
    </div>
     <!-- BIỂU ĐỒ CHART.JS (LAB 6) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-xl-7">
        <div class="card bg-dark border-secondary border-opacity-50 h-100">
            <div class="card-header bg-black bg-opacity-40 py-3">
                <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6">
                    Biểu đồ Doanh thu theo khoảng thời gian
                </h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="card bg-dark border-secondary border-opacity-50 h-100">
            <div class="card-header bg-black bg-opacity-40 py-3">
                <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6">
                    Top 5 Thức uống bán chạy
                </h5>
            </div>
            <div class="card-body">
                <canvas id="topDrinksChart" height="165"></canvas>
            </div>
        </div>
    </div>
</div>
    <!-- HÀNG 2: BIỂU ĐỒ SVG ĐỘNG THEO GIỜ & CƠ CẤU THANH TOÁN -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-8">
            <div class="card bg-dark border-secondary border-opacity-50 h-100">
                <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6">Biểu đồ doanh thu theo khung giờ (Hôm nay vs Hôm qua)</h5>
                        <div class="text-muted small">So sánh doanh thu theo từng khung giờ hoạt động trong ngày (08:00 - 24:00)</div>
                    </div>
                    <div class="d-flex gap-3 small">
                        <span class="text-light"><span class="d-inline-block me-1" style="width:10px;height:10px;background:var(--primary-neon);"></span>Hôm nay</span>
                        <span class="text-secondary"><span class="d-inline-block me-1" style="width:10px;height:10px;background:#64748b;"></span>Hôm qua</span>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div style="width:100%; height:250px;">
                        <svg viewBox="0 0 800 240" class="w-100 h-100" preserveAspectRatio="none">
                            <line x1="50" y1="35" x2="770" y2="35" stroke="#334155" stroke-dasharray="3,3" />
                            <line x1="50" y1="95" x2="770" y2="95" stroke="#334155" stroke-dasharray="3,3" />
                            <line x1="50" y1="155" x2="770" y2="155" stroke="#334155" stroke-dasharray="3,3" />
                            <line x1="50" y1="210" x2="770" y2="210" stroke="#475569" stroke-width="1.5" />
                            <text x="42" y="39" fill="#94a3b8" font-size="10" text-anchor="end">@((maxVal / 1000m).ToString("N0"))K</text>
                            <text x="42" y="125" fill="#94a3b8" font-size="10" text-anchor="end">@((maxVal / 2000m).ToString("N0"))K</text>
                            <text x="42" y="214" fill="#94a3b8" font-size="10" text-anchor="end">0</text>

                            <polyline fill="none" stroke="#64748b" stroke-width="2" stroke-dasharray="5,4" points="@yestPts" />
                            <polyline fill="none" stroke="#a6ff00" stroke-width="3" points="@todayPts" />

                            @for (int i = 0; i < 8; i++)
                            {
                                int x = 60 + i * 98;
                                int y = 210 - (int)Math.Round((double)(Model.HourlyToday[i] / maxVal) * 175);
                                <circle cx="@x" cy="@y" r="4" fill="#a6ff00" />
                                @Html.Raw($"<text x=\"{x}\" y=\"230\" fill=\"#94a3b8\" font-size=\"10\" text-anchor=\"middle\">{timeLabels[i]}</text>")
                            }
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card bg-dark border-secondary border-opacity-50 h-100">
                <div class="card-header bg-black bg-opacity-40 py-3">
                    <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6">Cơ cấu nguồn thu & Thanh toán</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between gap-3">
                    <div>
                        <div class="d-flex justify-content-between small mb-1"><span class="text-info fw-semibold">VietQR / Chuyển khoản</span><strong>@Model.TransferRevenue.ToString("N0") đ (@qrPct%)</strong></div>
                        <div class="progress bg-black mb-3" style="height: 8px;"><div class="progress-bar bg-info" style="width:@qrPct%"></div></div>

                        <div class="d-flex justify-content-between small mb-1"><span class="text-warning fw-semibold">Tiền mặt tại két</span><strong>@Model.CashRevenue.ToString("N0") đ (@cashPct%)</strong></div>
                        <div class="progress bg-black mb-3" style="height: 8px;"><div class="progress-bar bg-warning" style="width:@cashPct%"></div></div>

                        <div class="d-flex justify-content-between small mb-1"><span class="text-light fw-semibold">Quẹt thẻ POS</span><strong>@Model.CardRevenue.ToString("N0") đ (@cardPct%)</strong></div>
                        <div class="progress bg-black" style="height: 8px;"><div class="progress-bar bg-success" style="width:@cardPct%"></div></div>
                    </div>

                    <div class="pt-3 border-top border-secondary border-opacity-25">
                        <div class="small text-uppercase text-muted fw-bold mb-2">Top sản phẩm bán chạy</div>
                        @foreach (var top in Model.TopItems.Take(4))
                        {
                            <div class="d-flex justify-content-between align-items-center small py-1 border-bottom border-secondary border-opacity-10">
                                <span class="text-light text-truncate pe-2">@top.Name <span class="text-muted">(x@top.TotalQty)</span></span>
                                <strong style="color: var(--primary-neon);">@top.TotalRevenue.ToString("N0") đ</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 3: BẢNG HÓA ĐƠN & PHIẾU CHI ĐỒNG BỘ SQL SERVER -->
    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white small text-uppercase font-heading"><i class="bi bi-receipt text-success me-2"></i>HÓA ĐƠN ĐÃ THANH TOÁN (@Model.Invoices.Count BILL)</span>
                    <a asp-controller="Invoices" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Xem tất cả</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 small">
                        <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                            <tr>
                                <th class="ps-3">MÃ HĐ</th>
                                <th>BÀN</th>
                                <th>KHÁCH HÀNG</th>
                                <th>THỜI GIAN</th>
                                <th class="text-end pe-3">TỔNG THU</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Invoices.Take(10))
                            {
                                <tr>
                                    <td class="ps-3 font-monospace text-info fw-bold">@inv.InvoiceCode</td>
                                    <td>@inv.TableName</td>
                                    <td>@inv.CustomerName</td>
                                    <td class="text-muted">@inv.StartTime.ToString("dd/MM HH:mm")</td>
                                    <td class="text-end pe-3 fw-bold" style="color: var(--primary-neon);">@inv.TotalPayment.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white small text-uppercase font-heading"><i class="bi bi-cash-coin text-danger me-2"></i>PHIẾU CHI HOẠT ĐỘNG (@Model.Vouchers.Count PHIẾU)</span>
                    <strong class="text-danger small">-@Model.TotalExpenses.ToString("N0") đ</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 small">
                        <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                            <tr>
                                <th class="ps-3">MÃ CHI</th>
                                <th>NỘI DUNG CHI</th>
                                <th class="text-end pe-3">SỐ TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vouchers)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace text-warning fw-bold">@v.Code</td>
                                    <td>
                                        <div class="text-white fw-semibold">@v.Purpose</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@v.ExpenseTypeName • @v.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-danger">-@v.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL LẬP PHIẾU CHI CHUYÊN NGHIỆP -->
<div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-accent-danger text-light">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-cash-coin text-danger fs-5"></i>
                    <div>
                        <h5 class="modal-title font-heading fw-bold mb-0">LẬP PHIẾU CHI HOẠT ĐỘNG</h5>
                        <div class="small text-muted">Ghi nhận khoản chi phí vận hành và cập nhật lợi nhuận ròng tự động</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateVoucher" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-section-title"><i class="bi bi-wallet2 text-danger"></i> Chi tiết khoản chi</div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Loại chi phí <span class="text-danger">*</span></label>
                        <select name="expenseTypeId" class="form-select form-select-bolt" required>
                            @foreach (var et in Model.ExpenseTypes)
                            {
                                <option value="@et.Id">@et.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Số tiền chi (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" name="amount" class="form-control form-control-bolt fw-bold text-danger" min="1000" step="1000" value="350000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Nội dung / Mục đích chi <span class="text-danger">*</span></label>
                        <input type="text" name="purpose" class="form-control form-control-bolt" placeholder="VD: Mua đá viên, bảo trì đèn bàn..." required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-uppercase text-muted">Ghi chú thêm</label>
                        <input type="text" name="notes" class="form-control form-control-bolt" placeholder="Tùy chọn..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm fw-bold px-4"><i class="bi bi-check-circle-fill me-1"></i>Lưu Phiếu Chi</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Biểu đồ doanh thu theo khoảng thời gian
        const revLabels = @Json.Serialize(ViewBag.RevenueLabels);
        const revValues = @Json.Serialize(ViewBag.RevenueValues);

        const revCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revCtx, {
            type: 'bar', // Có thể đổi thành 'line'
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revValues,
                    backgroundColor: 'rgba(166, 255, 0, 0.5)',
                    borderColor: 'rgba(166, 255, 0, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                plugins: { legend: { labels: { color: '#e2e8f0' } } },
                scales: {
                    x: { ticks: { color: '#94a3b8' } },
                    y: { beginAtZero: true, ticks: { color: '#94a3b8' } }
                }
            }
        });

        // 2. Biểu đồ Top 5 thức uống bán chạy
        const drinkLabels = @Json.Serialize(ViewBag.TopDrinkLabels);
        const drinkValues = @Json.Serialize(ViewBag.TopDrinkValues);

        const drinkCtx = document.getElementById('topDrinksChart').getContext('2d');
        new Chart(drinkCtx, {
            type: 'bar', // Có thể đổi thành 'doughnut' hoặc 'pie'
            data: {
                labels: drinkLabels,
                datasets: [{
                    label: 'Số lượng đã bán',
                    data: drinkValues,
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(153, 102, 255, 0.6)',
                        'rgba(255, 99, 132, 0.6)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
