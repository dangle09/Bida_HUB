@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục mới";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0 compact-form-shell">
    <!-- Breadcrumb điều hướng nhấn được -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="pos-breadcrumb d-flex align-items-center mb-0">
            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
            <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <a asp-controller="Categories" asp-action="Index">Danh mục hàng hóa</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-white fw-semibold">Thêm mới</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm action-btn-labeled">
            <i class="bi bi-arrow-left"></i><span>Quay lại danh sách</span>
        </a>
    </div>

    <div class="row g-3 align-items-start">
        <!-- CỘT TRÁI: FORM NHẬP LIỆU GỌN GÀNG -->
        <div class="col-12 col-lg-8">
            <div class="card form-workspace-card">
                <div class="card-header bg-black bg-opacity-40 py-2 px-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-folder-plus fs-5" style="color: var(--primary-neon);"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-white font-heading">TẠO DANH MỤC HÀNG HÓA MỚI</h6>
                            <div class="small text-muted fw-normal" style="font-size: 0.76rem;">Tự động đồng bộ vào bộ lọc Thực đơn, POS và Trang Khách</div>
                        </div>
                    </div>
                    <span class="badge bg-black border border-success text-success font-monospace">AdminOrManager</span>
                </div>
                <div class="card-body p-3">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                        <div class="form-section-title">
                            <i class="bi bi-info-circle text-info"></i> 1. Thông tin định danh danh mục
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label small fw-bold text-uppercase text-muted mb-1">Mã Code danh mục <span class="text-danger">*</span></label>
                                <input asp-for="Code" id="catCodeInput" class="form-control form-control-bolt font-monospace text-uppercase" placeholder="VD: SNACK, TEA, CUE" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label small fw-bold text-uppercase text-muted mb-1">Tên danh mục hiển thị <span class="text-danger">*</span></label>
                                <input asp-for="Name" id="catNameInput" class="form-control form-control-bolt" placeholder="VD: Trà Trái Cây & Đồ Uống Giải Nhiệt" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-section-title">
                            <i class="bi bi-image text-warning"></i> 2. Hình ảnh đại diện danh mục
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-1">Tải ảnh từ máy tính (.jpg, .png, .webp)</label>
                                <input type="file" name="ImageFile" id="catImageFile" class="form-control form-control-bolt" accept="image/*" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Image" class="form-label small fw-bold text-uppercase text-muted mb-1">Hoặc đường dẫn ảnh có sẵn</label>
                                <input asp-for="Image" id="catImagePath" class="form-control form-control-bolt font-monospace small" placeholder="VD: images/fnb/fnb-1-caphe-muoi.png" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                                <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-bolt-neon btn-sm px-4">
                                <i class="bi bi-check-circle-fill"></i> Lưu Danh Mục Mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: THẺ XEM TRƯỚC TRỰC TIẾP -->
        <div class="col-12 col-lg-4">
            <div class="card detail-hero-card">
                <div class="card-body p-3">
                    <div class="form-section-title">
                        <i class="bi bi-eye text-info"></i> Xem trước hiển thị (Live Preview)
                    </div>
                    <div class="text-center mb-3">
                        <div class="detail-avatar-frame mb-2" style="width: 118px; height: 118px;">
                            <img id="catPreviewImg" src="~/images/bolt-billiards-logo.png" alt="Preview" class="w-100 h-100 object-fit-cover" />
                        </div>
                        <div class="mb-2">
                            <span id="catPreviewCode" class="badge bg-black border border-info text-info font-monospace px-2 py-1">NEW_CODE</span>
                        </div>
                        <h5 id="catPreviewName" class="fw-bold text-white font-heading mb-1">Tên danh mục mới</h5>
                        <div class="small text-muted">Nhóm hàng hóa • Đồng bộ POS & Web Khách</div>
                    </div>
                    <div class="p-3 bg-black bg-opacity-50 border border-secondary border-opacity-25 small text-muted">
                        <div class="fw-bold text-light mb-1"><i class="bi bi-lightbulb text-warning me-1"></i>Gợi ý chuẩn đặt mã:</div>
                        <ul class="mb-0 ps-3">
                            <li>Mã Code viết IN HOA không dấu (VD: <code>DRINK</code>, <code>FOOD</code>, <code>BEER</code>).</li>
                            <li>Sau khi tạo, bạn có thể thêm các món thuộc nhóm này tại mục <strong>Thực đơn & Dịch vụ</strong>.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const codeEl = document.getElementById('catCodeInput');
        const nameEl = document.getElementById('catNameInput');
        const fileEl = document.getElementById('catImageFile');
        const pathEl = document.getElementById('catImagePath');
        const prevImg = document.getElementById('catPreviewImg');

        codeEl.addEventListener('input', () => {
            document.getElementById('catPreviewCode').textContent = (codeEl.value || 'NEW_CODE').trim().toUpperCase();
        });
        nameEl.addEventListener('input', () => {
            document.getElementById('catPreviewName').textContent = nameEl.value.trim() || 'Tên danh mục mới';
        });
        fileEl.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = ev => prevImg.src = ev.target.result;
                reader.readAsDataURL(file);
            }
        });
        pathEl.addEventListener('input', () => {
            if (pathEl.value.trim()) prevImg.src = '/' + pathEl.value.trim().replace(/^\/+/, '');
        });
    </script>
}
