@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Chi tiết Danh mục - " + Model.Name;
    Layout = "_AdminLayout";
    var items = ViewBag.Items as List<QuanLyQuanBida.Models.ServiceItem> ?? new List<QuanLyQuanBida.Models.ServiceItem>();
    var stockDict = ViewBag.StockDict as Dictionary<int, int> ?? new Dictionary<int, int>();
    int totalStock = ViewBag.TotalStock ?? 0;
    int activeCount = ViewBag.ActiveCount ?? 0;
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container-fluid px-0">
    <!-- Breadcrumb & Header Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="pos-breadcrumb d-flex align-items-center mb-0">
            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
            <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <a asp-controller="Categories" asp-action="Index">Danh mục hàng hóa</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-white fw-semibold">Chi tiết nhóm (#@Model.Id)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm action-btn-labeled">
                <i class="bi bi-arrow-left"></i><span>Quay lại</span>
            </a>
            <a asp-controller="Menu" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-outline-info btn-sm action-btn-labeled">
                <i class="bi bi-funnel"></i><span>Mở trong Thực đơn</span>
            </a>
            @if (isAdminOrManager)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark btn-sm action-btn-labeled">
                    <i class="bi bi-pencil-square"></i><span>Chỉnh sửa</span>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm action-btn-labeled">
                    <i class="bi bi-trash"></i><span>Xóa</span>
                </a>
            }
        </div>
    </div>

    <!-- KHỐI TỔNG QUAN DANH MỤC (ĐỒNG BỘ PHONG CÁCH THÊM / SỬA / XÓA) -->
    <div class="card form-workspace-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-folder2-open fs-5" style="color: var(--primary-neon);"></i>
                <div>
                    <h6 class="mb-0 fw-bold text-white font-heading">CHI TIẾT DANH MỤC HÀNG HÓA</h6>
                    <div class="small text-muted fw-normal" style="font-size: 0.76rem;">Theo dõi thông tin nhóm hàng hóa và toàn bộ sản phẩm đang liên kết trong thực đơn</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-black border border-info text-info font-monospace">@Model.Code</span>
                <span class="badge bg-black border border-secondary text-muted font-monospace">ID #@Model.Id</span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <div class="detail-avatar-frame" style="width: 78px; height: 78px;">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="~/@Model.Image" alt="@Model.Name" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <i class="bi bi-folder2-open fs-2 text-muted"></i>
                        }
                    </div>
                </div>
                <div class="col">
                    <h4 class="fw-bold text-white mb-1 font-heading">@Model.Name</h4>
                    <div class="text-muted small">Đồng bộ trực tiếp với Thực đơn POS, Kho &amp; Nhập hàng và Giao diện Khách hàng</div>
                </div>
                <div class="col-12 col-lg-auto">
                    <div class="row g-2 align-items-stretch">
                        <div class="col-4">
                            <div class="detail-mini-kpi text-center" style="border-left-color: var(--primary-neon); min-width: 118px;">
                                <div class="detail-info-label justify-content-center text-nowrap">Tổng món</div>
                                <div class="fs-4 fw-bold text-white lh-1 mt-1">@items.Count</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="detail-mini-kpi text-center" style="border-left-color: #22c55e; min-width: 118px;">
                                <div class="detail-info-label justify-content-center text-nowrap">Đang bán</div>
                                <div class="fs-4 fw-bold text-success lh-1 mt-1">@activeCount</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="detail-mini-kpi text-center" style="border-left-color: #38bdf8; min-width: 118px;">
                                <div class="detail-info-label justify-content-center text-nowrap">Tổng tồn kho</div>
                                <div class="fs-4 fw-bold text-info lh-1 mt-1">@totalStock</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH SẢN PHẨM THUỘC DANH MỤC (ĐỒNG BỘ NỀN TỐI SÂU & RÚT GỌN) -->
    <div class="card form-workspace-card overflow-hidden">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-cup-hot text-warning fs-5"></i>
                <div>
                    <h6 class="mb-0 fw-bold text-white font-heading">SẢN PHẨM THUỘC DANH MỤC (@items.Count MÓN)</h6>
                    <div class="small text-muted fw-normal" style="font-size: 0.76rem;">Danh sách đồ uống, món ăn và phụ kiện thuộc nhóm @Model.Name</div>
                </div>
            </div>
            @if (isAdminOrManager)
            {
                <a asp-controller="Menu" asp-action="Create" class="btn btn-bolt-neon btn-sm py-1 px-3" style="font-size: 0.76rem;">
                    <i class="bi bi-plus-circle"></i> Thêm món vào nhóm
                </a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="text-secondary small text-uppercase">
                    <tr>
                        <th class="text-center ps-3" style="width: 52px;">STT</th>
                        <th class="text-center" style="width: 64px;">ẢNH</th>
                        <th style="width: 135px;">MÃ MÓN</th>
                        <th>TÊN MÓN ĂN / ĐỒ UỐNG / DỤNG CỤ</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-center">TỒN KHO</th>
                        <th class="text-end">ĐƠN GIÁ BÁN</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-end pe-3" style="width: 105px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        int stt = 1;
                        foreach (var item in items)
                        {
                            int stock = stockDict.ContainsKey(item.Id) ? stockDict[item.Id] : 0;
                            <tr>
                                <td class="text-center ps-3 text-muted font-monospace">@(stt++)</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="~/@item.Image" alt="@item.Name" style="width: 38px; height: 38px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(166, 255, 0, 0.3);" />
                                    }
                                    else
                                    {
                                        <div style="width: 38px; height: 38px; background: #161c2b; border: 1px solid #232c42; border-radius: 2px; display: inline-flex; align-items: center; justify-content: center; color: #55657e;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td><span class="badge bg-black border border-info text-info font-monospace">@item.Code</span></td>
                                <td class="fw-bold text-white">@item.Name</td>
                                <td class="text-center text-muted">@item.Unit</td>
                                <td class="text-center fw-bold @(stock <= 10 ? "text-warning" : "text-success")">@stock @item.Unit</td>
                                <td class="text-end fw-bold font-heading" style="color: var(--primary-neon);">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success text-dark fw-bold">ĐANG BÁN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-light fw-bold">TẠM NGƯNG</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="action-btn-group">
                                        <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info action-btn" title="Xem chi tiết món">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isAdminOrManager)
                                        {
                                            <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning action-btn" title="Sửa món">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Chưa có sản phẩm nào thuộc danh mục này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
