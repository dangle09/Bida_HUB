@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khi click nút Gọi món trên card bàn
            document.querySelectorAll('.btn-action-order').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tableName = this.getAttribute('data-table') || 'BÀN';
                    var target = document.getElementById('modalThemMonTable');
                    if (target) target.textContent = tableName;
                });
            });

            // Khi click nút Đổi bàn trên card bàn
            document.querySelectorAll('.btn-action-transfer').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tableName = this.getAttribute('data-table') || 'BÀN';
                    var target = document.getElementById('inputCurrentTableTransfer');
                    if (target) target.value = tableName;
                });
            });

            // Khi click nút Thanh toán trên card bàn
            document.querySelectorAll('.btn-action-pay').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tableName = this.getAttribute('data-table') || 'BÀN';
                    var total = this.getAttribute('data-total') || '0 đ';
                    var targetTitle = document.getElementById('modalPayTableTitle');
                    var targetTotal = document.getElementById('modalPayTotalAmount');
                    if (targetTitle) targetTitle.textContent = tableName;
                    if (targetTotal) targetTotal.textContent = total;
                });
            });

            // Khi click nút Mở bàn trên card trống
            document.querySelectorAll('.btn-action-open').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tableId = this.getAttribute('data-table');
                    var select = document.getElementById('selectOpenTable');
                    if (select && tableId) {
                        select.value = tableId;
                    }
                });
            });
        });
    </script>
}
