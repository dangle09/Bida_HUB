@* ===================================================================================
   WEB QUẢN LÝ (BIDA POS & ADMIN DASHBOARD) - KHUNG GIAO DIỆN CHÍNH (LAYOUT)
   - Tên file: _AdminLayout.cshtml
   - Chức năng: Bộ khung sườn tổng thể của Web Quản lý (Topbar 60px + Sidebar 260px + Footer 35px)
   - Vùng hiển thị nội dung các Tab: @RenderBody()
   - File CSS: wwwroot/css/admin-pos.css
   - Chuẩn viền bo: 2px radius toàn trang
   =================================================================================== *@
@using System.Security.Claims
@inject QuanLyQuanBida.Data.QuanLyQuanBidaContext _layoutDb
@{
    int _topbarTotalTables = _layoutDb.BilliardTables.Count();
    int _topbarPlayingTables = _layoutDb.BilliardTables.Count(t => t.Status == "Đang chơi");
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int _curUserId);
    var _curUser = _curUserId > 0 ? _layoutDb.Users.FirstOrDefault(u => u.Id == _curUserId) : null;
    string _curFullName = _curUser?.FullName ?? User.Identity?.Name ?? "Người dùng";
    string _curUsername = _curUser?.Username ?? User.FindFirstValue("Username") ?? "";
    string _curEmail = _curUser?.Email ?? "";
    string _curPhone = _curUser?.PhoneNumber ?? "";
    string _curJoined = _curUser != null ? _curUser.CreatedAt.ToString("dd/MM/yyyy") : DateTime.Today.ToString("dd/MM/yyyy");
    string _curPath = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BOLT BILLIARDS ADMIN POS</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Admin POS CSS chuẩn Wireframe & Màu đen than - Neon Lime -->
    <link rel="stylesheet" href="~/css/admin-pos.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bida-body">

    <!-- ========================================================= -->
    <!-- 1. [HEADER / TOPBAR] (Cố định trên cùng - Cao 60px)       -->
    <!-- ========================================================= -->
    <header class="bida-topbar">
        <!-- Logo & Thương hiệu -->
        <div class="d-flex align-items-center gap-3">
            <a class="bida-brand" asp-controller="@(User.IsInRole("Waiter") ? "Pos" : "Dashboard")" asp-action="Index" title="@(User.IsInRole("Waiter") ? "Sơ đồ bàn POS" : "Trang chủ tổng quan điều hành")">
                <img src="~/images/bolt-billiards-logo.png" alt="Bolt Billiards" />
                <div>
                    <div class="brand-text"><span style="color: var(--primary-neon);">BOLT</span> BILLIARDS</div>
                    <div class="brand-sub">BIDA HUB POS • CHI NHÁNH ĐỒNG NAI</div>
                </div>
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-bolt-outline btn-sm ms-2 d-none d-md-inline-flex" style="padding: 4px 10px; font-size: 0.75rem; border-radius: 2px !important;" title="Xem trang chủ khách hàng">
                <i class="bi bi-box-arrow-up-right"></i> Trang Khách
            </a>
        </div>

        <!-- Trạng thái quán thời gian thực & Đồng hồ -->
        <div class="d-none d-lg-flex align-items-center gap-3">
            <!-- Đồng hồ thời gian thực và ca trực -->
            <div class="status-pill">
                <i class="bi bi-clock-history" style="color: var(--primary-neon);"></i>
                <span id="posLiveClock" class="fw-semibold">14:35:20</span>
                <span style="color: var(--primary-neon);" id="posShiftName">(Ca Chiều)</span>
            </div>

            <!-- Tình trạng bàn bida đang chơi (đồng bộ trực tiếp từ SQL Server) -->
            <a asp-controller="Pos" asp-action="Index" class="status-pill text-decoration-none text-light" title="Mở Sơ đồ bàn">
                <span class="indicator-dot"></span>
                <span><strong>@_topbarPlayingTables/@_topbarTotalTables</strong> Bàn đang chơi</span>
            </a>
        </div>

        <!-- Avatar & Tên tài khoản / Đăng xuất -->
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn btn-dark dropdown-toggle d-flex align-items-center gap-2 border-0 bg-transparent text-white p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-badge" style="width: 32px; height: 32px; border-radius: 2px; background: var(--primary-neon); color: #000; display: flex; align-items: center; justify-content: center; font-weight: 800;">
                            @((User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                        </div>
                        <div class="text-start d-none d-sm-block">
                            <div class="fw-semibold small" style="line-height: 1.2;">@User.Identity.Name</div>
                            <div style="font-size: 0.72rem; color: var(--primary-neon);">
                                @if (User.IsInRole("Admin"))
                                {
                                    <span>👑 Quản trị viên (Admin)</span>
                                }
                                else if (User.IsInRole("Manager"))
                                {
                                    <span>⭐ Quản lý cơ sở (Manager)</span>
                                }
                                else if (User.IsInRole("Waiter"))
                                {
                                    <span>🎱 Nhân viên Phục vụ (Waiter)</span>
                                }
                                else
                                {
                                    <span>👤 Thu ngân POS (Cashier)</span>
                                }
                            </div>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow border-secondary border-opacity-50" style="border-radius: 2px !important;">
                        <li class="dropdown-header text-uppercase text-secondary" style="font-size: 0.7rem;">Phiên làm việc</li>
                        <li>
                            <div class="px-3 py-1 small">
                                <div class="text-light fw-bold">@User.Identity.Name</div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @(User.IsInRole("Admin") ? "Toàn quyền quản trị hệ thống" : User.IsInRole("Manager") ? "Quyền quản lý điều hành cơ sở" : "Quyền thu ngân bán hàng POS")
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li>
                            <a class="dropdown-item small" href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#modalThongTinCaNhan">
                                <i class="bi bi-person me-2 text-info"></i>Thông tin cá nhân
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item small" href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhau">
                                <i class="bi bi-shield-lock me-2 text-warning"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item small" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe me-2 text-success"></i>Xem Web Vãng Lai
                            </a>
                        </li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="px-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm w-100 text-start d-flex align-items-center gap-2" style="border-radius: 2px !important;">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Đăng xuất</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Login" asp-action="Login" class="btn btn-bolt-neon btn-sm" style="border-radius: 2px !important;">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </a>
            }
        </div>
    </header>

    <!-- ========================================================= -->
    <!-- 2. [SIDEBAR MENU TRÁI] (Rộng 260px, cuộn dọc theo Wireframe)-->
    <!-- ========================================================= -->
    <aside class="bida-sidebar">
        @{
            bool _isAdmin = User.IsInRole("Admin");
            bool _isAdminOrManager = _isAdmin || User.IsInRole("Manager");
            bool _isCashierOrAbove = _isAdminOrManager || User.IsInRole("Cashier");
        }
        @if (_isCashierOrAbove)
        {
            <!-- NHÓM 0: TỔNG QUAN HỆ THỐNG (CHẶN WAITER; CASHIER CHỈ THẤY BÀN LÀM VIỆC THU NGÂN) -->
            <div class="sidebar-heading">— @(_isAdminOrManager ? "TỔNG QUAN HỆ THỐNG" : "BÀN LÀM VIỆC CA TRỰC")</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2" style="color: var(--primary-neon);"></i>
                        <span>@(_isAdminOrManager ? "Trang chủ (Tổng quan)" : "Trang chủ (Thu ngân)")</span>
                    </a>
                </li>
            </ul>
        }

        <!-- NHÓM 1: VẬN HÀNH & BÁN HÀNG -->
        <div class="sidebar-heading">— VẬN HÀNH &amp; BÁN HÀNG</div>
        <ul class="sidebar-menu">
            <li>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pos" ? "active" : "")" asp-controller="Pos" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap-fill text-warning"></i>
                    <span>Sơ đồ bàn (POS)</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">
                    <i class="bi bi-cup-straw text-info"></i>
                    <span>Thực đơn &amp; Dịch vụ</span>
                </a>
            </li>
            @if (_isCashierOrAbove)
            {
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "")" asp-controller="Invoices" asp-action="Index">
                        <i class="bi bi-receipt text-success"></i>
                        <span>Hóa đơn &amp; Thu ngân</span>
                    </a>
                </li>
            }
        </ul>

        @if (_isCashierOrAbove)
        {
            <!-- NHÓM 2: QUẢN LÝ HÀNG HÓA (CHẶN WAITER) -->
            <div class="sidebar-heading">— QUẢN LÝ HÀNG HÓA</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-folder2-open" style="color: var(--primary-neon);"></i>
                        <span>Danh mục hàng hóa</span>
                    </a>
                </li>
                @if (_isAdminOrManager)
                {
                    <li>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" asp-controller="Inventory" asp-action="Index">
                            <i class="bi bi-box-seam" style="color: #60a5fa;"></i>
                            <span>Kho &amp; Nhập hàng</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")" asp-controller="Tables" asp-action="Index">
                            <i class="bi bi-gear-wide-connected" style="color: #c084fc;"></i>
                            <span>Quản lý Bàn &amp; Giá</span>
                        </a>
                    </li>
                }
            </ul>

            <!-- NHÓM 3: HỘI VIÊN & GIẢI ĐẤU (CHẶN WAITER) -->
            <div class="sidebar-heading">— HỘI VIÊN &amp; GIẢI ĐẤU</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-award-fill text-warning"></i>
                        <span>Khách hàng &amp; VIP</span>
                    </a>
                </li>
                @if (_isAdminOrManager)
                {
                    <li>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tournaments" ? "active" : "")" asp-controller="Tournaments" asp-action="Index">
                            <i class="bi bi-trophy-fill text-danger"></i>
                            <span>Giải đấu giao lưu</span>
                        </a>
                    </li>
                }
            </ul>
        }

        <!-- NHÓM 4: QUẢN TRỊ & BÁO CÁO (CHỈ ADMIN / MANAGER) -->
        @if (_isAdminOrManager)
        {
            <div class="sidebar-heading">— QUẢN TRỊ &amp; BÁO CÁO</div>
            <ul class="sidebar-menu">
                @if (_isAdmin)
                {
                    <li>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active" : "")" asp-controller="Staff" asp-action="Index">
                            <i class="bi bi-people-fill text-primary"></i>
                            <span>Nhân sự &amp; Phân ca</span>
                        </a>
                    </li>
                }
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line-fill text-success"></i>
                        <span>Doanh thu &amp; Báo cáo</span>
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AiAssistant" ? "active" : "")" asp-controller="AiAssistant" asp-action="Index">
                        <i class="bi bi-robot" style="color: var(--primary-neon);"></i>
                        <span>AI Trợ lý Bida</span>
                    </a>
                </li>
                @if (_isAdmin)
                {
                    <li>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-sliders text-info"></i>
                            <span>Cài đặt hệ thống</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>

    <!-- ========================================================= -->
    <!-- 3. [VÙNG LÀM VIỆC CHÍNH - MAIN CONTENT]                   -->
    <!-- ========================================================= -->
    <main class="bida-main-content">
        @RenderBody()
    </main>

    <!-- ========================================================= -->
    <!-- 4. [FOOTER / STATUS BAR] (Dưới cùng theo Wireframe)       -->
    <!-- ========================================================= -->
    <footer class="bida-statusbar">
        <div class="statusbar-item">
            <i class="bi bi-hdd-network text-success"></i>
            <span><strong>Bida HUB v1.0</strong> • ASP.NET Core MVC (Đồng bộ thời gian thực)</span>
        </div>
        <div class="statusbar-item d-none d-md-inline-flex">
            <span>Máy in Bill: Sẵn sàng</span>
            <span class="indicator-dot"></span>
        </div>
        <div class="statusbar-item">
            <span>Ca trực: <strong style="color: var(--primary-neon);" id="statusCaTruc">Ca Chiều</strong> (16:00 - 23:59)</span>
        </div>
    </footer>

    <!-- ========================================================================= -->
    <!-- MODAL THÔNG TIN CÁ NHÂN CHUYÊN NGHIỆP (ĐỒNG BỘ TÀI KHOẢN ĐANG ĐĂNG NHẬP) -->
    <!-- ========================================================================= -->
    <div class="modal fade" id="modalThongTinCaNhan" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content text-light">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill text-info fs-5"></i>
                        <div>
                            <h5 class="modal-title font-heading fw-bold mb-0">HỒ SƠ TÀI KHOẢN CÁ NHÂN</h5>
                            <div class="small text-muted">Cập nhật họ tên, số điện thoại và email nhận mật khẩu của tài khoản đang đăng nhập</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Login" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@_curPath" />
                    <div class="modal-body">
                        <div class="row g-4 align-items-center">
                            <div class="col-md-4 text-center">
                                <div class="detail-avatar-frame mb-3" style="width: 112px; height: 112px;">
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center fw-bold"
                                         style="background: linear-gradient(135deg,#a6ff00,#52b700); color: #05080c; font-size: 2.8rem; font-family: 'Montserrat', sans-serif;">
                                        @_curFullName.Substring(0, 1).ToUpper()
                                    </div>
                                </div>
                                <div class="fw-bold text-white fs-6 mb-1">@_curFullName</div>
                                <div class="mb-2"><span class="badge bg-black border border-info text-info font-monospace">@@@_curUsername</span></div>
                                <div class="badge @(User.IsInRole("Admin") ? "bg-danger text-light" : User.IsInRole("Manager") ? "bg-warning text-dark fw-bold" : "bg-info text-dark fw-bold") px-2 py-1">
                                    @(User.IsInRole("Admin") ? "👑 Quản trị viên (Admin)" : User.IsInRole("Manager") ? "⭐ Quản lý cơ sở (Manager)" : User.IsInRole("Waiter") ? "🎱 Phục vụ (Waiter)" : "👤 Thu ngân (Cashier)")
                                </div>
                                <div class="small text-muted mt-3 pt-2 border-top border-secondary border-opacity-25">
                                    <i class="bi bi-calendar-check text-warning me-1"></i>Ngày tạo: <strong class="text-light">@_curJoined</strong>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-section-title"><i class="bi bi-pencil text-info"></i> Thông tin liên hệ</div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" name="fullName" class="form-control form-control-bolt fw-semibold" value="@_curFullName" required />
                                </div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Tên đăng nhập</label>
                                        <input type="text" class="form-control form-control-bolt font-monospace text-info" value="@_curUsername" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Số điện thoại</label>
                                        <input type="text" name="phoneNumber" class="form-control form-control-bolt font-monospace" value="@_curPhone" placeholder="VD: 0901234567" />
                                    </div>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Email (nhận mật khẩu khi quên) <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-control form-control-bolt" value="@_curEmail" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-outline-warning btn-sm action-btn-labeled" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhau">
                            <i class="bi bi-shield-lock"></i><span>Chuyển sang Đổi mật khẩu</span>
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-bolt-neon btn-sm px-4">
                                <i class="bi bi-check-lg"></i> Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL ĐỔI MẬT KHẨU CHUYÊN NGHIỆP (CÓ NÚT QUÊN MẬT KHẨU GỬI QUA EMAIL)    -->
    <!-- ========================================================================= -->
    <div class="modal fade" id="modalDoiMatKhau" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-accent-warning text-light">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-warning fs-5"></i>
                        <div>
                            <h5 class="modal-title font-heading fw-bold mb-0">THAY ĐỔI MẬT KHẨU ĐĂNG NHẬP</h5>
                            <div class="small text-muted">Bảo vệ tài khoản <strong class="text-info font-monospace">@@@_curUsername</strong> bằng mật khẩu mạnh</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Login" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@_curPath" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input type="password" name="currentPassword" class="form-control form-control-bolt" placeholder="Nhập mật khẩu hiện tại..." required />
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="small text-muted">Không nhớ mật khẩu cũ?</span>
                                <a asp-controller="Login" asp-action="ForgotPassword" class="small text-warning fw-semibold text-decoration-none">
                                    <i class="bi bi-envelope-paper-fill me-1"></i>Quên mật khẩu? Gửi về Email →
                                </a>
                            </div>
                        </div>
                        <div class="form-section-title mt-3"><i class="bi bi-key text-info"></i> Thiết lập mật khẩu mới</div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" name="newPassword" class="form-control form-control-bolt" placeholder="Tối thiểu 6 ký tự..." minlength="6" required />
                        </div>
                        <div class="mb-0">
                            <label class="form-label small fw-bold text-uppercase text-muted">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" name="confirmPassword" class="form-control form-control-bolt" placeholder="Nhập lại mật khẩu mới..." minlength="6" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold btn-sm px-4">
                            <i class="bi bi-check-circle-fill me-1"></i>Cập nhật mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script Đồng hồ thời gian thực và cập nhật Ca trực tự động -->
    <script>
        function updatePosClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const timeStr = `${hours}:${minutes}:${seconds}`;

            const clockEl = document.getElementById('posLiveClock');
            if (clockEl) clockEl.textContent = timeStr;

            // Xác định ca trực chuẩn theo khung giờ Việt Nam (Sáng / Chiều / Tối / Đêm)
            let shift = "Ca Đêm";
            let shiftDetail = "Ca Đêm (23:00 - 06:00)";
            const h = now.getHours();
            if (h >= 6 && h < 14) {
                shift = "Ca Sáng";
                shiftDetail = "Ca Sáng (06:00 - 14:00)";
            } else if (h >= 14 && h < 18) {
                shift = "Ca Chiều";
                shiftDetail = "Ca Chiều (14:00 - 18:00)";
            } else if (h >= 18 && h < 23) {
                shift = "Ca Tối";
                shiftDetail = "Ca Tối (18:00 - 23:00)";
            }

            const shiftEl = document.getElementById('posShiftName');
            if (shiftEl) shiftEl.textContent = `(${shift})`;
            const statusCaEl = document.getElementById('statusCaTruc');
            if (statusCaEl) statusCaEl.textContent = shift;
        }

        setInterval(updatePosClock, 1000);
        updatePosClock();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
