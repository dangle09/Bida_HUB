@model QuanLyQuanBida.ViewModels.StaffViewModel
@{
    ViewData["Title"] = $"Xác nhận xóa nhân viên: {Model.FullName}";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="pos-breadcrumb d-flex align-items-center mb-0">
            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
            <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <a asp-controller="Staff" asp-action="Index">Nhân sự & Phân ca</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-danger fw-semibold">Xóa nhân viên (#@Model.Id)</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm action-btn-labeled">
            <i class="bi bi-arrow-left"></i><span>Quay lại</span>
        </a>
    </div>

    <div class="compact-form-shell">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-9">
                <div class="card form-workspace-card mode-danger">
                    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-x-fill text-danger fs-5"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-white font-heading">XÁC NHẬN XÓA TÀI KHOẢN NHÂN VIÊN</h6>
                                <div class="text-danger fw-normal" style="font-size: 0.75rem;">Thao tác này sẽ xóa vĩnh viễn tài khoản nhân viên khỏi hệ thống</div>
                            </div>
                        </div>
                        <span class="badge bg-danger text-light font-monospace">ID #@Model.Id</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-center mb-3">
                            <div class="col-auto">
                                <div class="detail-avatar-frame" style="width: 96px; height: 96px; border-color: rgba(239,68,68,0.5);">
                                @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                                {
                                    <img src="~/@Model.Avatar" alt="@Model.FullName" class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center fw-bold" style="background: rgba(239,68,68,0.2); color: #f87171; font-size: 2.8rem;">
                                        @Model.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col">
                            <div class="d-flex gap-2 mb-1">
                                <span class="badge bg-black border border-info text-info font-monospace">@@@Model.Username</span>
                                <span class="badge bg-warning text-dark fw-bold">@Model.RoleName</span>
                            </div>
                            <h4 class="fw-bold text-white font-heading mb-2">@Model.FullName</h4>
                            <div class="row g-2">
                                <div class="col-md-7">
                                    <div class="detail-info-tile py-2">
                                        <div class="detail-info-label">Email</div>
                                        <div class="detail-info-value small">@Model.Email</div>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="detail-info-tile py-2">
                                        <div class="detail-info-label">Trạng thái</div>
                                        <div class="detail-info-value small @(Model.IsActive ? "text-success" : "text-danger")">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-warning small mb-4">
                        <i class="bi bi-lightbulb-fill me-2"></i>
                        <strong>Mẹo quản trị:</strong> Nếu nhân viên tạm nghỉ việc nhưng bạn muốn giữ lại lịch sử hóa đơn và nhật ký ca trực, hãy chọn nút <strong>Khóa tài khoản</strong> ở trang danh sách thay vì xóa vĩnh viễn.
                    </div>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-1"></i> Không, quay lại</a>
                        <button type="submit" class="btn btn-danger fw-bold px-4"><i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa Vĩnh Viễn</button>
                    </form>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>
