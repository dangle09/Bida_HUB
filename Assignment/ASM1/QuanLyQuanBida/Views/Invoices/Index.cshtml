@model QuanLyQuanBida.ViewModels.InvoicesPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Hóa đơn & Thu ngân - BOLT BILLIARDS";
    Layout = "_AdminLayout";
    string searchStr = ViewBag.SearchString as string ?? "";
    string methodKey = ViewBag.MethodKey as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "";
    decimal totalRev = Model.TotalRevenue > 0 ? Model.TotalRevenue : 1;
    int cashPct = (int)Math.Round(Model.CashTotal * 100m / totalRev);
    int qrPct = (int)Math.Round(Model.TransferTotal * 100m / totalRev);
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-controller="Pos" asp-action="Index">Vận hành & Bán hàng</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Hóa đơn & Thu ngân</span>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-receipt text-success"></i>
                HÓA ĐƠN & GIAO DỊCH THU NGÂN POS
            </h2>
            <div class="text-muted small">Theo dõi lịch sử hóa đơn thanh toán, đối soát doanh thu theo ca trực và in lại biên lai cho khách hàng</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-info btn-sm action-btn-labeled">
                    <i class="bi bi-bar-chart-line"></i><span>Xem Báo cáo doanh thu</span>
                </a>
            }
            <button class="btn btn-bolt-neon btn-sm" onclick="window.print();">
                <i class="bi bi-printer"></i> In Bảng Kê Hóa Đơn
            </button>
        </div>
    </div>

    <!-- 4 KPI ĐỒNG BỘ 100% VỚI /Reports -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng doanh thu đã thu</p>
                    <div class="kpi-value text-white">@Model.TotalRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <p class="kpi-label">Hóa đơn hoàn tất</p>
                    <div class="kpi-value" style="color: #60a5fa;">@Model.PaidCount <small class="fs-6 text-muted fw-normal">Bill (@Model.PlayingCount đang chơi)</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <p class="kpi-label">Tiền mặt tại két</p>
                    <div class="kpi-value" style="color: #eab308;">@Model.CashTotal.ToString("N0") <small class="fs-6 text-warning fw-normal">(@cashPct%)</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #38bdf8; background: rgba(56, 189, 248, 0.1);">
                    <i class="bi bi-qr-code"></i>
                </div>
                <div>
                    <p class="kpi-label">Chuyển khoản VietQR</p>
                    <div class="kpi-value text-white">@Model.TransferTotal.ToString("N0") <small class="fs-6 text-muted fw-normal">(@qrPct%)</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG HÓA ĐƠN THẬT TỪ SQL SERVER -->
    <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
        <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-black text-muted border-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@searchStr" class="form-control bg-black text-light border-secondary" placeholder="Mã HĐ, tên khách, bàn, thu ngân..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="methodKey" class="form-select form-select-sm bg-black text-light border-secondary" onchange="this.form.submit();">
                        <option value="">-- Tất cả thanh toán --</option>
                        <option value="qr" selected="@(methodKey == "qr" ? "selected" : null)">Chuyển khoản VietQR</option>
                        <option value="cash" selected="@(methodKey == "cash" ? "selected" : null)">Tiền mặt</option>
                        <option value="card" selected="@(methodKey == "card" ? "selected" : null)">Quẹt thẻ POS</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="statusFilter" class="form-select form-select-sm bg-black text-light border-secondary" onchange="this.form.submit();">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Đã thanh toán" selected="@(statusFilter == "Đã thanh toán" ? "selected" : null)">Đã thanh toán</option>
                        <option value="Đang chơi" selected="@(statusFilter == "Đang chơi" ? "selected" : null)">Đang chơi</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-bolt-neon btn-sm px-3"><i class="bi bi-funnel-fill me-1"></i>Lọc</button>
                    @if (!string.IsNullOrWhiteSpace(searchStr) || !string.IsNullOrWhiteSpace(methodKey) || !string.IsNullOrWhiteSpace(statusFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
                    }
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-3" style="width: 55px;">STT</th>
                        <th>MÃ HĐ</th>
                        <th>SỐ BÀN</th>
                        <th>KHÁCH HÀNG</th>
                        <th>THỜI GIAN</th>
                        <th>THỜI LƯỢNG</th>
                        <th class="text-end">TIỀN BÀN</th>
                        <th class="text-end">TIỀN F&B</th>
                        <th class="text-end">GIẢM GIÁ</th>
                        <th class="text-end">TỔNG THU</th>
                        <th class="text-center">THANH TOÁN</th>
                        <th>THU NGÂN</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-end pe-3">CHI TIẾT</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int invStt = 1; }
                    @foreach (var inv in Model.Invoices)
                    {
                        var linesJson = JsonSerializer.Serialize(inv.Details);
                        <tr>
                            <td class="ps-3 text-secondary font-monospace fw-bold">@(invStt++)</td>
                            <td><strong class="text-white font-monospace">@inv.InvoiceCode</strong></td>
                            <td>
                                <span class="badge bg-black border @(inv.IsVipTable ? "border-info text-info" : "border-warning text-warning")">@inv.TableName</span>
                            </td>
                            <td class="fw-semibold text-light">@inv.CustomerName</td>
                            <td class="small text-muted">@inv.StartTime.ToString("dd/MM HH:mm")</td>
                            <td>@inv.DurationText</td>
                            <td class="text-end">@inv.TableAmount.ToString("N0") đ</td>
                            <td class="text-end">@inv.ServiceAmount.ToString("N0") đ</td>
                            <td class="text-end @(inv.DiscountAmount > 0 ? "text-success" : "text-muted")">
                                @(inv.DiscountAmount > 0 ? $"-{inv.DiscountAmount:N0} đ" : "0 đ")
                            </td>
                            <td class="text-end fw-bold" style="color: var(--primary-neon);">@inv.TotalPayment.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (inv.PaymentMethodKey == "qr")
                                {
                                    <span class="badge bg-dark text-info border border-info">VietQR</span>
                                }
                                else if (inv.PaymentMethodKey == "cash")
                                {
                                    <span class="badge bg-dark text-warning border border-warning">Tiền mặt</span>
                                }
                                else if (inv.PaymentMethodKey == "card")
                                {
                                    <span class="badge bg-dark text-light border border-secondary">Thẻ POS</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light">Chờ TT</span>
                                }
                            </td>
                            <td class="small">@inv.StaffName</td>
                            <td class="text-center">
                                <span class="badge @(inv.Status == "Đã thanh toán" ? "bg-success text-dark fw-bold" : "bg-warning text-dark fw-bold")">@inv.Status</span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="action-btn-group">
                                    <button type="button" class="btn btn-outline-info action-btn"
                                            title="Xem & In hóa đơn K80"
                                            data-code="@inv.InvoiceCode"
                                            data-table="@inv.TableName"
                                            data-customer="@inv.CustomerName"
                                            data-staff="@inv.StaffName"
                                            data-time="@inv.StartTime.ToString("dd/MM/yyyy HH:mm")"
                                            data-tablefee="@inv.TableAmount.ToString("N0") đ"
                                            data-fnbfee="@inv.ServiceAmount.ToString("N0") đ"
                                            data-discount="@inv.DiscountAmount.ToString("N0") đ"
                                            data-total="@inv.TotalPayment.ToString("N0") đ"
                                            data-method="@inv.PaymentMethodName"
                                            data-status="@inv.Status"
                                            data-lines='@Html.Raw(linesJson)'
                                            onclick="showBillModal(this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL CHI TIẾT HÓA ĐƠN K80 (HIỂN THỊ ĐỦ MÓN ORDER TỪ InvoiceDetails) -->
<div class="modal fade" id="modalBillDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold"><i class="bi bi-receipt text-warning me-2"></i>CHI TIẾT HÓA ĐƠN POS K80</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="pos-receipt-paper text-dark p-3 bg-white">
                    <div class="text-center pb-2 border-bottom border-dark">
                        <div class="fw-bold fs-5">BOLT BILLIARDS</div>
                        <div style="font-size: 0.75rem;">128 Nguyễn Ái Quốc, Biên Hòa, Đồng Nai</div>
                        <div class="fw-bold mt-2">HÓA ĐƠN THANH TOÁN POS</div>
                        <div style="font-size: 0.75rem;">Mã HĐ: <strong id="rCode"></strong> • <span id="rTime"></span></div>
                    </div>
                    <div class="small py-2 border-bottom border-dark">
                        <div class="d-flex justify-content-between"><span>Bàn:</span><strong id="rTable"></strong></div>
                        <div class="d-flex justify-content-between"><span>Khách hàng:</span><strong id="rCustomer"></strong></div>
                        <div class="d-flex justify-content-between"><span>Thu ngân:</span><strong id="rStaff"></strong></div>
                        <div class="d-flex justify-content-between"><span>Trạng thái:</span><strong id="rStatus"></strong></div>
                    </div>
                    <div class="py-2 border-bottom border-dark small">
                        <div class="fw-bold mb-1">Chi tiết dịch vụ F&B:</div>
                        <div id="rLines"></div>
                    </div>
                    <div class="py-2 border-bottom border-dark small">
                        <div class="d-flex justify-content-between"><span>Tiền giờ bàn:</span><strong id="rTableFee"></strong></div>
                        <div class="d-flex justify-content-between"><span>Tiền dịch vụ F&B:</span><strong id="rFnbFee"></strong></div>
                        <div class="d-flex justify-content-between text-danger"><span>Giảm giá:</span><strong id="rDiscount"></strong></div>
                    </div>
                    <div class="d-flex justify-content-between fs-6 fw-bold py-2">
                        <span>TỔNG THANH TOÁN:</span>
                        <span id="rTotal"></span>
                    </div>
                    <div class="text-center small text-muted pt-1 border-top border-dark">
                        Phương thức: <strong id="rMethod"></strong> — Cảm ơn quý khách!
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm" onclick="window.print();"><i class="bi bi-printer"></i> In Hóa Đơn</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showBillModal(btn) {
            document.getElementById('rCode').textContent = btn.dataset.code;
            document.getElementById('rTable').textContent = btn.dataset.table;
            document.getElementById('rCustomer').textContent = btn.dataset.customer;
            document.getElementById('rStaff').textContent = btn.dataset.staff;
            document.getElementById('rTime').textContent = btn.dataset.time;
            document.getElementById('rTableFee').textContent = btn.dataset.tablefee;
            document.getElementById('rFnbFee').textContent = btn.dataset.fnbfee;
            document.getElementById('rDiscount').textContent = '- ' + btn.dataset.discount;
            document.getElementById('rTotal').textContent = btn.dataset.total;
            document.getElementById('rMethod').textContent = btn.dataset.method;
            document.getElementById('rStatus').textContent = btn.dataset.status;

            const container = document.getElementById('rLines');
            container.innerHTML = '';
            try {
                const lines = JSON.parse(btn.dataset.lines || '[]');
                if (lines.length === 0) {
                    container.innerHTML = '<div class="text-muted fst-italic">Không gọi thêm dịch vụ F&B</div>';
                } else {
                    lines.forEach(l => {
                        const row = document.createElement('div');
                        row.className = 'd-flex justify-content-between';
                        row.innerHTML = `<span>${l.ItemName} (${Number(l.UnitPrice).toLocaleString('vi-VN')} đ × ${l.Quantity})</span><span>${Number(l.TotalAmount).toLocaleString('vi-VN')} đ</span>`;
                        container.appendChild(row);
                    });
                }
            } catch {
                container.innerHTML = '';
            }
            new bootstrap.Modal(document.getElementById('modalBillDetail')).show();
        }
    </script>
}
