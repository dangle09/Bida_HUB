@model QuanLyQuanBida.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - BOLT BILLIARDS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bolt-neon: #a6ff00;
            --bolt-dark: #07090e;
            --bolt-card: rgba(14, 19, 29, 0.96);
            --bolt-border: rgba(255, 255, 255, 0.12);
        }
        body {
            margin: 0;
            padding: 20px;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #07090e 0%, #0c111a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #f8fafc;
        }
        .forgot-card {
            background: var(--bolt-card);
            border: 1px solid var(--bolt-border);
            border-radius: 2px !important;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
            width: 100%;
            max-width: 480px;
            padding: 2.3rem 2rem;
            position: relative;
        }
        .forgot-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--bolt-neon), transparent);
        }
        .btn-neon {
            background-color: var(--bolt-neon);
            color: #07090e;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            border: none;
            border-radius: 2px !important;
            height: 46px;
        }
        .btn-neon:hover { background-color: #b8ff33; color: #000; }
        .form-control-custom {
            background-color: #07090e;
            border: 1px solid rgba(255,255,255,0.16);
            color: #fff;
            border-radius: 2px !important;
            height: 46px;
        }
        .form-control-custom:focus {
            background-color: #07090e;
            border-color: var(--bolt-neon);
            color: #fff;
            box-shadow: 0 0 0 0.15rem rgba(166, 255, 0, 0.2);
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <div class="text-center mb-4">
            <img src="~/images/bolt-billiards-logo.png" alt="BOLT BILLIARDS" style="height: 50px;" class="mb-2" />
            <h4 class="fw-bold mb-1" style="font-family: 'Montserrat', sans-serif;">
                <span style="color: var(--bolt-neon);">CẤP LẠI</span> MẬT KHẨU
            </h4>
            <div class="small" style="color: #a8b7cc;">
                Nhập Email nhân viên để hệ thống đặt lại mật khẩu ngẫu nhiên và gửi qua Email
            </div>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success small mb-3" style="border-radius: 2px !important; background: rgba(25, 135, 84, 0.18); border-color: #198754; color: #a7f3d0;">
                <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.SuccessMessage
            </div>
        }

        @if (ViewBag.DemoPassword != null)
        {
            <div class="p-3 mb-3 border border-warning" style="background: rgba(234, 179, 8, 0.08); border-radius: 2px;">
                <div class="small text-warning mb-2">
                    <i class="bi bi-envelope-exclamation me-1"></i> @(ViewBag.DemoNote ?? "Mật khẩu mới đã cập nhật trong SQL Server:")
                </div>
                <div class="d-flex justify-content-between align-items-center bg-black p-2 border border-secondary" style="border-radius: 2px;">
                    <span class="small text-light">Tài khoản: <strong class="text-info">@ViewBag.DemoUsername</strong></span>
                    <span class="font-monospace fw-bold fs-6" style="color: var(--bolt-neon);">@ViewBag.DemoPassword</span>
                </div>
            </div>
        }

        <form asp-controller="Login" asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="border-radius: 2px; @(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-uppercase" style="color: #cbd5e1;">Email tài khoản nhân viên (*)</label>
                <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="VD: manager@boltbilliards.vn hoặc cashier@boltbilliards.vn" autofocus required />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-neon w-100 mb-3">
                <i class="bi bi-send-fill me-1"></i> CẤP LẠI MẬT KHẨU QUA EMAIL
            </button>

            <div class="d-flex justify-content-between small pt-2 border-top border-secondary border-opacity-25">
                <a asp-controller="Login" asp-action="Login" class="text-decoration-none text-info">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                </a>
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
                    Trang chủ khách
                </a>
            </div>
        </form>
    </div>
</body>
</html>
