                                <div class="form-text text-muted small" style="font-size: 0.72rem;">Ảnh dùng cho thẻ thi đấu và hiển thị trên màn hình Livestream.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Họ và tên cơ thủ (*):</label>
                        <input type="text" class="form-control bg-black text-light border-secondary fw-bold" placeholder="Ví dụ: Hoàng Minh Đức" style="border-radius: 2px !important;" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Số điện thoại (*):</label>
                            <input type="tel" class="form-control bg-black text-light border-secondary font-monospace" placeholder="09xxxxxxxx" style="border-radius: 2px !important;" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Hạng hạt giống:</label>
                            <select class="form-select bg-black text-light border-secondary" style="border-radius: 2px !important;">
                                <option value="seed">Hạt giống bảng đấu</option>
                                <option value="normal" selected>Cơ thủ tự do</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Cơ bida đăng ký thi đấu:</label>
                        <input type="text" class="form-control bg-black text-light border-secondary" placeholder="Ví dụ: Predator SP2, Fury One, Cuetec..." style="border-radius: 2px !important;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Lệ phí thi đấu:</label>
                        <input type="text" class="form-control bg-black text-success border-secondary fw-bold" value="200.000 VNĐ (Đã bao gồm nước uống & nỉ thi đấu)" readonly style="border-radius: 2px !important;" />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px !important;">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="alert('Đã thêm cơ thủ kèm ảnh đại diện vào danh sách thi đấu giải Bolt Open!');" style="border-radius: 2px !important;">
                    <i class="bi bi-check-lg"></i> Xác nhận ghi danh
                </button>
            </div>
        </div>
    </div>
</div>

