@* ===================================================================================
   WEB QUẢN LÝ (BIDA POS & ADMIN DASHBOARD) - HỘI VIÊN & GIẢI ĐẤU: GIẢI ĐẤU GIAO LƯU
   - Tên file: Views/Tournaments/Index.cshtml
   - Vai trò: Quản lý giải đấu bida, bảng đấu vòng loại (16 cặp đấu / 32 cơ thủ),
     sơ đồ nhánh đấu Knock-out (Tứ kết ➔ Bán kết ➔ Chung kết), cập nhật tỷ số Live
   - Layout: Views/Shared/_AdminLayout.cshtml
   - CSS: wwwroot/css/admin-pos.css (Chuẩn bo góc 2px radius toàn trang)
   =================================================================================== *@
@{
    ViewData["Title"] = "Giải đấu giao lưu - BOLT BILLIARDS";
    Layout = "_AdminLayout";

    // 16 Trận đấu vòng loại quy tụ đủ 32 cơ thủ tham gia thi đấu tại 4 bàn Tầng 1
    var qualMatches = new[]
    {
        new { MatchNo = 1, Table = "BÀN 01", Time = "09:00", Player1 = "Đào Ngọc Giang (Hạt giống 1)", Score1 = 9, Player2 = "Ngô Trí Dũng", Score2 = 3, Winner = "Đào Ngọc Giang", Status = "Đã kết thúc" },
        new { MatchNo = 2, Table = "BÀN 02", Time = "09:00", Player1 = "Nguyễn Văn Nam (Chú Năm)", Score1 = 9, Player2 = "Phan Văn Hậu", Score2 = 5, Winner = "Nguyễn Văn Nam", Status = "Đã kết thúc" },
        new { MatchNo = 3, Table = "BÀN 03", Time = "09:00", Player1 = "Lê Nhật Đăng (Hạt giống 4)", Score1 = 9, Player2 = "Trần Quang Huy", Score2 = 4, Winner = "Lê Nhật Đăng", Status = "Đã kết thúc" },
        new { MatchNo = 4, Table = "BÀN 04", Time = "09:00", Player1 = "Trần Hoàng Tuấn", Score1 = 9, Player2 = "Lê Thanh Sơn", Score2 = 6, Winner = "Trần Hoàng Tuấn", Status = "Đã kết thúc" },
        new { MatchNo = 5, Table = "BÀN 01", Time = "10:30", Player1 = "Phạm Trần Bạch Long (Hạt giống 3)", Score1 = 9, Player2 = "Nguyễn Thành Nam", Score2 = 2, Winner = "Phạm Trần Bạch Long", Status = "Đã kết thúc" },
        new { MatchNo = 6, Table = "BÀN 02", Time = "10:30", Player1 = "Vũ Đình Khang", Score1 = 9, Player2 = "Lâm Gia Huy", Score2 = 7, Winner = "Vũ Đình Khang", Status = "Đã kết thúc" },
        new { MatchNo = 7, Table = "BÀN 03", Time = "10:30", Player1 = "Trương Đăng Khoa (Hạt giống 2)", Score1 = 9, Player2 = "Đặng Hoàng Long", Score2 = 3, Winner = "Trương Đăng Khoa", Status = "Đã kết thúc" },
        new { MatchNo = 8, Table = "BÀN 04", Time = "10:30", Player1 = "Hoàng Minh Đức", Score1 = 9, Player2 = "Trần Văn Nam", Score2 = 5, Winner = "Hoàng Minh Đức", Status = "Đã kết thúc" },
        new { MatchNo = 9, Table = "BÀN 01", Time = "13:00", Player1 = "Master Dũng", Score1 = 8, Player2 = "Hoàng Minh Tuấn", Score2 = 9, Winner = "Hoàng Minh Tuấn", Status = "Đã kết thúc" },
        new { MatchNo = 10, Table = "BÀN 02", Time = "13:00", Player1 = "Bùi Đức Thắng", Score1 = 9, Player2 = "Võ Văn Hoàng", Score2 = 7, Winner = "Bùi Đức Thắng", Status = "Đã kết thúc" },
        new { MatchNo = 11, Table = "BÀN 03", Time = "13:00", Player1 = "Nguyễn Hữu Thắng", Score1 = 9, Player2 = "Đỗ Hải Đăng", Score2 = 6, Winner = "Nguyễn Hữu Thắng", Status = "Đã kết thúc" },
        new { MatchNo = 12, Table = "BÀN 04", Time = "13:00", Player1 = "Nguyễn Đình Trọng", Score1 = 9, Player2 = "Trịnh Công Minh", Score2 = 4, Winner = "Nguyễn Đình Trọng", Status = "Đã kết thúc" },
        new { MatchNo = 13, Table = "BÀN 01", Time = "14:30", Player1 = "Trần Quốc Bảo", Score1 = 9, Player2 = "Phan Trí Dũng", Score2 = 5, Winner = "Trần Quốc Bảo", Status = "Đã kết thúc" },
        new { MatchNo = 14, Table = "BÀN 02", Time = "14:30", Player1 = "Võ Thành Long", Score1 = 9, Player2 = "Huỳnh Quốc Bảo", Score2 = 8, Winner = "Võ Thành Long", Status = "Đã kết thúc" },
        new { MatchNo = 15, Table = "BÀN 03", Time = "14:30", Player1 = "Lương Xuân Trường", Score1 = 9, Player2 = "Đặng Văn Lâm", Score2 = 6, Winner = "Lương Xuân Trường", Status = "Đã kết thúc" },
        new { MatchNo = 16, Table = "BÀN 04", Time = "14:30", Player1 = "Bùi Tiến Dũng", Score1 = 9, Player2 = "Nguyễn Tiến Linh", Score2 = 7, Winner = "Bùi Tiến Dũng", Status = "Đã kết thúc" }
    };
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-controller="Customers" asp-action="Index">Hội viên & Giải đấu</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Giải đấu giao lưu</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-trophy-fill text-danger"></i>
                GIẢI ĐẤU BIDA GIAO LƯU & NHÁNH ĐẤU
            </h2>
            <div class="text-muted small">Tổ chức giải thi đấu định kỳ, vòng loại 32 cơ thủ, bốc thăm nhánh đấu và chung kết tranh cúp</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalTaoMuaGiai" style="border-radius: 2px !important;">
                <i class="bi bi-calendar-plus text-info"></i> Tạo Mùa Giải Mới
            </button>
            <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalDangKyCoThu" style="border-radius: 2px !important;">
                <i class="bi bi-plus-circle-fill"></i> Đăng Ký Cơ Thủ Mới
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ KPI GIẢI ĐẤU -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #ef4444; background: rgba(239, 68, 68, 0.1);">
                    <i class="bi bi-fire"></i>
                </div>
                <div>
                    <p class="kpi-label">Giải đấu đang diễn ra</p>
                    <div class="kpi-value text-danger">1 <small class="fs-6 text-white fw-normal">Chung Kết</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-trophy"></i>
                </div>
                <div>
                    <p class="kpi-label">Giải nhất mùa giải</p>
                    <div class="kpi-value text-white">15.000K <small class="fs-6 text-muted fw-normal">+ Cúp Vàng</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
                <div>
                    <p class="kpi-label">Cơ thủ tham gia</p>
                    <div class="kpi-value" style="color: #60a5fa;">32/32 <small class="fs-6 text-muted fw-normal">Đầy bảng</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-calendar2-event-fill"></i>
                </div>
                <div>
                    <p class="kpi-label">Chung kết dự kiến</p>
                    <div class="kpi-value text-warning">20:00 <small class="fs-6 text-muted fw-normal">Livestream</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER GIẢI ĐẤU ĐANG DIỄN RA -->
    <div class="card bg-dark border-secondary border-opacity-50 mb-4" style="border-radius: 2px !important;">
        <div class="card-body p-4 position-relative overflow-hidden">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge text-dark fw-bold px-2 py-1 mb-2" style="background-color: var(--primary-neon); border-radius: 2px;">
                        🔥 GIẢI ĐẤU ĐANG DIỄN RA CHÍNH THỨC
                    </span>
                    <h3 class="h4 fw-bold text-white font-heading mb-2">BOLT OPEN BILLIARDS CHAMPIONSHIP 2026</h3>
                    <p class="text-muted small mb-3">
                        Quy tụ <strong>32 tay cơ xuất sắc</strong> khu vực Đồng Nai & TP.HCM tranh tài thể thức <strong>Pool 9-Ball</strong> (Chạm 9 ván thắng). Dàn bàn thi đấu Aileex Crown 9020 vải nỉ Simonis Pro (Bàn 01 - Bàn 04 Tầng 1).
                    </p>
                    <div class="d-flex flex-wrap gap-4 text-secondary small">
                        <div><i class="bi bi-geo-alt text-warning me-1"></i> Bàn thi đấu: <strong>Bàn 01 - 04 (Tầng 1)</strong></div>
                        <div><i class="bi bi-cash text-success me-1"></i> Lệ phí: <strong>200.000 đ / cơ thủ</strong></div>
                        <div><i class="bi bi-shield-check text-info me-1"></i> Trọng tài chính: <strong>Lê Nhật Đăng</strong></div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <button class="btn btn-bolt-neon btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#modalCapNhatTySo" style="border-radius: 2px !important;">
                        <i class="bi bi-broadcast"></i> Cập Nhật Tỷ Số Live
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS ĐIỀU HƯỚNG: VÒNG LOẠI (16 CẶP ĐẤU) & SƠ ĐỒ KNOCK-OUT -->
    <ul class="nav nav-pills nav-pills-bolt mb-3" id="tournamentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-vongloai-btn" data-bs-toggle="pill" data-bs-target="#tab-vongloai" type="button" role="tab" aria-controls="tab-vongloai" aria-selected="true">
                <i class="bi bi-grid-3x2 me-1"></i> Bảng Đấu Vòng Loại (16 Cặp Đấu / 32 Cơ Thủ)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-nhanhdau-btn" data-bs-toggle="pill" data-bs-target="#tab-nhanhdau" type="button" role="tab" aria-controls="tab-nhanhdau" aria-selected="false">
                <i class="bi bi-diagram-3 me-1"></i> Sơ Đồ Nhánh Đấu Knock-Out (Tứ Kết ➔ Chung Kết)
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG TABS -->
    <div class="tab-content" id="tournamentTabContent">
        <!-- ========================================================================= -->
        <!-- TAB 1: BẢNG ĐẤU VÒNG LOẠI (16 CẶP ĐẤU ĐẦY ĐỦ 32 CƠ THỦ)                  -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade show active" id="tab-vongloai" role="tabpanel" aria-labelledby="tab-vongloai-btn">
            <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
                <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6 d-flex align-items-center gap-2">
                            <i class="bi bi-list-check text-warning"></i> KẾT QUẢ 16 TRẬN ĐẤU VÒNG LOẠI 1/32
                        </h5>
                        <div class="text-muted small" style="font-size: 0.75rem;">Thể thức chạm 9 (Race to 9) • 16 cơ thủ thắng trận giành quyền đi tiếp</div>
                    </div>
                    <div class="badge bg-black border border-success text-success p-2" style="border-radius: 2px;">
                        <i class="bi bi-check2-all me-1"></i> Vòng loại đã hoàn tất 16/16 trận
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="font-size: 0.86rem;">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-3">TRẬN</th>
                                <th>BÀN ĐẤU</th>
                                <th>GIỜ THI ĐẤU</th>
                                <th>CƠ THỦ 1</th>
                                <th class="text-center">TỶ SỐ</th>
                                <th>CƠ THỦ 2</th>
                                <th class="text-center">CƠ THỦ ĐI TIẾP</th>
                                <th class="text-center pe-3">TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in qualMatches)
                            {
                                <tr>
                                    <td class="ps-3"><strong class="text-secondary font-monospace">#@m.MatchNo.ToString("00")</strong></td>
                                    <td><span class="badge bg-black border border-warning text-warning" style="border-radius: 2px;">@m.Table</span></td>
                                    <td class="text-muted small font-monospace">@m.Time</td>
                                    <td>
                                        <span class="fw-bold @(m.Score1 > m.Score2 ? "text-white" : "text-muted")">@m.Player1</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge px-2 py-1 fw-bold fs-6 @(m.Score1 > m.Score2 ? "text-dark" : "bg-dark text-muted")" style="@(m.Score1 > m.Score2 ? "background-color: var(--primary-neon);" : "")">@m.Score1</span>
                                        <span class="mx-1 text-secondary">-</span>
                                        <span class="badge px-2 py-1 fw-bold fs-6 @(m.Score2 > m.Score1 ? "text-dark" : "bg-dark text-muted")" style="@(m.Score2 > m.Score1 ? "background-color: var(--primary-neon);" : "")">@m.Score2</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(m.Score2 > m.Score1 ? "text-white" : "text-muted")">@m.Player2</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-black border border-success text-success fw-bold" style="border-radius: 2px;">
                                            <i class="bi bi-arrow-right-circle me-1"></i> @m.Winner
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <span class="badge bg-dark text-secondary border border-secondary" style="border-radius: 2px; font-size: 0.72rem;">@m.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- TAB 2: SƠ ĐỒ NHÁNH ĐẤU BRACKET (TỨ KẾT ➔ BÁN KẾT ➔ CHUNG KẾT)             -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-nhanhdau" role="tabpanel" aria-labelledby="tab-nhanhdau-btn">
            <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
                <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3">
                    <h5 class="card-title font-heading fw-bold text-white mb-0 fs-6 d-flex align-items-center gap-2">
                        <i class="bi bi-diagram-3-fill text-info"></i> SƠ ĐỒ NHÁNH ĐẤU VÒNG KNOCK-OUT (CHẠM 9 THẮNG)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- VÒNG TỨ KẾT -->
                        <div class="col-12 col-md-4">
                            <div class="text-uppercase small fw-bold text-secondary mb-2 text-center pb-1 border-bottom border-secondary border-opacity-25">
                                VÒNG TỨ KẾT (4 TRẬN)
                            </div>
                            <!-- Trận 1 -->
                            <div class="bracket-node">
                                <div class="bracket-player winner">
                                    <span>1. Đào Ngọc Giang</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>8. Nguyễn Văn Nam</span>
                                    <span class="bracket-score">5</span>
                                </div>
                            </div>
                            <!-- Trận 2 -->
                            <div class="bracket-node">
                                <div class="bracket-player winner">
                                    <span>4. Lê Nhật Đăng</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>5. Trần Hoàng Tuấn</span>
                                    <span class="bracket-score">7</span>
                                </div>
                            </div>
                            <!-- Trận 3 -->
                            <div class="bracket-node">
                                <div class="bracket-player winner">
                                    <span>3. Phạm Trần Bạch Long</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>6. Vũ Đình Khang</span>
                                    <span class="bracket-score">6</span>
                                </div>
                            </div>
                            <!-- Trận 4 -->
                            <div class="bracket-node">
                                <div class="bracket-player winner">
                                    <span>2. Trương Đăng Khoa</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>7. Hoàng Minh Đức</span>
                                    <span class="bracket-score">8</span>
                                </div>
                            </div>
                        </div>

                        <!-- VÒNG BÁN KẾT -->
                        <div class="col-12 col-md-4 d-flex flex-column justify-content-around">
                            <div class="text-uppercase small fw-bold text-info mb-2 text-center pb-1 border-bottom border-secondary border-opacity-25">
                                VÒNG BÁN KẾT (2 TRẬN)
                            </div>
                            <!-- Bán kết 1 -->
                            <div class="bracket-node border-info" style="margin: 2rem 0;">
                                <div class="bracket-player winner">
                                    <span class="text-white fw-bold">Đào Ngọc Giang</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>Lê Nhật Đăng</span>
                                    <span class="bracket-score">7</span>
                                </div>
                            </div>
                            <!-- Bán kết 2 -->
                            <div class="bracket-node border-info" style="margin: 2rem 0;">
                                <div class="bracket-player winner">
                                    <span class="text-white fw-bold">Trương Đăng Khoa</span>
                                    <span class="bracket-score text-dark" style="background-color: var(--primary-neon);">9</span>
                                </div>
                                <div class="bracket-player text-muted">
                                    <span>Phạm Trần Bạch Long</span>
                                    <span class="bracket-score">8</span>
                                </div>
                            </div>
                        </div>

                        <!-- TRẬN CHUNG KẾT TRANH CÚP -->
                        <div class="col-12 col-md-4 d-flex flex-column justify-content-center">
                            <div class="text-uppercase small fw-bold text-warning mb-2 text-center pb-1 border-bottom border-secondary border-opacity-25">
                                🏆 TRẬN CHUNG KẾT VÔ ĐỊCH
                            </div>
                            <div class="bracket-node border-warning p-3 shadow" style="background: linear-gradient(180deg, rgba(234, 179, 8, 0.1) 0%, #0d121c 100%); border-radius: 2px !important;">
                                <div class="text-center text-warning fw-bold small mb-2">BOLT ARENA • BÀN 01 (LIVESTREAM)</div>
                                <div class="bracket-player py-2 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-white fs-6">Đào Ngọc Giang (Hạt giống 1)</span>
                                    <span class="badge bg-warning text-dark fw-bold fs-6">VS</span>
                                </div>
                                <div class="bracket-player py-2">
                                    <span class="fw-bold text-white fs-6">Trương Đăng Khoa (Hạt giống 2)</span>
                                    <span class="badge bg-dark border border-secondary text-muted">Chưa đấu</span>
                                </div>
                                <div class="text-center mt-3 pt-2 border-top border-secondary border-opacity-25">
                                    <span class="text-muted small">Thời gian: <strong>Hôm nay 20:00</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: ĐĂNG KÝ CƠ THỦ MỚI (CÓ CHỌN VÀ PREVIEW ẢNH CHÂN DUNG)            -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalDangKyCoThu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light" style="border-radius: 2px !important;">
            <div class="modal-header border-secondary border-opacity-25">
