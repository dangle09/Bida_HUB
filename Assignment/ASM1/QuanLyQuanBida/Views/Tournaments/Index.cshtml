            </div>
            <div class="modal-body">
                <form>
                    <!-- UPLOAD ẢNH CHÂN DUNG CƠ THỦ -->
                    <div class="mb-3 text-center">
                        <label class="form-label small text-muted d-block text-start">Ảnh đại diện cơ thủ thi đấu (*):</label>
                        <div class="d-flex align-items-center gap-3">
                            <div style="width: 64px; height: 64px; border-radius: 2px; background: #1e293b; border: 1px dashed #64748b; display: flex; align-items: center; justify-content: center; overflow: hidden;">
