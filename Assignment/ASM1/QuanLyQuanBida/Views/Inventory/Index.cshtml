                                <td class="text-center"><span class="badge bg-success text-dark" style="border-radius: 2px;">ĐÃ NHẬP KHO</span></td>
                                <td class="text-center pe-3">
                                    <button class="btn btn-sm btn-outline-light p-1 px-2" style="border-radius: 2px !important;" onclick="alert('Phiếu nhập PN-202611-012: Đã thanh toán chuyển khoản, đủ chứng từ VAT.');"><i class="bi bi-eye"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="ps-3"><strong class="text-white font-monospace">PN-202611-011</strong></td>
                                <td><span class="text-warning fw-bold">Nhà phân phối Phụ kiện Bida Sài Gòn (Fury VN)</span></td>
                                <td>10/11/2026 14:15</td>
                                <td>Lê Nhật Đăng (Manager)</td>
                                <td>Nhập 5 cây cơ Fury One, 20 hộp lơ Master USA, 30 đôi găng tay Kamui</td>
                                <td class="text-end fw-bold" style="color: var(--primary-neon);">11.200.000 đ</td>
