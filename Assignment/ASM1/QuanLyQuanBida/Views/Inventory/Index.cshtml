    <ul class="nav nav-pills nav-pills-bolt mb-3" id="inventoryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-tonkho-btn" data-bs-toggle="pill" data-bs-target="#tab-tonkho" type="button" role="tab" aria-controls="tab-tonkho" aria-selected="true">
                <i class="bi bi-archive me-1"></i> Danh Mục Tồn Kho Thực Tế (24 Mặt hàng)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-phieunhap-btn" data-bs-toggle="pill" data-bs-target="#tab-phieunhap" type="button" role="tab" aria-controls="tab-phieunhap" aria-selected="false">
                <i class="bi bi-file-earmark-text me-1"></i> Lịch Sử Phiếu Nhập Hàng (4 Phiếu gần nhất)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-ncc-btn" data-bs-toggle="pill" data-bs-target="#tab-ncc" type="button" role="tab" aria-controls="tab-ncc" aria-selected="false">
                <i class="bi bi-building me-1"></i> Danh Bạ Nhà Cung Cấp (4 Đối tác)
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG TABS -->
    <div class="tab-content" id="inventoryTabsContent">
        <!-- ========================================================================= -->
        <!-- TAB 1: DANH MỤC ĐẦY ĐỦ 24 MẶT HÀNG TỒN KHO THỰC TẾ                        -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade show active" id="tab-tonkho" role="tabpanel">
            <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
                <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <input type="text" id="inventorySearchInput" class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Tìm tên hàng, mã SKU..." style="width: 250px; border-radius: 2px !important;" />
                        <select id="inventoryFilterStatus" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 200px; border-radius: 2px !important;">
                            <option value="">Tất cả tình trạng (24)</option>
                            <option value="danger">Sắp hết hàng (3)</option>
                            <option value="warning">Cần bổ sung / Vật tư (3)</option>
                            <option value="success">Đủ hàng (18)</option>
                        </select>
                    </div>
                    <span class="text-muted small">Cập nhật kiểm kê lần cuối: <strong>Hôm nay 16:30</strong> (24/24 mục)</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" id="inventoryTable" style="font-size: 0.86rem;">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-3">MÃ SKU</th>
                                <th>ẢNH</th>
                                <th>TÊN SẢN PHẨM TRONG KHO</th>
                                <th>ĐVT</th>
                                <th class="text-center">SỐ LƯỢNG TỒN</th>
                                <th class="text-center">TỒN AN TOÀN</th>
                                <th class="text-end">GIÁ NHẬP BQ</th>
                                <th class="text-end">GIÁ BÁN</th>
                                <th class="text-center">TÌNH TRẠNG</th>
                                <th class="text-center pe-3">NHẬP THÊM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in inventoryItems)
                            {
                                <tr data-status="@item.Status">
                                    <td class="ps-3"><strong class="font-monospace @(item.Status == "danger" ? "text-danger" : item.Status == "warning" ? "text-warning" : "text-light")">@item.Sku</strong></td>
                                    <td>
                                        <div class="thumb-category-wrap" style="width: 40px; height: 40px; border-radius: 2px; overflow: hidden; background: #000; border: 1px solid #334155;">
                                            <img src="@item.Img" class="thumb-category-img w-100 h-100 object-fit-cover" alt="@item.Name" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white">@item.Name</div>
                                        <div class="small @(item.Status == "danger" ? "text-danger" : "text-muted")" style="font-size: 0.74rem;">
                                            @if (item.Status == "danger")
                                            {
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            }
                                            @item.Note
                                        </div>
                                    </td>
                                    <td>@item.Unit</td>
                                    <td class="text-center fw-bold fs-6 @(item.Status == "danger" ? "text-danger" : item.Status == "warning" ? "text-warning" : "text-white")">
                                        @item.Stock
                                    </td>
                                    <td class="text-center text-secondary">@item.Safe</td>
                                    <td class="text-end">@item.Cost.ToString("N0") đ</td>
                                    <td class="text-end fw-bold" style="color: var(--primary-neon);">
                                        @(item.Price > 0 ? $"{item.Price:N0} đ" : "Vật tư nội bộ")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.Status == "danger" ? "bg-danger text-light" : item.Status == "warning" ? "bg-warning text-dark" : "bg-dark border border-secondary text-success")" style="border-radius: 2px; font-size: 0.72rem;">
                                            @item.StatusText
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm @(item.Status == "danger" ? "btn-bolt-neon" : "btn-outline-info") p-1 px-2" style="border-radius: 2px !important;" data-bs-toggle="modal" data-bs-target="#modalNhapHang" title="Nhập hàng bổ sung">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- TAB 2: LỊCH SỬ PHIẾU NHẬP HÀNG                                            -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-phieunhap" role="tabpanel">
