@section Scripts {
    <script>
        let nccCount = 5;
        function calcDiff(input, sysQty, targetId) {
            const actual = parseInt(input.value || '0');
            const diff = actual - sysQty;
            const el = document.getElementById(targetId);
            el.innerText = diff > 0 ? '+' + diff : diff;
            el.className = 'text-center fw-bold ' + (diff === 0 ? 'text-success' : (diff < 0 ? 'text-danger' : 'text-info'));
        }
        function addNccRow() {
            const name = document.getElementById('newNccName').value.trim();
            const phone = document.getElementById('newNccPhone').value.trim();
            const group = document.getElementById('newNccGroup').value.trim() || 'Hàng hóa F&B';
            const addr = document.getElementById('newNccAddr').value.trim() || 'Đồng Nai';
            if (!name || !phone) { alert('Vui lòng nhập Tên và SĐT Nhà cung cấp!'); return; }
            const code = 'NCC-0' + (nccCount++);
            const tr = `<tr>
                <td class="ps-3 font-monospace text-info fw-bold">${code}</td>
                <td class="fw-bold text-white">${name}</td>
                <td class="font-monospace">${phone}</td>
                <td class="text-muted">${addr}</td>
                <td><span class="badge bg-info bg-opacity-25 text-info" style="border-radius: 2px;">${group}</span></td>
                <td class="text-center pe-3"><button class="btn btn-sm btn-outline-warning p-1 px-2" style="border-radius: 2px !important;" onclick="alert('Chỉnh sửa ${code}');"><i class="bi bi-pencil"></i></button></td>
            </tr>`;
            document.getElementById('nccTableBody').insertAdjacentHTML('beforeend', tr);
            bootstrap.Modal.getInstance(document.getElementById('modalThemNCC')).hide();
            document.getElementById('newNccName').value = '';
            document.getElementById('newNccPhone').value = '';
        }

        function previewInvoiceFile(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('previewInvoiceImg');
                    var icon = document.getElementById('iconDefaultInvoice');
                    if (img) {
                        img.src = e.target.result;
                        img.style.display = 'block';
                    }
                    if (icon) {
                        icon.style.display = 'none';
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('inventorySearchInput');
            var statusFilter = document.getElementById('inventoryFilterStatus');
            var tableRows = document.querySelectorAll('#inventoryTable tbody tr');

            function filterInventory() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedStatus = (statusFilter.value || '').trim();

                tableRows.forEach(function (row) {
                    var status = row.getAttribute('data-status') || '';
                    var text = row.textContent.toLowerCase();

                    var matchesQuery = !query || text.includes(query);
                    var matchesStatus = !selectedStatus || status === selectedStatus;

                    if (matchesQuery && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterInventory);
            if (statusFilter) statusFilter.addEventListener('change', filterInventory);
        });
    </script>
}
