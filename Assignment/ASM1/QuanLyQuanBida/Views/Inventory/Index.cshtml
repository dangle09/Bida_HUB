                    <table class="table table-dark table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.74rem;">
                            <tr>
                                <th class="ps-3">MÃ PHIẾU</th>
                                <th>NHÀ CUNG CẤP</th>
                                <th>NGÀY NHẬP</th>
                                <th>NGƯỜI LẬP PHIẾU</th>
                                <th>GHI CHÚ HÀNG HÓA</th>
                                <th class="text-end">TỔNG TIỀN</th>
                                <th class="text-center">TÌNH TRẠNG</th>
                                <th class="text-center pe-3">XEM CHI TIẾT</th>
                            </tr>
                        </thead>
