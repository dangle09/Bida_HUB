<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Quản lý hàng hóa</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Kho & Nhập hàng</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-box-seam" style="color: #60a5fa;"></i>
                QUẢN LÝ KHO & LỊCH SỬ NHẬP HÀNG
            </h2>
            <div class="text-muted small">Kiểm soát tồn kho thực tế 24 mặt hàng, định mức cảnh báo và chứng từ nhập kho VAT</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalKiemKeKho" style="border-radius: 2px !important;">
                <i class="bi bi-clipboard-check text-info"></i> Kiểm Kê Kho
            </button>
            <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalNhapHang" style="border-radius: 2px !important;">
                <i class="bi bi-plus-circle-fill"></i> Tạo Phiếu Nhập Hàng
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ KPI KHO (ĐỒNG BỘ 100% VỚI 24 MẶT HÀNG) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng mặt hàng kho</p>
                    <div class="kpi-value text-white">24 <small class="fs-6 text-muted fw-normal">Mục</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <p class="kpi-label">Giá trị tồn kho</p>
                    <div class="kpi-value text-white">48.650K <small class="fs-6 text-muted fw-normal">VNĐ</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #ef4444; background: rgba(239, 68, 68, 0.1);">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <p class="kpi-label">Cảnh báo sắp hết</p>
                    <div class="kpi-value text-danger">3 <small class="fs-6 text-danger fw-normal">Cần nhập</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng nhập tháng này</p>
                    <div class="kpi-value text-white">22.500K <small class="fs-6 text-muted fw-normal">VNĐ</small></div>
                </div>
            </div>
        </div>
    </div>

