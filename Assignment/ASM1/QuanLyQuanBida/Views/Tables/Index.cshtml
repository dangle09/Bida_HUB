@model QuanLyQuanBida.ViewModels.TablesManageViewModel
@{
    ViewData["Title"] = "Quản lý Bàn & Giá - BOLT BILLIARDS";
    Layout = "_AdminLayout";
    var allTables = ViewBag.AllTables as List<QuanLyQuanBida.ViewModels.PosTableCardViewModel> ?? Model.Tables;
    var slotsByType = ViewBag.SlotsByType as Dictionary<int, List<QuanLyQuanBida.Models.TimeSlotPrice>> ?? new Dictionary<int, List<QuanLyQuanBida.Models.TimeSlotPrice>>();
    var tablesById = ViewBag.TablesById as Dictionary<int, QuanLyQuanBida.Models.BilliardTable> ?? new Dictionary<int, QuanLyQuanBida.Models.BilliardTable>();
    int? selectedAreaId = ViewBag.SelectedAreaId as int?;

    int poolCount = allTables.Count(t => t.TableTypeName.Contains("Pool", StringComparison.OrdinalIgnoreCase));
    int caromCount = allTables.Count(t => t.TableTypeName.Contains("Carom", StringComparison.OrdinalIgnoreCase));
    int vipCount = allTables.Count(t => t.TableTypeName.Contains("VIP", StringComparison.OrdinalIgnoreCase));
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-controller="Categories" asp-action="Index">Quản lý hàng hóa</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Quản lý Bàn &amp; Giá</span>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-gear-wide-connected" style="color: #c084fc;"></i>
                QUẢN LÝ @allTables.Count BÀN BIDA &amp; BIỂU PHÍ THEO KHUNG GIỜ
            </h2>
            <div class="text-muted small">Cấu hình danh sách bàn thi đấu, thiết lập biểu phí 2 khung giờ tự động và theo dõi thiết bị đi kèm của từng bàn</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Pos" asp-action="Index" class="btn btn-dark btn-sm border-secondary text-light action-btn-labeled">
                <i class="bi bi-grid-3x3-gap text-warning"></i><span>Xem Sơ đồ bàn POS</span>
            </a>
            <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalThemBan">
                <i class="bi bi-plus-circle-fill"></i> Thêm Bàn Mới
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-10 border-success text-success d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-10 border-danger text-danger d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 KPI BÀN THỰC TẾ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);"><i class="bi bi-grid-3x3-gap"></i></div>
                <div>
                    <p class="kpi-label">Tổng số bàn thi đấu</p>
                    <div class="kpi-value text-white">@allTables.Count <small class="fs-6 text-muted fw-normal">Bàn</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);"><i class="bi bi-circle"></i></div>
                <div>
                    <p class="kpi-label">Bàn Pool 9-Ball (Lỗ)</p>
                    <div class="kpi-value" style="color: #60a5fa;">@poolCount <small class="fs-6 text-muted fw-normal">Bàn</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);"><i class="bi bi-disc"></i></div>
                <div>
                    <p class="kpi-label">Bàn Carom Phăng</p>
                    <div class="kpi-value" style="color: #eab308;">@caromCount <small class="fs-6 text-muted fw-normal">Bàn</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #c084fc; background: rgba(192, 132, 252, 0.1);"><i class="bi bi-star-fill"></i></div>
                <div>
                    <p class="kpi-label">Phòng VIP 3 Băng</p>
                    <div class="kpi-value" style="color: #c084fc;">@vipCount <small class="fs-6 text-muted fw-normal">Phòng</small></div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills nav-pills-bolt mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-dsban" type="button">
                <i class="bi bi-list-columns me-1"></i> Danh Sách Thông Số Bàn (@Model.Tables.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-banggia" type="button">
                <i class="bi bi-clock-history me-1"></i> Biểu Phí Theo Khung Giờ (@Model.TimeSlots.Count Khung)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-thietbi" type="button">
                <i class="bi bi-lamp me-1"></i> Thiết Bị Đi Kèm Bàn (@Model.Equipments.Select(e => e.BilliardTableId).Distinct().Count()/@allTables.Count Bàn)
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- TAB 1: DANH SÁCH ĐỦ 20 BÀN KÈM GIÁ 2 KHUNG GIỜ -->
        <div class="tab-pane fade show active" id="tab-dsban">
            <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-sm @(selectedAreaId == null ? "btn-bolt-neon" : "btn-outline-secondary")">Tất cả (@allTables.Count)</a>
                    @foreach (var a in Model.Areas)
                    {
                        <a asp-action="Index" asp-route-areaId="@a.Id" class="btn btn-sm @(selectedAreaId == a.Id ? "btn-bolt-neon" : "btn-outline-secondary")">@a.Name</a>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 small">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem;">
                            <tr>
                                <th class="ps-3" style="width: 55px;">STT</th>
                                <th>MÃ BÀN</th>
                                <th>TÊN BÀN</th>
                                <th>KHU VỰC</th>
                                <th>LOẠI BÀN</th>
                                <th class="text-end">GIÁ KHUNG NGÀY</th>
                                <th class="text-end">GIÁ KHUNG TỐI</th>
                                <th class="text-center">TRẠNG THÁI</th>
                                <th class="text-end pe-3">ĐỔI TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int tStt = 1; }
                            @foreach (var t in Model.Tables)
                            {
                                var tblEntity = tablesById.ContainsKey(t.Id) ? tablesById[t.Id] : null;
                                var tSlots = tblEntity != null && slotsByType.ContainsKey(tblEntity.TableTypeId)
                                    ? slotsByType[tblEntity.TableTypeId]
                                    : new List<QuanLyQuanBida.Models.TimeSlotPrice>();
                                decimal p1 = tSlots.Count >= 1 ? tSlots[0].SlotPrice : t.HourlyRate;
                                decimal p2 = tSlots.Count >= 2 ? tSlots[1].SlotPrice : p1;
                                <tr>
                                    <td class="ps-3 text-secondary font-monospace fw-bold">@(tStt++)</td>
                                    <td class="font-monospace text-info fw-bold">@t.Code</td>
                                    <td class="fw-bold text-white">@t.Name</td>
                                    <td>@t.AreaName</td>
                                    <td>@t.TableTypeName</td>
                                    <td class="text-end fw-bold text-success">@p1.ToString("N0") đ/h</td>
                                    <td class="text-end fw-bold" style="color: var(--primary-neon);">@p2.ToString("N0") đ/h</td>
                                    <td class="text-center">
                                        <span class="badge @(t.Status == "Đang chơi" ? "bg-warning text-dark" : t.Status == "Trống" ? "bg-success text-dark" : "bg-info text-dark") fw-bold">@t.Status</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-action="ChangeStatus" method="post" class="d-inline-flex gap-1 align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <select name="status" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 135px;">
                                                <option value="Trống" selected="@(t.Status == "Trống" ? "selected" : null)">Trống</option>
                                                <option value="Đang chơi" selected="@(t.Status == "Đang chơi" ? "selected" : null)">Đang chơi</option>
                                                <option value="Đã đặt trước" selected="@(t.Status == "Đã đặt trước" ? "selected" : null)">Đã đặt trước</option>
                                                <option value="Bảo trì" selected="@(t.Status == "Bảo trì" ? "selected" : null)">Bảo trì</option>
                                            </select>
                                            <button type="submit" class="btn btn-outline-info btn-sm action-btn" title="Cập nhật trạng thái">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: BIỂU PHÍ 2 KHUNG GIỜ CHO MỖI LOẠI BÀN + NÚT SỬA GIÁ & GIỜ -->
        <div class="tab-pane fade" id="tab-banggia">
            <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-white small text-uppercase font-heading"><i class="bi bi-clock-history text-warning me-2"></i>CẤU HÌNH 2 KHUNG GIỜ GIÁ CHO TỪNG LOẠI BÀN</span>
                        <div class="text-muted small">Mỗi loại bàn có Khung Ngày và Khung Tối. Khi khách đang chơi bước sang khung giờ mới, Sơ đồ bàn POS sẽ tự động tính lại tiền giờ theo từng phút.</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 small">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem;">
                            <tr>
                                <th class="ps-3" style="width: 55px;">STT</th>
                                <th>LOẠI BÀN</th>
                                <th>NHÓM KHUNG GIỜ</th>
                                <th>KHUNG GIỜ ÁP DỤNG</th>
                                <th class="text-end">ĐƠN GIÁ GIỜ</th>
                                <th class="text-end pe-3" style="width: 150px;">CHỈNH SỬA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int slotStt = 1;
                                var seenByType = new Dictionary<string, int>();
                            }
                            @foreach (var s in Model.TimeSlots)
                            {
                                int idxInType = seenByType.ContainsKey(s.TableTypeName) ? seenByType[s.TableTypeName] + 1 : 1;
                                seenByType[s.TableTypeName] = idxInType;
                                bool isDay = idxInType == 1;
                                <tr>
                                    <td class="ps-3 text-secondary font-monospace fw-bold">@(slotStt++)</td>
                                    <td class="fw-bold text-white">@s.TableTypeName</td>
                                    <td>
                                        <span class="badge @(isDay ? "bg-info text-dark" : "bg-warning text-dark") fw-bold">
                                            @(isDay ? "☀️ Khung 1 (Ban ngày)" : "🌙 Khung 2 (Buổi tối / Đêm)")
                                        </span>
                                    </td>
                                    <td class="font-monospace text-info fw-semibold">@s.SlotStartTime.ToString(@"hh\:mm") — @s.SlotEndTime.ToString(@"hh\:mm")</td>
                                    <td class="text-end fw-bold fs-6" style="color: var(--primary-neon);">@s.SlotPrice.ToString("N0") đ/giờ</td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-outline-warning action-btn-labeled"
                                                onclick="openEditSlotModal(@s.Id, '@s.TableTypeName', '@(isDay ? "Khung 1 (Ban ngày)" : "Khung 2 (Buổi tối / Đêm)")', '@s.SlotStartTime.ToString(@"hh\:mm")', '@s.SlotEndTime.ToString(@"hh\:mm")', @((int)s.SlotPrice))">
                                            <i class="bi bi-pencil-square"></i><span>Sửa giá &amp; giờ</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: THIẾT BỊ ĐI KÈM ĐẦY ĐỦ 20/20 BÀN -->
        <div class="tab-pane fade" id="tab-thietbi">
            <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3">
                    <span class="fw-bold text-white small text-uppercase font-heading"><i class="bi bi-lamp text-info me-2"></i>DANH MỤC THIẾT BỊ ĐI KÈM ĐẦY ĐỦ @Model.Equipments.Count BÀN</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 small">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem;">
                            <tr>
                                <th class="ps-3" style="width: 55px;">STT</th>
                                <th>BÀN ÁP DỤNG</th>
                                <th>BỘ THIẾT BỊ ĐI KÈM (BI, ĐÈN, PHỤ KIỆN BÀN)</th>
                                <th class="text-center">SỐ BỘ</th>
                                <th class="text-center pe-3">TÌNH TRẠNG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int eqStt = 1; }
                            @foreach (var eq in Model.Equipments)
                            {
                                <tr>
                                    <td class="ps-3 text-secondary font-monospace fw-bold">@(eqStt++)</td>
                                    <td class="fw-bold text-info">@(Model.TableNameDict.ContainsKey(eq.BilliardTableId) ? Model.TableNameDict[eq.BilliardTableId] : $"Bàn #{eq.BilliardTableId}")</td>
                                    <td class="text-white">@eq.Name</td>
                                    <td class="text-center fw-bold">@eq.Quantity</td>
                                    <td class="text-center pe-3"><span class="badge bg-success text-dark fw-bold">@eq.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SỬA KHUNG GIỜ & ĐƠN GIÁ -->
<div class="modal fade" id="modalEditSlot" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold"><i class="bi bi-clock-history text-warning me-2"></i>CHỈNH SỬA KHUNG GIỜ &amp; ĐƠN GIÁ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateTimeSlot" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editSlotId" />
                <div class="modal-body">
                    <div class="p-2 px-3 mb-3 bg-black border border-secondary border-opacity-50 small">
                        <div class="fw-bold text-white" id="editSlotTypeName"></div>
                        <div class="text-warning" id="editSlotGroupLabel"></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Giờ bắt đầu</label>
                            <input type="time" name="startTime" id="editSlotStart" class="form-control form-control-bolt" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Giờ kết thúc</label>
                            <input type="time" name="endTime" id="editSlotEnd" class="form-control form-control-bolt" required />
                        </div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-uppercase text-muted">Đơn giá mỗi giờ (VNĐ)</label>
                        <input type="number" name="slotPrice" id="editSlotPrice" class="form-control form-control-bolt fw-bold" min="0" step="1000" required />
                        <div class="form-text small">Sau khi lưu, Sơ đồ bàn POS sẽ tự động tính lại tiền giờ theo khung mới.</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu Biểu Phí Mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL THÊM BÀN MỚI -->
<div class="modal fade" id="modalThemBan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold"><i class="bi bi-plus-circle-fill text-success me-2"></i>THÊM BÀN BIDA MỚI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateTable" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-bold text-uppercase text-muted">Mã bàn</label>
                            <input type="text" name="code" class="form-control form-control-bolt font-monospace text-uppercase" placeholder="VD: BAN_21" required />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold text-uppercase text-muted">Tên hiển thị</label>
                            <input type="text" name="name" class="form-control form-control-bolt" placeholder="VD: Bàn 21 (Lỗ Pool)" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Khu vực đặt bàn</label>
                        <select name="tableAreaId" class="form-select form-select-bolt">
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-uppercase text-muted">Loại bàn &amp; Mức giá</label>
                        <select name="tableTypeId" class="form-select form-select-bolt">
                            @foreach (var t in Model.TableTypes)
                            {
                                <option value="@t.Id">@t.Name (@t.BasePrice.ToString("N0") đ/giờ)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-bolt-neon btn-sm"><i class="bi bi-check-lg"></i> Lưu bàn mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditSlotModal(id, typeName, groupLabel, start, end, price) {
            document.getElementById('editSlotId').value = id;
            document.getElementById('editSlotTypeName').textContent = typeName;
            document.getElementById('editSlotGroupLabel').textContent = groupLabel;
            document.getElementById('editSlotStart').value = start;
            document.getElementById('editSlotEnd').value = end;
            document.getElementById('editSlotPrice').value = price;
            new bootstrap.Modal(document.getElementById('modalEditSlot')).show();
        }
    </script>
}
