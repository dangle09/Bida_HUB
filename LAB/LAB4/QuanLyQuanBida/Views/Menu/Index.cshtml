                                <img src="~/images/fnb/fnb-1-caphe-muoi.png" class="thumb-category-img" alt="Cà phê muối" />
                            </div>
                        </td>
                        <td><span class="badge bg-black border border-info text-info">CP_MUOI</span></td>
                        <td>
                            <div class="fw-bold text-white item-name">Cà phê muối Đào Ngọc Giang</div>
                            <div class="small text-muted">Cà phê Robusta thơm đậm đà kết hợp lớp kem béo mặn nhẹ</div>
                        </td>
                        <td><span class="badge bg-dark text-light border border-secondary item-category">Nước Giải Khát</span></td>
                        <td class="item-unit">Ly</td>
                        <td class="text-end fw-bold item-price" style="color: var(--primary-neon);">28.000 đ</td>
                        <td class="text-center text-success fw-bold item-stock">Sẵn sàng</td>
                        <td class="text-center"><span class="badge bg-success text-dark" style="border-radius: 2px;">ĐANG BÁN</span></td>
                        <td class="text-center pe-3">
                            <button class="btn btn-sm btn-outline-warning p-1 px-2 me-1 btn-edit-menu" data-id="1" data-code="CP_MUOI" data-name="Cà phê muối Đào Ngọc Giang" data-category="drink" data-unit="Ly" data-price="28000" data-stock="Sẵn sàng" title="Chỉnh sửa món" style="border-radius: 2px !important;"><i class="bi bi-pencil-square"></i></button>
                            <button class="btn btn-sm btn-outline-danger p-1 px-2 btn-delete-menu" data-id="1" data-code="CP_MUOI" data-name="Cà phê muối Đào Ngọc Giang" title="Xóa hoặc ngừng bán" style="border-radius: 2px !important;"><i class="bi bi-trash"></i></button>
