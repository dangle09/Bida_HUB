                            <button class="btn btn-sm btn-outline-danger p-1 px-2 btn-delete-menu" data-id="4" data-code="TRA_MC" data-name="Trà mãng cầu xiêm chua ngọt" title="Xóa hoặc ngừng bán" style="border-radius: 2px !important;"><i class="bi bi-trash"></i></button>
