@* ===================================================================================
   WEB QUẢN LÝ (BIDA POS & ADMIN DASHBOARD) - VẬN HÀNH: THỰC ĐƠN & DỊCH VỤ F&B
   - Tên file: Views/Menu/Index.cshtml
   - Vai trò: Giao diện quản lý thực đơn đồ uống, thức ăn nhẹ và phụ kiện bida
   - Layout: Views/Shared/_AdminLayout.cshtml
   - CSS: wwwroot/css/admin-pos.css (Chuẩn bo góc 2px radius toàn trang)
   =================================================================================== *@
@{
    ViewData["Title"] = "Thực đơn & Dịch vụ - BOLT BILLIARDS";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Vận hành & Bán hàng</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Thực đơn & Dịch vụ</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-cup-straw text-info"></i>
                THỰC ĐƠN ĐỒ UỐNG, MÓN ĂN & PHỤ KIỆN
            </h2>
            <div class="text-muted small">Quản lý giá bán, định lượng và trạng thái phục vụ cho quầy Bar & Thu ngân</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" onclick="alert('Đã đồng bộ thực đơn với ứng dụng khách hàng.');" style="border-radius: 2px !important;">
                    <i class="bi bi-arrow-repeat"></i> Đồng bộ menu
                </button>
                <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalThemMonMoi" style="border-radius: 2px !important;">
                    <i class="bi bi-plus-circle-fill"></i> Thêm Món Mới
                </button>
            }
            else
            {
                <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 p-2" style="border-radius: 2px;">
                    <i class="bi bi-eye me-1"></i> Quyền Thu ngân: Chỉ xem thực đơn
                </span>
            }
        </div>
    </div>

    <!-- 4 THẺ KPI THỐNG KÊ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-card-checklist"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng thực đơn</p>
                    <div class="kpi-value text-white">20 <small class="fs-6 text-muted fw-normal">Sản phẩm</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <div>
                    <p class="kpi-label">Nước uống & Cà phê</p>
                    <div class="kpi-value" style="color: #60a5fa;">10 <small class="fs-6 text-muted fw-normal">Món</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div>
                    <p class="kpi-label">Ẩm thực F&B ăn vặt</p>
                    <div class="kpi-value" style="color: #eab308;">6 <small class="fs-6 text-muted fw-normal">Món</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #c084fc; background: rgba(192, 132, 252, 0.1);">
                    <i class="bi bi-tools"></i>
                </div>
                <div>
                    <p class="kpi-label">Dụng cụ & Cơ thủ</p>
                    <div class="kpi-value" style="color: #c084fc;">4 <small class="fs-6 text-muted fw-normal">Vật phẩm</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH MÓN ĂN & DỊCH VỤ -->
    <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
        <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="menuSearchInput" class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Tìm tên món, mã hàng..." style="width: 250px; border-radius: 2px !important;" />
                <select id="menuCategoryFilter" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 230px; border-radius: 2px !important;">
                    <option value="">Tất cả danh mục (20)</option>
                    <option value="drink">Nước uống & Cà phê (10)</option>
                    <option value="food">Ẩm thực F&B & Đồ ăn nhanh (6)</option>
                    <option value="accessories">Dụng cụ & Phụ kiện cơ thủ (4)</option>
                </select>
            </div>
            <div class="text-muted small">
                Hiển thị <strong id="menuVisibleCount" class="text-light">20</strong> / 20 mặt hàng phục vụ
            </div>
        </div>

        <div class="table-responsive">
