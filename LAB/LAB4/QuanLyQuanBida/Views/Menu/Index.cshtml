@section Scripts {
    <script>
        function previewItemImg(input, previewImgId, hideIconId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById(previewImgId);
                    if (img) {
                        img.src = e.target.result;
                        img.style.display = 'block';
                    }
                    if (hideIconId) {
                        var icon = document.getElementById(hideIconId);
                        if (icon) icon.style.display = 'none';
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('menuSearchInput');
            var categoryFilter = document.getElementById('menuCategoryFilter');
            var visibleCount = document.getElementById('menuVisibleCount');
            var tableRows = document.querySelectorAll('#menuTable tbody tr');

            function filterMenu() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedCat = (categoryFilter.value || '').trim();
                var count = 0;

                tableRows.forEach(function (row) {
                    var rowCat = row.getAttribute('data-category') || '';
                    var text = row.textContent.toLowerCase();

                    var matchesQuery = !query || text.includes(query);
                    var matchesCat = !selectedCat || rowCat === selectedCat;

                    if (matchesQuery && matchesCat) {
                        row.style.display = '';
                        count++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = count;
                }
            }

            if (searchInput) searchInput.addEventListener('input', filterMenu);
            if (categoryFilter) categoryFilter.addEventListener('change', filterMenu);

            // Bắt sự kiện click nút Sửa
            document.querySelectorAll('.btn-edit-menu').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var code = this.getAttribute('data-code');
                    var name = this.getAttribute('data-name');
                    var unit = this.getAttribute('data-unit');
                    var price = this.getAttribute('data-price');
                    var category = this.getAttribute('data-category');
                    var stock = this.getAttribute('data-stock');

                    document.getElementById('editItemCode').value = code;
                    document.getElementById('editItemCodeDisplay').value = code;
                    document.getElementById('editItemName').value = name;
                    document.getElementById('editItemUnit').value = unit;
                    document.getElementById('editItemPrice').value = price;
                    document.getElementById('editItemStock').value = stock;

                    var catSelect = document.getElementById('editItemCategory');
                    if (catSelect) catSelect.value = category;

                    var modal = new bootstrap.Modal(document.getElementById('modalSuaMon'));
                    modal.show();
                });
            });

            // Bắt sự kiện click nút Xóa
            document.querySelectorAll('.btn-delete-menu').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var code = this.getAttribute('data-code');
                    var name = this.getAttribute('data-name');

                    document.getElementById('deleteItemName').textContent = name;
                    document.getElementById('deleteItemCode').textContent = code;

                    var modal = new bootstrap.Modal(document.getElementById('modalXoaMon'));
                    modal.show();
                });
            });
        });
    </script>
}
