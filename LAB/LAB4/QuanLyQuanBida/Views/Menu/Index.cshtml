                            <button class="btn btn-sm btn-outline-danger p-1 px-2 btn-delete-menu" data-id="3" data-code="REDBULL" data-name="Redbull Thái ướp lạnh" title="Xóa hoặc ngừng bán" style="border-radius: 2px !important;"><i class="bi bi-trash"></i></button>
