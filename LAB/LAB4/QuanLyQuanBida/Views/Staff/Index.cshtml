@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-edit-staff').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var name = this.getAttribute('data-name');
                    var phone = this.getAttribute('data-phone');
                    var shift = this.getAttribute('data-shift');
                    var rate = this.getAttribute('data-rate');

                    document.getElementById('editStaffTitle').textContent = name;
                    document.getElementById('editStaffName').value = name;
                    document.getElementById('editStaffPhone').value = phone;
                    document.getElementById('editStaffShift').value = shift;
                    document.getElementById('editStaffRate').value = rate;

                    var modal = new bootstrap.Modal(document.getElementById('modalSuaNhanVien'));
                    modal.show();
                });
            });
        });
    </script>
}
