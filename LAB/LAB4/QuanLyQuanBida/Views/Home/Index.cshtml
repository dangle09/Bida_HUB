<!-- 6. ĐẶT BÀN TRỰC TUYẾN 24/7 (BỐ CỤC: 1/3 ẢNH DỌC + 2/3 FORM BÊN PHẢI - ẢNH 3) -->

<section class="section-pad" id="booking">

    <div class="container">

        <div class="text-center mb-4">

            <span class="section-badge">GIỮ CHỖ NHANH CHÓNG</span>

            <h2 class="section-title mb-2">ĐẶT BÀN TRỰC TUYẾN</h2>

            <p class="section-subtitle mb-0">

                Chỉ mất 30 giây để đặt trước tại BOLT BILLIARDS Đồng Nai, nhân viên sẽ chuẩn bị bàn sạch sẽ và giữ vị trí đẹp nhất cho bạn!

            </p>

        </div>



        <div class="row g-4 align-items-stretch mt-2">

            <!-- 1/3 CỘT TRÁI: KHUNG ẢNH DỌC CHỪA CHỖ THÊM ẢNH SAU (ẢNH 3) -->

            <div class="col-lg-4 col-md-5">

                <div class="booking-poster-slot h-100">

                    <div class="poster-inner">

                        <div class="poster-overlay">

                            <span class="badge bg-success text-dark fw-bold mb-2">BOLT ĐỒNG NAI</span>

                            <h4 class="text-white font-heading">ĐẲNG CẤP CƠ THỦ</h4>

                            <p class="small text-secondary mb-0">

                                Dàn bàn chuẩn quốc tế luôn sẵn sàng đón tiếp bạn và những người anh em đam mê bộ môn bi-a.

                            </p>

                        </div>

                    </div>

                </div>

            </div>



            <!-- 2/3 CỘT PHẢI: FORM ĐẶT BÀN (ẢNH 3) -->

            <div class="col-lg-8 col-md-7">

                <div class="booking-card h-100">

                    <form id="onlineBookingForm">

                        <div class="row g-3">

                            <!-- Họ tên -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Họ và tên *</label>

                                <input type="text" class="form-control form-control-bolt" id="bookName" placeholder="Ví dụ: Nguyễn Văn A" required />

                            </div>



                            <!-- Số điện thoại -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Số điện thoại *</label>

                                <input type="tel" class="form-control form-control-bolt" id="bookPhone" placeholder="Ví dụ: 0987654321" required />

                            </div>



                            <!-- Chọn loại bàn -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Loại Bàn Yêu Cầu *</label>

                                <select class="form-select form-select-bolt" id="bookTableType">

                                    <option value="Pool 9-Ball (Bàn Lỗ)">Bàn Pool 9-Ball (Bàn Lỗ Chuẩn)</option>

                                    <option value="Carom Libre (Băng Phổ Thông)">Bàn Carom Libre (Bida Phăng)</option>

                                    <option value="Carom 3C (3 Băng Sưởi Nhiệt)">Bàn Carom 3 Băng Sưởi Nhiệt</option>

                                    <option value="Phòng VIP Riêng Biệt">Phòng VIP Riêng Biệt (Smart TV)</option>

                                </select>

                            </div>



                            <!-- Số người dự kiến -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Số Lượng Cơ Thủ</label>

                                <select class="form-select form-select-bolt" id="bookGuests">

                                    <option value="1-2 Người">1 - 2 Người (Đánh đơn / Luyện tập)</option>

                                    <option value="3-4 Người">3 - 4 Người (Đánh đôi / Giao lưu)</option>

                                    <option value="Nhóm đông (5+ người)">Nhóm đông cơ thủ (5+ người)</option>

                                </select>

                            </div>



                            <!-- Ngày đến -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Ngày Đến *</label>

                                <input type="date" class="form-control form-control-bolt" id="bookDate" required />

                            </div>



                            <!-- Giờ đến -->

                            <div class="col-md-6">

                                <label class="form-label-bolt">Giờ Đến Dự Kiến *</label>

                                <input type="time" class="form-control form-control-bolt" id="bookTime" required />

                            </div>



                            <!-- Ghi chú thêm -->

                            <div class="col-12">

                                <label class="form-label-bolt">Ghi Chú Hoặc Yêu Cầu Thêm</label>

                                <textarea class="form-control form-control-bolt" id="bookNote" rows="2" placeholder="Ví dụ: Lấy bàn gần điều hòa, chuẩn bị sẵn 2 cơ nặng 520g..."></textarea>

                            </div>



                            <!-- Nút Xác Nhận -->

                            <div class="col-12 text-center mt-3">

                                <button type="submit" class="btn btn-bolt-neon btn-lg w-100 py-3">

                                    <i class="bi bi-check2 me-1"></i> XÁC NHẬN GỬI YÊU CẦU ĐẶT BÀN

                                </button>

                                <div class="text-secondary small mt-2">

                                    <i class="bi bi-shield-check text-success"></i> Thông tin của bạn được bảo mật tuyệt đối. Chúng tôi sẽ gọi xác nhận trong 5 phút.

                                </div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- 7. POPUP MODAL ĐĂNG KÝ GIẢI ĐẤU (ẢNH 2) -->

<div class="modal fade" id="tournamentModal" tabindex="-1" aria-labelledby="tournamentModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content modal-content-bolt">

            <div class="modal-header modal-header-bolt">

                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-trophy fs-4" style="color: var(--bolt-neon);"></i>

                    <div>

                        <h5 class="modal-title font-heading text-white mb-0" id="tournamentModalLabel">

                            ĐĂNG KÝ THI ĐẤU BOLT CHAMPIONSHIP

                        </h5>

                        <small class="text-secondary" style="font-size: 0.75rem;">Giải đấu ngày 25 hàng tháng • Tổng thưởng 15.000.000đ</small>

                    </div>

                </div>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>

            <div class="modal-body modal-body-bolt">

                <form id="tournamentRegisterForm">

                    <div class="mb-3">

                        <label class="form-label-bolt">Họ và tên cơ thủ *</label>

                        <input type="text" class="form-control form-control-bolt" id="tourPlayerName" placeholder="Ví dụ: Nguyễn Hoàng Nam" required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label-bolt">Số điện thoại liên hệ *</label>

                        <input type="tel" class="form-control form-control-bolt" id="tourPlayerPhone" placeholder="Ví dụ: 0987654321" required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label-bolt">Hạng cơ thủ dự kiến *</label>

                        <select class="form-select form-select-bolt" id="tourPlayerRank">

                            <option value="Hạng E (Cơ thủ tốt - Chạm 6)">Hạng E (Phong trào tốt - Chạm 6)</option>

                            <option value="Hạng F (Phong trào vừa - Chạm 5)">Hạng F (Phong trào vừa - Chạm 5)</option>

                            <option value="Hạng G (Mới giao lưu - Chạm 4)">Hạng G (Giao lưu phong trào - Chạm 4)</option>

                            <option value="Hạng Mở Rộng Open (Chạm 7)">Hạng Mở Rộng Open (Chạm 7)</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label-bolt">CLB hoặc Đội sinh hoạt (Nếu có)</label>

                        <input type="text" class="form-control form-control-bolt" id="tourPlayerClub" placeholder="Ví dụ: Tự do hoặc CLB Biên Hòa" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label-bolt">Ghi chú thêm</label>

                        <textarea class="form-control form-control-bolt" id="tourPlayerNote" rows="2" placeholder="Ghi chú về lịch thi đấu nếu cần..."></textarea>

                    </div>

                    <button type="submit" class="btn btn-bolt-neon w-100 py-2">

                        <i class="bi bi-check2 me-1"></i> XÁC NHẬN GỬI ĐĂNG KÝ THI ĐẤU

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        // Set ngày mặc định là hôm nay

        document.getElementById('bookDate').valueAsDate = new Date();



        // Xử lý mũi tên trượt qua lại giữa các sản phẩm (Ảnh 1)

        function getActiveSlider() {

            if ($('#fnb').hasClass('show') || $('#fnb').hasClass('active')) {

                return document.getElementById('fnbSlider');

            }

            return document.getElementById('shopSlider');

        }



        $('#slidePrevBtn').click(function () {

            const slider = getActiveSlider();

            if (slider) {

                slider.scrollBy({ left: -280, behavior: 'smooth' });

            }

        });



        $('#slideNextBtn').click(function () {

            const slider = getActiveSlider();

            if (slider) {

                slider.scrollBy({ left: 280, behavior: 'smooth' });

            }

        });



        // Xử lý gửi Form Đặt Bàn (Ảnh 3)

        $('#onlineBookingForm').submit(function (e) {

            e.preventDefault();

            const name = $('#bookName').val();

            const phone = $('#bookPhone').val();

            const table = $('#bookTableType').val();

            const time = $('#bookTime').val();



            alert(`🎉 ĐẶT BÀN THÀNH CÔNG!\n\nCảm ơn bạn ${name} (${phone})!\nBOLT BILLIARDS Đồng Nai đã nhận yêu cầu đặt [${table}] lúc ${time}.\nNhân viên thu ngân sẽ gọi lại để xác nhận số bàn trống cho bạn ngay ạ!`);

            this.reset();

            document.getElementById('bookDate').valueAsDate = new Date();

        });



        // Xử lý gửi Form Đăng Ký Giải Đấu (Ảnh 2)

        $('#tournamentRegisterForm').submit(function (e) {

            e.preventDefault();

            const name = $('#tourPlayerName').val();

            const phone = $('#tourPlayerPhone').val();

            const rank = $('#tourPlayerRank').val();



            // Đóng Modal

            const modalEl = document.getElementById('tournamentModal');

            const modal = bootstrap.Modal.getInstance(modalEl);

            if (modal) modal.hide();



            alert(`🏆 ĐĂNG KÝ GIẢI THÀNH CÔNG!\n\nChào mừng cơ thủ: ${name} (${phone})\nHạng đăng ký: ${rank}\nBan tổ chức giải BOLT OPEN CHAMPIONSHIP sẽ liên hệ xếp lịch thi đấu cho bạn trước ngày 24 hàng tháng nhé!`);

            this.reset();

        });

    </script>

}

