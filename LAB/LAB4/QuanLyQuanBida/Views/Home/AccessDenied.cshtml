@{
    ViewData["Title"] = "Từ chối truy cập (Access Denied)";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-dark text-white border-danger border-opacity-50 p-4 rounded-4 shadow-lg" style="background: rgba(20, 24, 33, 0.95); backdrop-filter: blur(10px);">
                <div class="mb-3">
                    <span class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                        <i class="bi bi-shield-lock-fill fs-1"></i>
                    </span>
                </div>
                
                <h3 class="fw-bold text-danger mb-2">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h3>
                <p class="text-secondary small mb-4">
                    Khu vực hoặc hành động này chỉ dành riêng cho tài khoản có vai trò <strong>Quản lý (Manager / Admin)</strong> 
                    theo chính sách phân quyền <code>ManagerOnly</code> của Lab 4.
                </p>

                <div class="bg-black bg-opacity-40 p-3 rounded-3 text-start small mb-4 border border-secondary border-opacity-25">
                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                        <span class="text-muted">Tài khoản hiện tại:</span>
                        <span class="fw-semibold text-light">@User.Identity?.Name</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Vai trò hiện tại:</span>
                        <span class="badge bg-warning text-dark">
                            @(User.IsInRole("Manager") ? "Manager" : "Employee")
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-light px-4 rounded-3">
                        <i class="bi bi-arrow-left me-1"></i> Về Danh Mục
                    </a>
                    <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4 rounded-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Đổi Tài Khoản Quản Lý
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
