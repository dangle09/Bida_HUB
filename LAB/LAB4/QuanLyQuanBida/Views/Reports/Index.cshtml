@section Scripts {
    <script>
        function applyReportFilter() {
            var range = document.getElementById('reportTimeRange').value;
            alert('Đã cập nhật dữ liệu báo cáo theo khoảng thời gian: ' + range);
        }

        function exportReportCSV() {
            var csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Ma_HD,So_Ban,Khach_Hang,Gio_Vao,Gio_Ra,Tien_Ban,Tien_Dich_Vu,Giam_Gia,Tong_Tien,Phuong_Thuc\n";
            @foreach (var inv in invoices)
            {
                <text>csvContent += "@inv.Code,@inv.Table,@inv.Customer,@inv.InTime,@inv.OutTime,@inv.TableFee,@inv.FnbFee,@inv.Discount,@inv.Total,@inv.Method\n";</text>
            }
            var encodedUri = encodeURI(csvContent);
            var link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "Bao_Cao_Doanh_Thu_Bolt_Billiards_261117.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
