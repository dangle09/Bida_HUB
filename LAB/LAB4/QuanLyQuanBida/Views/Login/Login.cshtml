@model QuanLyQuanBida.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống - BOLT BILLIARDS POS";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bolt-neon: #a6ff00;
            --bolt-neon-glow: rgba(166, 255, 0, 0.35);
            --bolt-dark: #07090e;
            --bolt-card: rgba(14, 19, 29, 0.94);
            --bolt-border: rgba(255, 255, 255, 0.12);
            --bolt-text-muted: #94a3b8;
            --bolt-text-bright: #f8fafc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: 'Inter', sans-serif;
            background-color: var(--bolt-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(166, 255, 0, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(0, 160, 255, 0.06) 0%, transparent 45%),
                linear-gradient(180deg, #07090e 0%, #0c111a 100%);
            color: var(--bolt-text-bright);
        }

        .login-card {
            background: var(--bolt-card);
            border: 1px solid var(--bolt-border);
            border-radius: 2px !important;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(166, 255, 0, 0.08);
            backdrop-filter: blur(16px);
            width: 100%;
            max-width: 480px;
            padding: 2.5rem 2.2rem;
            position: relative;
            z-index: 2;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--bolt-neon), transparent);
        }

        .brand-logo {
            height: 56px;
            object-fit: contain;
            filter: drop-shadow(0 0 15px var(--bolt-neon-glow));
        }

        .login-title {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            letter-spacing: 1.2px;
            color: #ffffff;
            font-size: 1.45rem;
            margin-bottom: 4px;
        }

        .login-subtitle {
            color: var(--bolt-text-muted);
            font-size: 0.88rem;
            font-weight: 400;
            letter-spacing: 0.3px;
        }

        .form-label-custom {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #cbd5e1;
            text-transform: uppercase;
            display: block;
            margin-bottom: 6px;
        }

        .input-group-custom {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--bolt-neon);
            font-size: 1.15rem;
            pointer-events: none;
            z-index: 5;
        }

        .form-control-custom {
            width: 100%;
            height: 48px;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff !important;
            border-radius: 2px !important;
            padding: 0.75rem 1rem 0.75rem 44px;
            font-size: 0.95rem;
            transition: all 0.25s ease;
        }

        .form-control-custom:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--bolt-neon);
            box-shadow: 0 0 15px var(--bolt-neon-glow);
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #64748b;
            font-size: 0.88rem;
        }

        .btn-neon {
            background-color: var(--bolt-neon);
            color: #000000 !important;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            letter-spacing: 1px;
            border-radius: 2px !important;
            padding: 0.85rem;
            border: none;
            transition: all 0.25s ease;
            box-shadow: 0 4px 18px var(--bolt-neon-glow);
            text-transform: uppercase;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-neon:hover {
            background-color: #bdfd2b;
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(166, 255, 0, 0.5);
        }

        .quick-badge {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 2px !important;
            padding: 0.45rem 0.75rem;
            font-size: 0.78rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: #e2e8f0;
        }

        .quick-badge:hover {
            border-color: var(--bolt-neon);
            background: rgba(166, 255, 0, 0.12);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .hover-neon {
            color: var(--bolt-text-muted);
            transition: color 0.2s ease;
        }

        .hover-neon:hover {
            color: var(--bolt-neon) !important;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Logo & Thương hiệu -->
        <div class="text-center mb-4">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/bolt-billiards-logo.png" alt="BOLT BILLIARDS" class="brand-logo mb-2" />
            </a>
            <h4 class="login-title"><span style="color: var(--bolt-neon);">BOLT</span> BILLIARDS</h4>
            <div class="login-subtitle">Cổng Đăng Nhập Vận Hành POS & Quản Trị Hệ Thống</div>
        </div>

        <!-- Thông báo lỗi (nếu có) -->
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" style="background: rgba(220, 53, 69, 0.18); border-color: #dc3545; color: #ff8585; border-radius: 2px; @(ViewData.ModelState.IsValid ? "display:none;" : "")" role="alert"></div>

        <!-- Form Đăng nhập -->
        <form asp-controller="Login" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- 1. Tài khoản / Tên đăng nhập -->
            <div class="mb-3 text-start">
                <label class="form-label-custom">Tài khoản / Tên đăng nhập</label>
                <div class="input-group-custom">
                    <i class="bi bi-person-fill input-icon"></i>
                    <input type="text" asp-for="Email" id="inputEmail" class="form-control-custom" placeholder="Nhập admin, manager hoặc cashier..." autofocus required />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- 2. Mật khẩu -->
            <div class="mb-3 text-start">
                <label class="form-label-custom">Mật khẩu bảo mật</label>
                <div class="input-group-custom">
                    <i class="bi bi-shield-lock-fill input-icon"></i>
                    <input asp-for="Password" id="inputPassword" type="password" class="form-control-custom" placeholder="Nhập mật khẩu..." required />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- 3. Ghi nhớ & Về trang khách -->
            <div class="d-flex justify-content-between align-items-center mb-4 small">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" style="background-color: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); border-radius: 2px;" />
                    <label asp-for="RememberMe" class="form-check-label text-light-50" for="rememberMeCheck" style="color: #cbd5e1; cursor: pointer;">Ghi nhớ 24h</label>
                </div>
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none hover-neon small">
                    <i class="bi bi-arrow-left me-1"></i> Trang chủ khách
                </a>
            </div>

            <!-- 4. Nút Đăng nhập -->
            <button type="submit" class="btn btn-neon w-100 mb-3">
                <i class="bi bi-box-arrow-in-right"></i> ĐĂNG NHẬP HỆ THỐNG
            </button>
        </form>

        <!-- Phần kiểm thử phân quyền 3 vai trò: Admin / Manager / Cashier -->
        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
            <div class="mb-2 text-center" style="color: #94a3b8; font-size: 0.8rem; font-weight: 500;">
                <i class="bi bi-lightning-charge-fill me-1" style="color: var(--bolt-neon);"></i>Click chọn nhanh 3 tài khoản phân quyền:
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <button type="button" class="quick-badge" onclick="fillAccount('admin', 'giangcc111')" title="Quản trị viên: Toàn quyền thêm, sửa, xóa, quản trị">
                    <i class="bi bi-shield-fill text-danger"></i>
                    <span><strong>Admin:</strong> admin</span>
                </button>
                <button type="button" class="quick-badge" onclick="fillAccount('manager', 'dangcc111')" title="Quản lý cơ sở: Toàn quyền thêm, sửa, xóa danh mục">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span><strong>Manager:</strong> manager</span>
                </button>
                <button type="button" class="quick-badge" onclick="fillAccount('cashier', 'khoacc111')" title="Thu ngân POS: Xem sơ đồ bàn & danh mục (bị chặn Thêm/Sửa/Xóa)">
                    <i class="bi bi-person-fill text-info"></i>
                    <span><strong>Cashier:</strong> cashier</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Script tự động điền tài khoản để test nhanh -->
    <script>
        function fillAccount(username, password) {
            document.getElementById('inputEmail').value = username;
            document.getElementById('inputPassword').value = password;
        }
    </script>
</body>
</html>