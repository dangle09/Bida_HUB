                        <div class="d-flex justify-content-between text-success">
                            <span>Ưu đãi Hội viên VIP:</span>
                            <span id="receiptDiscount">- 10.000 đ</span>
                        </div>
                    </div>
                    <div class="pt-2">
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>TỔNG CỘNG:</span>
                            <span class="text-danger" id="receiptTotal">185.000 đ</span>
                        </div>
                        <div class="text-center small mt-3 text-muted">
                            <div>Phương thức: <span id="receiptMethod">Chuyển khoản VietQR</span></div>
                            <div class="mt-1">Cảm ơn Quý khách & Hẹn gặp lại!</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px !important;">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="window.print();" style="border-radius: 2px !important;">
                    <i class="bi bi-printer-fill"></i> In Hóa Đơn (Ctrl+P)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('invoiceSearchInput');
            var shiftFilter = document.getElementById('invoiceShiftFilter');
            var methodFilter = document.getElementById('invoiceMethodFilter');
            var tableRows = document.querySelectorAll('#invoicesTable tbody tr');

            function filterInvoices() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedShift = (shiftFilter.value || '').trim();
                var selectedMethod = (methodFilter.value || '').trim();

                tableRows.forEach(function (row) {
                    var shift = row.getAttribute('data-shift') || '';
                    var method = row.getAttribute('data-method') || '';
                    var text = row.textContent.toLowerCase();

                    var matchesQuery = !query || text.includes(query);
                    var matchesShift = !selectedShift || shift === selectedShift;
                    var matchesMethod = !selectedMethod || method === selectedMethod;

                    if (matchesQuery && matchesShift && matchesMethod) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterInvoices);
            if (shiftFilter) shiftFilter.addEventListener('change', filterInvoices);
            if (methodFilter) methodFilter.addEventListener('change', filterInvoices);

            // Click Xem chi tiết / In bill
            document.querySelectorAll('.btn-view-bill').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tr = this.closest('tr');
                    if (!tr) return;

                    var code = tr.querySelector('.bill-code')?.textContent || '';
                    var table = tr.querySelector('.bill-table')?.textContent || '';
                    var customer = tr.querySelector('.bill-customer')?.textContent || '';
                    var time = tr.querySelector('.bill-time')?.textContent || '';
                    var tableFee = tr.querySelector('.bill-tablefee')?.textContent || '';
                    var fnbFee = tr.querySelector('.bill-fnbfee')?.textContent || '';
                    var total = tr.querySelector('.bill-total')?.textContent || '';
                    var method = tr.querySelector('.bill-method')?.textContent || '';

                    document.getElementById('receiptCode').textContent = code;
                    document.getElementById('receiptTable').textContent = table;
                    document.getElementById('receiptCustomer').textContent = customer;
                    document.getElementById('receiptTime').textContent = time;
                    document.getElementById('receiptTableFee').textContent = tableFee;
                    document.getElementById('receiptFnbFee').textContent = fnbFee;
                    document.getElementById('receiptTotal').textContent = total;
                    document.getElementById('receiptMethod').textContent = method;

                    var modal = new bootstrap.Modal(document.getElementById('modalBillDetail'));
                    modal.show();
                });
            });
        });
    </script>
}
