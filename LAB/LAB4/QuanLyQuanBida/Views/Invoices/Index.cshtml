<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Vận hành & Bán hàng</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Hóa đơn & Thu ngân</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-receipt text-success"></i>
                HÓA ĐƠN & GIAO DỊCH THU NGÂN POS
            </h2>
            <div class="text-muted small">Kiểm soát dòng tiền, in lại hóa đơn và đối soát ca trực thời gian thực (Đồng bộ 28 hóa đơn hoàn tất)</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" onclick="alert('Đã xuất file báo cáo Excel 28 hóa đơn ca trực.');" style="border-radius: 2px !important;">
                <i class="bi bi-file-earmark-excel text-success"></i> Xuất Excel
            </button>
            <button class="btn btn-bolt-neon btn-sm" onclick="alert('Đang tổng hợp bàn giao két tiền cho ca kế tiếp: Tổng tiền mặt 3.200.000 đ.');" style="border-radius: 2px !important;">
                <i class="bi bi-printer"></i> In Bàn Giao Ca
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ KPI DOANH THU (ĐỒNG BỘ 100%) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng doanh thu ca</p>
                    <div class="kpi-value text-white">8.450K <small class="fs-6 text-muted fw-normal">VNĐ</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <p class="kpi-label">Hóa đơn hoàn tất</p>
                    <div class="kpi-value" style="color: #60a5fa;">28 <small class="fs-6 text-muted fw-normal">Bill</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <p class="kpi-label">Tiền mặt tại két</p>
                    <div class="kpi-value" style="color: #eab308;">3.200K <small class="fs-6 text-warning fw-normal">(38%)</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #38bdf8; background: rgba(56, 189, 248, 0.1);">
                    <i class="bi bi-qr-code"></i>
                </div>
                <div>
                    <p class="kpi-label">Chuyển khoản VietQR</p>
                    <div class="kpi-value text-white">5.250K <small class="fs-6 text-muted fw-normal">(62%)</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG LỊCH SỬ ĐẦY ĐỦ 28 HÓA ĐƠN -->
    <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
        <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input type="text" id="invoiceSearchInput" class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Mã hóa đơn, tên khách, số bàn..." style="width: 250px; border-radius: 2px !important;" />
                <select id="invoiceShiftFilter" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 170px; border-radius: 2px !important;">
                    <option value="">Tất cả ca trực (28)</option>
                    <option value="sang">Ca Sáng (08:00 - 16:00)</option>
                    <option value="chieu" selected>Ca Chiều (16:00 - 24:00)</option>
                </select>
                <select id="invoiceMethodFilter" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 170px; border-radius: 2px !important;">
                    <option value="">Tất cả phương thức</option>
                    <option value="qr">Chuyển khoản QR (17)</option>
                    <option value="cash">Tiền mặt (11)</option>
                </select>
            </div>
            <div class="text-muted small">
                Hiển thị <span id="invoiceCountDisplay" class="text-white fw-bold">28</span> / 28 hóa đơn hoàn tất hôm nay
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" id="invoicesTable" style="font-size: 0.86rem;">
                <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.74rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-3">MÃ HĐ</th>
                        <th>SỐ BÀN</th>
                        <th>KHÁCH HÀNG</th>
                        <th>GIỜ VÀO - RA</th>
                        <th>THỜI LƯỢNG</th>
                        <th class="text-end">TIỀN GIỜ</th>
                        <th class="text-end">TIỀN F&B</th>
                        <th class="text-end">GIẢM GIÁ</th>
                        <th class="text-end">TỔNG TIỀN</th>
                        <th class="text-center">PHƯƠNG THỨC</th>
                        <th>THU NGÂN</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-center pe-3">IN BILL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in invoices)
                    {
                        <tr data-shift="@inv.Shift" data-method="@inv.MethodKey" class="invoice-row">
                            <td class="ps-3"><strong class="text-white font-monospace bill-code">@inv.Code</strong></td>
                            <td>
                                <span class="badge bg-black border @(inv.Table.Contains("VIP") ? "border-primary text-info" : "border-warning text-warning") bill-table" style="border-radius: 2px;">
                                    @inv.Table
                                </span>
                            </td>
                            <td><span class="text-light fw-semibold bill-customer">@inv.Customer</span></td>
                            <td class="small text-muted bill-time">@inv.InTime</td>
                            <td>@inv.Duration</td>
                            <td class="text-end bill-tablefee">@inv.TableFee.ToString("N0") đ</td>
                            <td class="text-end bill-fnbfee">@inv.FnbFee.ToString("N0") đ</td>
                            <td class="text-end @(inv.Discount > 0 ? "text-success" : "text-muted")">
                                @(inv.Discount > 0 ? $"- {inv.Discount:N0} đ" : "0 đ")
                            </td>
                            <td class="text-end fw-bold bill-total" style="color: var(--primary-neon);">
                                @inv.Total.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @if (inv.MethodKey == "qr")
                                {
                                    <span class="badge bg-dark text-info border border-info bill-method" style="border-radius: 2px;">Chuyển khoản QR</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark text-warning border border-warning bill-method" style="border-radius: 2px;">Tiền mặt</span>
                                }
                            </td>
                            <td>@inv.Cashier</td>
                            <td class="text-center"><span class="badge bg-success text-dark" style="border-radius: 2px;">ĐÃ TT</span></td>
                            <td class="text-center pe-3">
                                <button class="btn btn-sm btn-outline-light p-1 px-2 btn-view-bill" title="In lại bill" style="border-radius: 2px !important;"><i class="bi bi-printer"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

