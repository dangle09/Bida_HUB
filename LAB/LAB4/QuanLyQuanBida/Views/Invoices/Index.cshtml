<!-- MODAL XEM TRƯỚC HÓA ĐƠN IN NHIỆT -->
<div class="modal fade" id="modalBillDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light" style="border-radius: 2px;">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-warning"></i> CHI TIẾT HÓA ĐƠN POS
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="pos-receipt-paper text-dark p-3">
                    <div class="text-center pb-2 border-bottom border-dark">
                        <div class="fw-bold fs-5 font-heading">BOLT BILLIARDS</div>
                        <div style="font-size: 0.75rem;">128 Nguyễn Ái Quốc, Biên Hòa, Đồng Nai</div>
                        <div style="font-size: 0.75rem;">Hotline: 0362.870.986</div>
                        <div class="fw-bold mt-2">HÓA ĐƠN THANH TOÁN</div>
                        <div style="font-size: 0.75rem;">Mã HĐ: HD261117-028 • Thu ngân: Mai</div>
                    </div>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span>Bàn: <strong>BÀN 08 (Pool 9FT)</strong></span>
                        <span>Khách: Nguyễn Hữu Thắng</span>
                    </div>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span>Giờ vào: 15:10</span>
                        <span>Giờ ra: 17:00 (1h 50p)</span>
                    </div>
                    <div class="py-2 border-bottom border-dark small">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Tiền giờ (110 phút x 1.000đ):</span>
                            <span>110.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>2 x Cà phê muối Đào Ngọc Giang:</span>
                            <span>56.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>1 x Khô bò lá chanh:</span>
                            <span>29.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-success">
                            <span>Ưu đãi Hội viên VIP Bạc (5%):</span>
                            <span>- 10.000 đ</span>
                        </div>
                    </div>
                    <div class="pt-2">
