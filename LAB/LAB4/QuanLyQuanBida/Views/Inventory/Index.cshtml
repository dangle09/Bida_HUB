                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng mặt hàng kho</p>
                    <div class="kpi-value text-white">24 <small class="fs-6 text-muted fw-normal">Mục</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
