                                <td class="ps-3"><strong class="text-light font-monospace">SKU-CF03</strong></td>
                                <td>
                                    <div class="thumb-category-wrap">
                                        <img src="~/images/shop/shop-1-co-fury.jpg" class="thumb-category-img" alt="Cơ Fury" />
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">Cơ Bida Fury One Series (Ngọn Mộc & Carbon)</div>
