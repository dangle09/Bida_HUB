<!-- MODAL TẠO PHIẾU NHẬP HÀNG -->
<div class="modal fade" id="modalNhapHang" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light" style="border-radius: 2px;">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-truck text-warning"></i> TẠO PHIẾU NHẬP KHO MỚI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Chọn Nhà cung cấp (*):</label>
                        <select class="form-select bg-black text-light border-secondary" style="border-radius: 2px;">
                            <option value="1">Công ty TNHH Nước giải khát Suntory PepsiCo</option>
                            <option value="2">Công ty TNHH Heineken Việt Nam</option>
                            <option value="3">Đại lý Phụ kiện Bida Fury & Aileex Chính Hãng</option>
                            <option value="4">Cơ sở cung cấp Thực phẩm & Bánh mì tươi Biên Hòa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Sản phẩm cần nhập:</label>
                        <select class="form-select bg-black text-light border-secondary" style="border-radius: 2px;">
                            <option value="rb">Nước tăng lực Redbull Thái (Đang thiếu)</option>
                            <option value="hn">Bia Heineken lon 330ml</option>
                            <option value="cf">Cơ bida Fury One Series</option>
                            <option value="lo">Lơ xanh Master USA</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Số lượng nhập:</label>
                            <input type="number" class="form-control bg-black text-light border-secondary" value="24" style="border-radius: 2px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Đơn giá nhập (VNĐ):</label>
                            <input type="number" class="form-control bg-black text-light border-secondary" value="15000" style="border-radius: 2px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Ghi chú phiếu nhập:</label>
                        <textarea class="form-control bg-black text-light border-secondary" rows="2" placeholder="Ghi chú số hóa đơn VAT, hạn sử dụng..." style="border-radius: 2px;"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px;">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="alert('Đã tạo phiếu nhập kho thành công! Hàng tồn kho đã được cập nhật.');" style="border-radius: 2px;">
                    <i class="bi bi-check-lg"></i> Xác nhận Nhập kho
                </button>
            </div>
        </div>
    </div>
</div>
