            </button>
            <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalNhapHang">
                <i class="bi bi-plus-circle-fill"></i> Tạo Phiếu Nhập Hàng
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ KPI KHO -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
