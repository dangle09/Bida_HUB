@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('inventorySearchInput');
            var statusFilter = document.getElementById('inventoryFilterStatus');
            var tableRows = document.querySelectorAll('#inventoryTable tbody tr');

            function filterInventory() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedStatus = (statusFilter.value || '').trim();

                tableRows.forEach(function (row) {
                    var status = row.getAttribute('data-status') || '';
                    var text = row.textContent.toLowerCase();

                    var matchesQuery = !query || text.includes(query);
                    var matchesStatus = !selectedStatus || status === selectedStatus;

                    if (matchesQuery && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterInventory);
            if (statusFilter) statusFilter.addEventListener('change', filterInventory);
        });
    </script>
}
