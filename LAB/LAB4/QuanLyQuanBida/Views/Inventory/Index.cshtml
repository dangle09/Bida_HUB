@* ===================================================================================
   WEB QUẢN LÝ (BIDA POS & ADMIN DASHBOARD) - QUẢN LÝ HÀNG HÓA: KHO & NHẬP HÀNG
   - Tên file: Views/Inventory/Index.cshtml
   - Vai trò: Quản lý hàng tồn kho thực tế, định mức cảnh báo và lịch sử phiếu nhập hàng
   - Layout: Views/Shared/_AdminLayout.cshtml
   - CSS: wwwroot/css/admin-pos.css (Chuẩn bo góc 2px radius toàn trang)
   =================================================================================== *@
@{
    ViewData["Title"] = "Kho & Nhập hàng - BOLT BILLIARDS";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Quản lý hàng hóa</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Kho & Nhập hàng</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-box-seam" style="color: #60a5fa;"></i>
                QUẢN LÝ KHO & LỊCH SỬ NHẬP HÀNG
            </h2>
            <div class="text-muted small">Kiểm soát tồn kho nguyên liệu F&B, cơ bida, dụng cụ phụ kiện và lập phiếu nhập</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" onclick="alert('Bắt đầu quy trình kiểm kê kho định kỳ.');">
