@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('customerSearchInput');
            var tierFilter = document.getElementById('customerTierFilter');
            var tableRows = document.querySelectorAll('#customersTable tbody tr');

            function filterCustomers() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedTier = (tierFilter.value || '').trim();

                tableRows.forEach(function (row) {
                    var tier = row.getAttribute('data-tier') || '';
                    var text = row.textContent.toLowerCase();

                    var matchesQuery = !query || text.includes(query);
                    var matchesTier = !selectedTier || tier === selectedTier;

                    if (matchesQuery && matchesTier) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterCustomers);
            if (tierFilter) tierFilter.addEventListener('change', filterCustomers);

            document.querySelectorAll('.btn-add-points').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var name = this.getAttribute('data-name');
                    var card = this.getAttribute('data-card');
                    var points = this.getAttribute('data-points');

                    document.getElementById('pointMemberName').textContent = name;
                    document.getElementById('pointMemberCard').textContent = card;
                    document.getElementById('pointMemberCurrent').textContent = points + ' Pts';

                    var modal = new bootstrap.Modal(document.getElementById('modalCongDiem'));
                    modal.show();
                });
            });
        });
    </script>
}
