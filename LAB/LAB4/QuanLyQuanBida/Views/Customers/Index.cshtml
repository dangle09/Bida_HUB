<!-- MODAL ĐĂNG KÝ HỘI VIÊN MỚI -->
<div class="modal fade" id="modalThemHoiVien" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light" style="border-radius: 2px;">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill text-warning"></i> ĐĂNG KÝ HỘI VIÊN BOLT CLUB
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Họ và tên cơ thủ (*):</label>
                        <input type="text" class="form-control bg-black text-light border-secondary" placeholder="Ví dụ: Nguyễn Văn A..." style="border-radius: 2px;" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Số điện thoại (*):</label>
                            <input type="tel" class="form-control bg-black text-light border-secondary" placeholder="0987xxxxxx" style="border-radius: 2px;" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Hạng thẻ ban đầu:</label>
                            <select class="form-select bg-black text-light border-secondary" style="border-radius: 2px;">
                                <option value="silver">VIP Bạc (Giảm 5%)</option>
                                <option value="gold">VIP Vàng (Giảm 10%)</option>
                                <option value="diamond">VIP Kim Cương (Giảm 15%)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Điểm thưởng tặng kèm kích hoạt:</label>
                        <input type="number" class="form-control bg-black text-light border-secondary" value="100" style="border-radius: 2px;" />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px;">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="alert('Đã kích hoạt thẻ hội viên mới thành công!');" style="border-radius: 2px;">
                    <i class="bi bi-check-lg"></i> Cấp Thẻ Hội Viên
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL NHẬN GỬI CƠ BIDA -->
<div class="modal fade" id="modalGuiCo" tabindex="-1" aria-hidden="true">
