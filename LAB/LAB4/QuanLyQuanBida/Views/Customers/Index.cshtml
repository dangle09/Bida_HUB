            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Chọn Tủ đồ cất giữ (*):</label>
                        <select class="form-select bg-black text-light border-secondary" style="border-radius: 2px;">
                            <option value="3">Tủ #03 (Trống)</option>
                            <option value="4">Tủ #04 (Trống)</option>
                            <option value="5">Tủ #05 (Trống)</option>
                            <option value="6">Tủ #06 (Trống)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Họ tên chủ gậy:</label>
                            <input type="text" class="form-control bg-black text-light border-secondary" placeholder="Tên khách hàng..." style="border-radius: 2px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Hãng cơ / Model:</label>
                            <input type="text" class="form-control bg-black text-light border-secondary" placeholder="Ví dụ: Fury One..." style="border-radius: 2px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Tình trạng trầy xước & phụ kiện đi kèm:</label>
                        <textarea class="form-control bg-black text-light border-secondary" rows="2" placeholder="Ví dụ: Cơ thẳng, có bịt ren, kèm bao da 2x2..." style="border-radius: 2px;"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px;">Đóng</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="alert('Đã tiếp nhận và khóa tủ đồ cơ bida thành công!');" style="border-radius: 2px;">
                    <i class="bi bi-key-fill"></i> Khóa Tủ & Bàn Giao Thẻ
                </button>
            </div>
        </div>
    </div>
</div>
