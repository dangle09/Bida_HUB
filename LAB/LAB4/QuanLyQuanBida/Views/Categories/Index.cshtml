@model IEnumerable<QuanLyQuanBida.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục Hàng hóa & Dịch vụ";
    Layout = "_Layout";
    var itemCounts = ViewBag.ItemCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container-fluid px-0">
    <!-- Breadcrumb chuẩn Wireframe -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Quản lý hàng hóa</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Danh mục món ăn & dụng cụ (Lab 4)</span>
    </div>

    <!-- Header của trang: Tiêu đề + Nút hành động nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-folder2-open" style="color: var(--primary-neon, #a6ff00);"></i>
                DANH MỤC MÓN ĂN & DỤNG CỤ BIDA
            </h2>
            <p class="text-secondary small mb-0">
                Thực hiện yêu cầu Lab 4: Quản lý danh mục hàng hóa, phân quyền <code>AdminOrManager</code> & <code>ManagementAccess</code>.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (isAdminOrManager)
            {
                <a asp-action="Create" class="btn btn-bolt-neon d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>+ Thêm Danh Mục Mới</span>
                </a>
            }
            else
            {
                <span class="badge bg-secondary p-2 d-flex align-items-center gap-1" style="border-radius: 2px !important;" title="Chỉ Admin và Manager mới có quyền thêm/sửa/xóa">
                    <i class="bi bi-lock-fill text-warning"></i> 👤 Chế độ Thu ngân (Chỉ xem)
                </span>
            }
        </div>
    </div>

    <!-- Thông báo kết quả thao tác -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-10 border-success text-success d-flex align-items-center gap-2 py-2 mb-3" role="alert" style="border-radius: 2px !important;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-10 border-danger text-danger d-flex align-items-center gap-2 py-2 mb-3" role="alert" style="border-radius: 2px !important;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bảng dữ liệu danh mục chuẩn POS Dashboard -->
    <div class="card bg-dark border-secondary border-opacity-50 shadow-sm overflow-hidden" style="border-radius: 2px !important; background-color: var(--bg-card, #0e131d) !important;">
        <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-light small text-uppercase font-heading">
                <i class="bi bi-list-ul me-1" style="color: var(--primary-neon);"></i> Danh sách danh mục hiện có (@Model.Count() nhóm)
            </span>
            <div class="badge bg-black border border-secondary text-secondary small" style="border-radius: 2px !important;">
                Quyền: <span class="text-success">Admin & Quản lý (Toàn quyền)</span> | <span class="text-info">Thu ngân (Chỉ xem)</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
                <thead class="table-dark text-secondary small text-uppercase border-secondary" style="border-bottom: 1px solid var(--border-color, #1a2233);">
                    <tr>
                        <th style="width: 70px;" class="text-center">#ID</th>
                        <th style="width: 90px;" class="text-center">Ảnh</th>
                        <th style="width: 170px;">Mã Code</th>
                        <th>Tên Danh Mục Nhóm Hàng</th>
                        <th style="width: 180px;" class="text-center">Số lượng món/vật phẩm</th>
                        <th style="width: 240px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            int count = itemCounts.ContainsKey(item.Id) ? itemCounts[item.Id] : 0;
                            <tr>
                                <td class="text-center text-muted fw-bold">#@item.Id</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="~/@item.Image" alt="@item.Name" style="width: 44px; height: 44px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(166, 255, 0, 0.35);" />
                                    }
                                    else
                                    {
                                        <div style="width: 44px; height: 44px; background: #161c2b; border: 1px solid #232c42; border-radius: 2px; display: inline-flex; align-items: center; justify-content: center; color: #55657e;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-black border border-secondary text-info font-monospace px-2 py-1" style="border-radius: 2px !important;">@item.Code</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-white fs-6">@item.Name</div>
                                    <div class="text-secondary small">Đồng bộ menu trang khách vãng lai</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-black border border-secondary text-light px-2 py-1" style="border-radius: 2px !important;">
                                        <i class="bi bi-box-seam text-warning me-1"></i>@count sản phẩm
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Xem chi tiết (Tất cả vai trò đều được) -->
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" style="border-radius: 2px !important;" title="Xem chi tiết danh mục">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>

                                        @if (isAdminOrManager)
                                        {
                                            <!-- Sửa (Admin & Manager) -->
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" style="border-radius: 2px !important;" title="Chỉnh sửa danh mục & ảnh">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <!-- Xóa (Admin & Manager) -->
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" style="border-radius: 2px !important;" title="Xóa danh mục">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- Khi là Cashier, nút bị khóa để hướng dẫn quyền -->
                                            <button type="button" class="btn btn-outline-secondary opacity-50" style="border-radius: 2px !important;" disabled title="Thu ngân không có quyền Sửa">
                                                <i class="bi bi-lock"></i> Sửa
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary opacity-50" style="border-radius: 2px !important;" disabled title="Thu ngân không có quyền Xóa">
                                                <i class="bi bi-lock"></i> Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào. Hãy bấm thêm mới!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
