@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Chỉnh sửa Danh mục - BOLT BILLIARDS";
    Layout = "_Layout";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb chuẩn Wireframe -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-action="Index" class="text-secondary text-decoration-none">Quản lý hàng hóa</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-action="Index" class="text-secondary text-decoration-none">Danh mục món ăn & dụng cụ</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Chỉnh sửa (#@Model.Id)</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark text-white border-secondary border-opacity-50 shadow-lg overflow-hidden" style="border-radius: 2px !important; background-color: var(--bg-card, #0e131d) !important;">
                <div class="card-header bg-black bg-opacity-40 py-3 border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2 font-heading">
                        <i class="bi bi-pencil-square text-warning"></i>
                        CHỈNH SỬA DANH MỤC & ẢNH ĐẠI DIỆN
                    </h5>
                    <span class="badge bg-black border border-secondary text-warning small" style="border-radius: 2px !important;">Quyền: AdminOrManager</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="ExistingImage" value="@Model.Image" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3">
                            <!-- ID -->
                            <div class="col-md-4">
                                <label class="form-label text-secondary small">Mã định danh ID</label>
                                <input class="form-control bg-black text-muted border-secondary" style="border-radius: 2px !important;" value="@Model.Id" readonly disabled />
                            </div>

                            <!-- Mã Code -->
                            <div class="col-md-8">
                                <label asp-for="Code" class="form-label text-light small fw-semibold">Mã danh mục (Code) <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control bg-dark text-white border-secondary font-monospace" style="border-radius: 2px !important;" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <!-- Tên Danh Mục -->
                            <div class="col-12">
                                <label asp-for="Name" class="form-label text-light small fw-semibold">Tên danh mục (Name) <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control bg-dark text-white border-secondary" style="border-radius: 2px !important;" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Thay đổi ảnh đại diện -->
                            <div class="col-12">
                                <label class="form-label text-light small fw-semibold">Ảnh đại diện danh mục / sản phẩm</label>
                                <div class="row align-items-center g-3">
                                    <div class="col-md-8">
                                        <input type="file" name="ImageFile" id="editImageFileInput" accept="image/*" class="form-control bg-dark text-white border-secondary" style="border-radius: 2px !important;" onchange="previewEditImage(this);" />
                                        <div class="form-text text-secondary" style="font-size: 0.75rem;">
                                            Tải ảnh mới để thay thế ảnh hiện tại (hoặc để trống nếu muốn giữ nguyên).
                                        </div>
                                        <div class="mt-2">
                                            <input asp-for="Image" class="form-control bg-dark text-white border-secondary form-control-sm" style="border-radius: 2px !important;" placeholder="Đường dẫn ảnh hiện tại: images/categories/..." />
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="p-2 border border-secondary border-opacity-50 bg-black text-center" style="border-radius: 2px !important; min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                            @if (!string.IsNullOrEmpty(Model.Image))
                                            {
                                                <img id="editImagePreview" src="~/@Model.Image" alt="@Model.Name" style="max-height: 100px; max-width: 100%; object-fit: contain; border-radius: 2px;" />
                                                <div id="editImageLabel" class="text-secondary small mt-1" style="font-size: 0.7rem;">Ảnh đang dùng</div>
                                            }
                                            else
                                            {
                                                <img id="editImagePreview" src="~/images/bolt-billiards-logo.png" alt="Preview ảnh" style="max-height: 100px; max-width: 100%; object-fit: contain; border-radius: 2px; display: none;" />
                                                <div id="editImageLabel" class="text-muted small">
                                                    <i class="bi bi-image fs-3 d-block mb-1"></i>
                                                    Chưa có ảnh
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Các nút bấm -->
                        <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top border-secondary border-opacity-25">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius: 2px !important;">
                                <i class="bi bi-x-circle me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark" style="border-radius: 2px !important;">
                                <i class="bi bi-check-lg me-1"></i> Cập Nhật Danh Mục
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewEditImage(input) {
            var preview = document.getElementById('editImagePreview');
            var label = document.getElementById('editImageLabel');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (label) label.textContent = 'Ảnh mới chọn';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
