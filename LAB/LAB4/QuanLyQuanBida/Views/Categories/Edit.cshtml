@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Chỉnh sửa Danh mục - BOLT BILLIARDS";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-dark text-white border-secondary border-opacity-50 rounded-4 shadow-lg overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-warning"></i>
                        Chỉnh Sửa Danh Mục
                    </h5>
                    <span class="badge bg-warning text-dark fw-bold">ManagerOnly</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- ID -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Mã định danh ID</label>
                            <input class="form-control bg-black text-muted border-secondary" value="@Model.Id" readonly disabled />
                        </div>

                        <!-- Mã Code -->
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label text-light small fw-semibold">Mã danh mục (Code)</label>
                            <input asp-for="Code" class="form-control bg-dark text-white border-secondary" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <!-- Tên Danh Mục -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label text-light small fw-semibold">Tên danh mục (Name)</label>
                            <input asp-for="Name" class="form-control bg-dark text-white border-secondary" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Các nút bấm -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                                <i class="bi bi-x-circle me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark">
                                <i class="bi bi-check-lg me-1"></i> Cập Nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
