@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Chi tiết Danh mục - " + Model.Name;
    Layout = "_Layout";
    var items = ViewBag.Items as List<QuanLyQuanBida.Models.ServiceItem> ?? new List<QuanLyQuanBida.Models.ServiceItem>();
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container-fluid px-0">
    <!-- Breadcrumb chuẩn Wireframe -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-action="Index" class="text-secondary text-decoration-none">Quản lý hàng hóa</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-action="Index" class="text-secondary text-decoration-none">Danh mục món ăn & dụng cụ</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Chi tiết (#@Model.Id)</span>
    </div>

    <!-- Thông tin Danh mục -->
    <div class="card bg-dark text-white border-secondary border-opacity-50 shadow-lg mb-4 overflow-hidden" style="border-radius: 2px !important; background-color: var(--bg-card, #0e131d) !important;">
        <div class="card-header bg-black bg-opacity-40 py-3 border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-info-circle text-info"></i>
                THÔNG TIN CHI TIẾT DANH MỤC
            </h5>
            <span class="badge bg-black border border-secondary text-info small" style="border-radius: 2px !important;">Quyền: ManagementAccess</span>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-2 text-center">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/@Model.Image" alt="@Model.Name" style="width: 80px; height: 80px; object-fit: cover; border-radius: 2px; border: 2px solid rgba(166, 255, 0, 0.4);" />
                    }
                    else
                    {
                        <div style="width: 80px; height: 80px; background: #161c2b; border: 1px solid #232c42; border-radius: 2px; display: inline-flex; align-items: center; justify-content: center; color: #55657e; font-size: 2rem;">
                            <i class="bi bi-image"></i>
                        </div>
                    }
                </div>
                <div class="col-md-2">
                    <div class="p-3 bg-black bg-opacity-30 border border-secondary border-opacity-25 text-center" style="border-radius: 2px !important;">
                        <div class="text-secondary small">Mã định danh</div>
                        <div class="fs-4 fw-bold text-white">#@Model.Id</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black bg-opacity-30 border border-secondary border-opacity-25" style="border-radius: 2px !important;">
                        <div class="text-secondary small">Mã phân loại (Code)</div>
                        <div class="fs-5 fw-bold text-info font-monospace">@Model.Code</div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="p-3 bg-black bg-opacity-30 border border-secondary border-opacity-25" style="border-radius: 2px !important;">
                        <div class="text-secondary small">Tên danh mục</div>
                        <div class="fs-5 fw-bold text-success font-heading">@Model.Name</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 2px !important;">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
                @if (isAdminOrManager)
                {
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-bold" style="border-radius: 2px !important;">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger" style="border-radius: 2px !important;">
                            <i class="bi bi-trash me-1"></i> Xóa
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bảng danh sách các món đồ uống / dụng cụ bida thuộc danh mục này -->
    <div class="card bg-dark border-secondary border-opacity-50 shadow-sm overflow-hidden" style="border-radius: 2px !important; background-color: var(--bg-card, #0e131d) !important;">
        <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-light small text-uppercase font-heading">
                <i class="bi bi-cup-hot me-1 text-warning"></i> Các món / Sản phẩm thuộc danh mục (@items.Count sản phẩm)
            </span>
            <span class="badge bg-black border border-secondary text-secondary small" style="border-radius: 2px !important;">Đồng bộ 100% Web Khách</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
                <thead class="table-dark text-secondary small text-uppercase border-secondary">
                    <tr>
                        <th style="width: 70px;" class="text-center">Ảnh</th>
                        <th style="width: 120px;">Mã Sản Phẩm</th>
                        <th>Tên Món Ăn / Dụng Cụ</th>
                        <th style="width: 120px;" class="text-center">Đơn vị</th>
                        <th style="width: 160px;" class="text-end">Đơn giá bán</th>
                        <th style="width: 140px;" class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        foreach (var item in items)
                        {
                            <tr>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="~/@item.Image" alt="@item.Name" style="width: 42px; height: 42px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(166, 255, 0, 0.3);" />
                                    }
                                    else
                                    {
                                        <div style="width: 42px; height: 42px; background: #161c2b; border: 1px solid #232c42; border-radius: 2px; display: inline-flex; align-items: center; justify-content: center; color: #55657e;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td><span class="badge bg-black border border-secondary text-info font-monospace" style="border-radius: 2px !important;">@item.Code</span></td>
                                <td class="fw-bold text-white">@item.Name</td>
                                <td class="text-center text-secondary small">@item.Unit</td>
                                <td class="text-end fw-bold text-success font-heading">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25" style="border-radius: 2px !important;">
                                            <i class="bi bi-check-circle me-1"></i> Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="border-radius: 2px !important;">Tạm dừng</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có sản phẩm nào thuộc danh mục này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
