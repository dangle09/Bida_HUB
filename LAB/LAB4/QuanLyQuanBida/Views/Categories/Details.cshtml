@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Chi tiết Danh mục - " + Model.Name;
    Layout = "_Layout";
    var items = ViewBag.Items as List<QuanLyQuanBida.Models.ServiceItem> ?? new List<QuanLyQuanBida.Models.ServiceItem>();
    bool isManager = User.IsInRole("Manager") || User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Card Chi tiết Danh mục -->
            <div class="card bg-dark text-white border-secondary border-opacity-50 rounded-4 shadow-lg mb-4 overflow-hidden">
                <div class="card-header bg-black bg-opacity-40 py-3 border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-info"></i>
                        Thông Tin Chi Tiết Danh Mục
                    </h5>
                    <span class="badge bg-info text-dark">EmployeeOrManager</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="p-3 bg-black bg-opacity-30 rounded-3 border border-secondary border-opacity-25 text-center">
                                <div class="text-secondary small">Mã định danh ID</div>
                                <div class="fs-4 fw-bold text-white">#@Model.Id</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-black bg-opacity-30 rounded-3 border border-secondary border-opacity-25">
                                <div class="text-secondary small">Mã Code phân loại</div>
                                <div class="fs-5 fw-bold text-info font-monospace">@Model.Code</div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="p-3 bg-black bg-opacity-30 rounded-3 border border-secondary border-opacity-25">
                                <div class="text-secondary small">Tên danh mục</div>
                                <div class="fs-5 fw-bold text-success">@Model.Name</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        @if (isManager)
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-bold">
                                    <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                    <i class="bi bi-trash me-1"></i> Xóa
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Bảng danh sách các món đồ uống / dịch vụ thuộc danh mục này -->
            <div class="card bg-dark border-secondary border-opacity-50 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-black bg-opacity-30 border-secondary border-opacity-25 py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-light small text-uppercase">
                        <i class="bi bi-cup-hot me-1 text-warning"></i> Các món thuộc danh mục này (@items.Count món)
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-dark text-secondary small text-uppercase border-secondary">
                            <tr>
                                <th style="width: 100px;">Mã Món</th>
                                <th>Tên Món / Dịch Vụ</th>
                                <th style="width: 120px;" class="text-center">Đơn vị</th>
                                <th style="width: 160px;" class="text-end">Đơn giá bán</th>
                                <th style="width: 140px;" class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items.Any())
                            {
                                foreach (var item in items)
                                {
                                    <tr>
                                        <td><span class="badge bg-dark border border-secondary text-info font-monospace">@item.Code</span></td>
                                        <td class="fw-bold text-white">@item.Name</td>
                                        <td class="text-center text-muted">@item.Unit</td>
                                        <td class="text-end fw-bold text-success">@item.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Đang bán</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Tạm dừng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Chưa có món ăn/đồ uống nào trong danh mục này.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
