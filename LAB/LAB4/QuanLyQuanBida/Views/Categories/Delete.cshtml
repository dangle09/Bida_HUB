@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = "Xác nhận xóa Danh mục - BOLT BILLIARDS";
    Layout = "_Layout";
    int itemCount = ViewBag.ItemCount ?? 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-dark text-white border-danger border-opacity-50 rounded-4 shadow-lg overflow-hidden">
                <div class="card-header bg-danger bg-opacity-10 py-3 border-danger border-opacity-25 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-danger d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Xác Nhận Xóa Danh Mục
                    </h5>
                    <span class="badge bg-danger">ManagerOnly</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        Bạn có chắc chắn muốn xóa danh mục này khỏi cơ sở dữ liệu hệ thống không?
                    </p>

                    <div class="bg-black bg-opacity-40 p-3 rounded-3 mb-4 border border-secondary border-opacity-25">
                        <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted small">Mã ID:</span>
                            <span class="fw-bold text-white">#@Model.Id</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted small">Mã Code:</span>
                            <span class="fw-bold text-info font-monospace">@Model.Code</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted small">Tên Danh Mục:</span>
                            <span class="fw-bold text-warning">@Model.Name</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted small">Số món liên kết:</span>
                            <span class="badge @(itemCount > 0 ? "bg-danger" : "bg-success")">@itemCount món</span>
                        </div>
                    </div>

                    @if (itemCount > 0)
                    {
                        <div class="alert alert-warning py-2 small mb-4" role="alert">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            <strong>Cảnh báo an toàn:</strong> Danh mục này đang chứa <strong>@itemCount</strong> món dịch vụ. Hệ thống sẽ chặn xóa để bảo toàn tính toàn vẹn dữ liệu.
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold" @(itemCount > 0 ? "disabled" : "")>
                                <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
