                <div class="row hero-stats-row g-3">
                    <div class="col-3 stat-box">
                        <div class="stat-number">24+</div>
                        <div class="stat-label">Bàn Thi Đấu</div>
                    </div>
                    <div class="col-3 stat-box">
                        <div class="stat-number">100%</div>
                        <div class="stat-label">Vải Nỉ Simonis</div>
                    </div>
                    <div class="col-3 stat-box">
                        <div class="stat-number">24/7</div>
                        <div class="stat-label">Mở Xuyên Đêm</div>
                    </div>
                    <div class="col-3 stat-box">
                        <div class="stat-number">15Tr</div>
                        <div class="stat-label">Giải Thưởng</div>
                    </div>
                </div>
            </div>

            <!-- Hình ảnh Logo Bolt Billiards -->
