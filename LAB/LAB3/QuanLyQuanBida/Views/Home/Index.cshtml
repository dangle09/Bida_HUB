                    <a href="#booking" class="btn btn-bolt-neon">
                        <i class="bi bi-calendar-check"></i> ĐẶT BÀN NGAY
                    </a>
                    <a href="#pricing" class="btn btn-bolt-outline">
                        <i class="bi bi-tag"></i> XEM BẢNG GIÁ
                    </a>
                </div>

