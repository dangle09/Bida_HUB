                    </div>
                    <div class="mb-3">
                        <label class="form-label-bolt">Số điện thoại liên hệ *</label>
                        <input type="tel" class="form-control form-control-bolt" id="tourPlayerPhone" placeholder="Ví dụ: 0987654321" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-bolt">Hạng cơ thủ dự kiến *</label>
                        <select class="form-select form-select-bolt" id="tourPlayerRank">
                            <option value="Hạng E (Cơ thủ tốt - Chạm 6)">Hạng E (Phong trào tốt - Chạm 6)</option>
                            <option value="Hạng F (Phong trào vừa - Chạm 5)">Hạng F (Phong trào vừa - Chạm 5)</option>
                            <option value="Hạng G (Mới giao lưu - Chạm 4)">Hạng G (Giao lưu phong trào - Chạm 4)</option>
                            <option value="Hạng Mở Rộng Open (Chạm 7)">Hạng Mở Rộng Open (Chạm 7)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-bolt">CLB hoặc Đội sinh hoạt (Nếu có)</label>
                        <input type="text" class="form-control form-control-bolt" id="tourPlayerClub" placeholder="Ví dụ: Tự do hoặc CLB Biên Hòa" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label-bolt">Ghi chú thêm</label>
                        <textarea class="form-control form-control-bolt" id="tourPlayerNote" rows="2" placeholder="Ghi chú về lịch thi đấu nếu cần..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-bolt-neon w-100 py-2">
                        <i class="bi bi-check2 me-1"></i> XÁC NHẬN GỬI ĐĂNG KÝ THI ĐẤU
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set ngày mặc định là hôm nay
        document.getElementById('bookDate').valueAsDate = new Date();

        // Xử lý mũi tên trượt qua lại giữa các sản phẩm (Ảnh 1)
        function getActiveSlider() {
            if ($('#fnb').hasClass('show') || $('#fnb').hasClass('active')) {
                return document.getElementById('fnbSlider');
            }
            return document.getElementById('shopSlider');
        }

        $('#slidePrevBtn').click(function () {
            const slider = getActiveSlider();
            if (slider) {
                slider.scrollBy({ left: -280, behavior: 'smooth' });
            }
        });

        $('#slideNextBtn').click(function () {
            const slider = getActiveSlider();
            if (slider) {
                slider.scrollBy({ left: 280, behavior: 'smooth' });
            }
        });

        // Xử lý gửi Form Đặt Bàn (Ảnh 3)
        $('#onlineBookingForm').submit(function (e) {
            e.preventDefault();
            const name = $('#bookName').val();
            const phone = $('#bookPhone').val();
            const table = $('#bookTableType').val();
            const time = $('#bookTime').val();

            alert(`🎉 ĐẶT BÀN THÀNH CÔNG!\n\nCảm ơn bạn ${name} (${phone})!\nBOLT BILLIARDS Đồng Nai đã nhận yêu cầu đặt [${table}] lúc ${time}.\nNhân viên thu ngân sẽ gọi lại để xác nhận số bàn trống cho bạn ngay ạ!`);
            this.reset();
            document.getElementById('bookDate').valueAsDate = new Date();
        });

        // Xử lý gửi Form Đăng Ký Giải Đấu (Ảnh 2)
        $('#tournamentRegisterForm').submit(function (e) {
            e.preventDefault();
            const name = $('#tourPlayerName').val();
            const phone = $('#tourPlayerPhone').val();
            const rank = $('#tourPlayerRank').val();

            // Đóng Modal
            const modalEl = document.getElementById('tournamentModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            alert(`🏆 ĐĂNG KÝ GIẢI THÀNH CÔNG!\n\nChào mừng cơ thủ: ${name} (${phone})\nHạng đăng ký: ${rank}\nBan tổ chức giải BOLT OPEN CHAMPIONSHIP sẽ liên hệ xếp lịch thi đấu cho bạn trước ngày 24 hàng tháng nhé!`);
            this.reset();
        });
    </script>
}
