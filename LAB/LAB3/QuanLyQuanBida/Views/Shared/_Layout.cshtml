<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BOLT BILLIARDS ADMIN</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- CSS Tùy biến Xám + Xanh Lá Neon Bida -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bida-body">
    <!-- 1. TOPBAR CỐ ĐỊNH Ở TRÊN -->
    <header class="bida-topbar d-flex align-items-center justify-content-between px-3">
        <!-- Logo & Thương hiệu -->
        <div class="d-flex align-items-center gap-2">
            <a class="bida-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                <img src="~/images/bolt-billiards-logo.png" alt="Bolt" style="height: 36px; object-fit: contain;" />
                <span class="fw-bold fs-5 text-white"><span style="color: var(--primary-green);">BOLT</span> POS</span>
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2 text-light" style="font-size: 0.75rem;" title="Xem trang chủ khách hàng">
                <i class="bi bi-box-arrow-up-right me-1"></i> Trang Khách Hàng
            </a>
            <span class="badge bg-dark border border-secondary text-info ms-2 d-none d-lg-inline-block">
                <i class="bi bi-geo-alt"></i> Chi nhánh Đồng Nai
            </span>
        </div>

        <!-- Trạng thái quán thời gian thực -->
        <div class="d-none d-md-flex align-items-center gap-4">
            <div class="status-pill">
                <span class="indicator bg-success"></span>
                <span class="text-light">Bàn đang chơi: <strong style="color: #f59e0b;">14/24</strong></span>
            </div>
            <div class="status-pill">
                <i class="bi bi-clock text-info me-1"></i>
                <span id="liveClock" class="fw-semibold text-light">12:00:00</span>
            </div>
        </div>

        <!-- Avatar & Tên tài khoản / Đăng xuất -->
        <div class="d-flex align-items-center gap-3">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn btn-dark dropdown-toggle d-flex align-items-center gap-2 border-secondary" type="button" data-bs-toggle="dropdown">
                        <div class="avatar-circle">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                        <div class="text-start d-none d-sm-block">
                            <div class="fw-semibold small text-white">@User.Identity.Name</div>
                            <div class="text-success" style="font-size: 0.75rem;">
                                @(User.IsInRole("Admin") ? "Quản trị viên" : (User.IsInRole("Manager") ? "Quản lý ca" : "Nhân viên thu ngân"))
                            </div>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Thông tin cá nhân</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="px-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm w-100 text-start">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="#booking" class="btn btn-sm btn-success px-3">
                    <i class="bi bi-calendar-check me-1"></i> Đặt bàn trước
                </a>
            }
        </div>
    </header>

    <!-- 2. VÙNG THÂN GỒM SIDEBAR VÀ VÙNG NỘI DUNG -->
    <div class="bida-wrapper">
        <!-- SIDEBAR BÊN TRÁI -->
        <aside class="bida-sidebar">
            <ul class="nav flex-column sidebar-nav py-3">
                <li class="sidebar-header">VẬN HÀNH & BÁN HÀNG</li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <span>Trang chủ khách</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#services">
                        <i class="bi bi-tags"></i>
                        <span>Dịch vụ & Thực đơn</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Sơ đồ bàn (POS)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-receipt"></i>
                        <span>Hóa đơn & Thu ngân</span>
                    </a>
                </li>

                <!-- MENU DÀNH CHO QUẢN LÝ & ADMIN -->
                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <li class="sidebar-header mt-3">QUẢN LÝ NÂNG CAO</li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-boxes"></i>
                            <span>Kho hàng & Nhập kho</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Báo cáo doanh thu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-people"></i>
                            <span>Nhân sự & Phân ca</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-trophy"></i>
                            <span>Giải đấu & Sự kiện</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- VÙNG NỘI DUNG CHÍNH (RENDER BODY) -->
        <main class="bida-content p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateClock() {
            const now = new Date();
            const el = document.getElementById('liveClock');
            if (el) el.innerText = now.toLocaleTimeString('vi-VN');
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
