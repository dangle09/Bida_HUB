<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BOLT BILLIARDS</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Customer CSS Tối giản & Hiện đại -->
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="customer-body" data-bs-spy="scroll" data-bs-target="#boltNav" data-bs-offset="80">

    <!-- 1. HEADER / NAVIGATION BAR (NẰM NGANG 1 HÀNG KHÔNG XUỐNG DÒNG) -->
    <nav class="navbar navbar-expand-xl bolt-navbar sticky-top" id="boltNav">
        <div class="container-fluid px-lg-4">
            <!-- Brand Logo -->
            <a class="bolt-brand" href="#home">
                <img src="~/images/bolt-billiards-logo.png" alt="Bolt Billiards Logo" class="bolt-logo-img" />
                <div>
                    <span class="bolt-brand-text"><span class="neon">BOLT</span> BILLIARDS</span>
                    <span class="bolt-brand-sub">PREMIUM POOL CLUB • ĐỒNG NAI</span>
                </div>
            </a>

            <!-- Mobile Hamburger Toggle -->
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <i class="bi bi-list fs-2" style="color: var(--bolt-neon);"></i>
            </button>

            <!-- Nav Links: Nằm ngang 1 hàng không bị rớt dòng -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-xl-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#pricing">Bảng giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#services">Dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#tournaments">Giải đấu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#booking">Đặt bàn</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Liên hệ</a>
                    </li>
                </ul>

                <!-- Action Buttons: Đặt bàn & Đăng nhập nội bộ -->
                <div class="d-flex align-items-center gap-2 flex-nowrap">
                    <a href="#booking" class="btn btn-bolt-neon-sm">
                        <i class="bi bi-calendar-check"></i> Đặt bàn
                    </a>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-bolt-outline-sm" title="Vào trang Quản lý">
                            <i class="bi bi-speedometer2"></i> Quản lý
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Login" asp-action="Login" class="btn btn-bolt-outline-sm" title="Đăng nhập dành cho nhân viên">
                            <i class="bi bi-shield-lock"></i> Nội bộ
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- 2. MAIN CONTENT (BODY RENDER) -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 3. FOOTER -->
    <footer class="bolt-footer" id="contact">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Cột 1: Thông tin thương hiệu -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/bolt-billiards-logo.png" alt="Bolt Billiards" style="height: 38px;" />
                        <span class="footer-brand-title"><span style="color: var(--bolt-neon);">BOLT</span> BILLIARDS</span>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        Câu lạc bộ Bida phong cách hiện đại với dàn bàn thi đấu Aileex tiêu chuẩn quốc tế, bi Aramith Pro Cup, phòng máy lạnh 100% cùng menu ẩm thực phong phú phục vụ 24/7 tại Đồng Nai.
                    </p>
                    <div class="mt-3">
                        <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Đường dẫn nhanh -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Khám Phá</h6>
                    <ul class="footer-link-list small">
                        <li><a href="#home">Trang chủ</a></li>
                        <li><a href="#about">Về câu lạc bộ</a></li>
                        <li><a href="#pricing">Bảng giá bàn</a></li>
                        <li><a href="#services">Dịch vụ</a></li>
                        <li><a href="#tournaments">Giải đấu</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Dịch vụ & Hỗ trợ -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Dịch Vụ</h6>
                    <ul class="footer-link-list small">
                        <li><a href="#booking">Đặt bàn trước</a></li>
                        <li><a href="#services">Gậy & Phụ kiện</a></li>
                        <li><a href="#about">Phòng VIP riêng</a></li>
                        <li><a href="#tournaments">Đăng ký giải</a></li>
                        <li><a asp-controller="Login" asp-action="Login">Cổng quản lý</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Liên hệ trực tiếp tại Đồng Nai -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2 d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt" style="color: var(--bolt-neon);"></i>
                            <span>Số 168 Đường Đồng Khởi, Phường Tân Hiệp, TP. Biên Hòa, Tỉnh Đồng Nai</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-telephone" style="color: var(--bolt-neon);"></i>
                            <strong class="text-white">Hotline Đặt Bàn: 0987.654.321</strong>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-clock" style="color: var(--bolt-neon);"></i>
                            <span>Giờ mở cửa: <strong class="text-white">24/7 (Phục vụ xuyên đêm)</strong></span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-envelope" style="color: var(--bolt-neon);"></i>
                            <span>contact@boltbilliards.vn</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr style="border-color: var(--bolt-border);" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-2 small text-secondary">
                <div>&copy; 2026 <strong>BOLT BILLIARDS CLUB</strong> • Chi nhánh Đồng Nai.</div>
                <div class="mt-2 mt-md-0">
                    <span class="fw-bold text-uppercase" style="color: var(--bolt-neon); letter-spacing: 0.8px;"><i class="bi bi-patch-check-fill me-1"></i> Đẳng cấp số 1 Việt Nam</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- 4. FLOATING HOTLINE (Góc trái dưới) -->
    <a href="tel:0987654321" class="floating-hotline" title="Gọi Hotline đặt bàn ngay!">
        <div class="hotline-circle">
            <i class="bi bi-telephone"></i>
        </div>
        <div class="hotline-label d-none d-md-block">
            <small style="color: var(--bolt-neon); font-size: 0.7rem;">HOTLINE 24/7</small><br />
            <span>0987.654.321</span>
        </div>
    </a>

    <!-- 5. FLOATING LIVE CHAT 24/7 WIDGET (Góc phải dưới) -->
    <div class="floating-chat">
        <!-- Nút tròn bật Chat -->
        <button class="chat-toggle-btn" id="chatToggleBtn" title="Hỗ trợ & Đặt bàn 24/7">
            <i class="bi bi-chat-text" id="chatIcon"></i>
        </button>

        <!-- Khung cửa sổ Chat -->
        <div class="chat-popup" id="chatPopup">
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    <div style="position: relative;">
                        <img src="~/images/bolt-billiards-logo.png" alt="AI Bolt" style="height: 28px; width: 28px; border-radius: 50%; background: #000; padding: 2px;" />
                        <span style="position: absolute; bottom: 0; right: 0; width: 7px; height: 7px; background: #10b981; border-radius: 50%;"></span>
                    </div>
                    <div>
                        <div class="text-white fw-bold small">Trợ Lý BOLT AI</div>
                        <div style="font-size: 0.68rem; color: var(--bolt-neon);">Trực tuyến 24/7 • Đồng Nai</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white btn-sm" id="chatCloseBtn"></button>
            </div>

            <!-- Nội dung tin nhắn -->
            <div class="chat-body" id="chatBody">
                <div class="chat-msg bot">
                    👋 Chào bạn! Cảm ơn bạn đã ghé thăm <strong>BOLT BILLIARDS Đồng Nai</strong>. Bạn cần kiểm tra bàn trống, hỏi bảng giá hay đặt bàn trước không ạ?
                </div>
                <div class="chat-msg bot">
                    💡 Câu hỏi nhanh:
                    <div class="mt-2 d-flex flex-wrap gap-1">
                        <button class="btn btn-sm btn-dark text-start py-1 px-2 border-secondary quick-ask" data-q="Giá bàn Pool 9-Ball bao nhiêu?">🎱 Giá bàn Pool?</button>
                        <button class="btn btn-sm btn-dark text-start py-1 px-2 border-secondary quick-ask" data-q="Quán có mở xuyên đêm không?">🕒 Giờ mở cửa?</button>
                        <button class="btn btn-sm btn-dark text-start py-1 px-2 border-secondary quick-ask" data-q="Tôi muốn đặt bàn tối nay lúc 20h.">📅 Đặt bàn tối nay</button>
                    </div>
                </div>
            </div>

            <!-- Khung nhập tin nhắn -->
            <div class="chat-footer">
                <input type="text" id="chatInput" class="form-control form-control-sm form-control-bolt" placeholder="Nhập câu hỏi..." />
                <button class="btn btn-bolt-neon btn-sm px-3" id="chatSendBtn">
                    <i class="bi bi-send"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function () {
            $('#chatToggleBtn').click(function () {
                $('#chatPopup').toggleClass('active');
                if ($('#chatPopup').hasClass('active')) {
                    $('#chatIcon').removeClass('bi-chat-text').addClass('bi-x-lg');
                    $('#chatInput').focus();
                } else {
                    $('#chatIcon').removeClass('bi-x-lg').addClass('bi-chat-text');
                }
            });

            $('#chatCloseBtn').click(function () {
                $('#chatPopup').removeClass('active');
                $('#chatIcon').removeClass('bi-x-lg').addClass('bi-chat-text');
            });

            $('.quick-ask').click(function () {
                const text = $(this).data('q');
                sendMessage(text);
            });

            $('#chatSendBtn').click(function () {
                const text = $('#chatInput').val().trim();
                if (text) {
                    sendMessage(text);
                    $('#chatInput').val('');
                }
            });

            $('#chatInput').keypress(function (e) {
                if (e.which === 13) {
                    $('#chatSendBtn').click();
                }
            });

            function sendMessage(text) {
                $('#chatBody').append(`<div class="chat-msg user">${text}</div>`);
                scrollChat();

                setTimeout(function () {
                    let reply = "Dạ BOLT BILLIARDS Đồng Nai đã nhận câu hỏi! Nhân viên sẽ hỗ trợ bạn ngay hoặc gọi Hotline <strong>0987.654.321</strong> để giữ bàn tức thì nhé!";
                    const lower = text.toLowerCase();
                    if (lower.includes("giá") || lower.includes("bao nhiêu") || lower.includes("tiền")) {
                        reply = "🎱 Bảng giá giờ chơi tại BOLT BILLIARDS:<br>• <strong>Bàn Pool 9-Ball:</strong> 59k/h (ngày) - 69k/h (tối)<br>• <strong>Bàn Carom (Libre/3C):</strong> 65k/h (ngày) - 75k/h (tối)<br>• <strong>Phòng VIP:</strong> 119k/h.<br>Đã bao gồm khăn lạnh và trà đá miễn phí ạ!";
                    } else if (lower.includes("giờ") || lower.includes("mở cửa") || lower.includes("xuyên đêm") || lower.includes("đêm")) {
                        reply = "🕒 BOLT BILLIARDS <strong>mở cửa 24/7 xuyên đêm tất cả các ngày</strong> trong tuần tại Đồng Nai ạ!";
                    } else if (lower.includes("đặt bàn") || lower.includes("bàn tối")) {
                        reply = "📅 Dạ bạn có thể lướt xuống mục <strong>[Đặt bàn]</strong> trên trang web hoặc để lại SĐT tại đây, nhân viên thu ngân sẽ giữ bàn cho bạn ngay ạ!";
                    }
                    $('#chatBody').append(`<div class="chat-msg bot">${reply}</div>`);
                    scrollChat();
                }, 500);
            }

            function scrollChat() {
                const chatBody = document.getElementById('chatBody');
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
