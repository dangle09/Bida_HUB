<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BOLT BILLIARDS</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/bolt-billiards-logo.png" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Customer CSS Tối giản & Hiện đại -->
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="customer-body" data-bs-spy="scroll" data-bs-target="#boltNav" data-bs-offset="80">

    <!-- 1. HEADER / NAVIGATION BAR (NẰM NGANG 1 HÀNG KHÔNG XUỐNG DÒNG) -->
    <nav class="navbar navbar-expand-xl bolt-navbar sticky-top" id="boltNav">
        <div class="container-fluid px-lg-4">
            <!-- Brand Logo -->
            <a class="bolt-brand" href="#home">
                <img src="~/images/bolt-billiards-logo.png" alt="Bolt Billiards Logo" class="bolt-logo-img" />
                <div>
                    <span class="bolt-brand-text"><span class="neon">BOLT</span> BILLIARDS</span>
                    <span class="bolt-brand-sub">PREMIUM POOL CLUB • ĐỒNG NAI</span>
                </div>
            </a>

            <!-- Mobile Hamburger Toggle -->
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <i class="bi bi-list fs-2" style="color: var(--bolt-neon);"></i>
            </button>

            <!-- Nav Links: Nằm ngang 1 hàng không bị rớt dòng -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-xl-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#pricing">Bảng giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#services">Dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#tournaments">Giải đấu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#booking">Đặt bàn</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Liên hệ</a>
                    </li>
                </ul>

                <!-- Action Buttons: Đặt bàn & Hotline -->
                <div class="d-flex align-items-center gap-2 flex-nowrap">
                    <a href="#booking" class="btn btn-bolt-neon-sm">
                        <i class="bi bi-calendar-check"></i> Đặt bàn
                    </a>
                    <a href="tel:0362870986" class="btn btn-bolt-outline-sm d-none d-sm-inline-flex" title="Hotline tư vấn">
                        <i class="bi bi-telephone-fill"></i> 0362 870 986
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- 2. MAIN CONTENT (BODY RENDER) -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 3. FOOTER -->
    <footer class="bolt-footer" id="contact">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Cột 1: Thông tin thương hiệu -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/bolt-billiards-logo.png" alt="Bolt Billiards" style="height: 38px;" />
                        <span class="footer-brand-title"><span style="color: var(--bolt-neon);">BOLT</span> BILLIARDS</span>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        Câu lạc bộ Bida phong cách hiện đại với dàn bàn thi đấu Aileex tiêu chuẩn quốc tế, bi Aramith Pro Cup, phòng máy lạnh 100% cùng menu ẩm thực phong phú phục vụ 24/7 tại Đồng Nai.
                    </p>
                    <div class="mt-3">
                        <a href="https://www.facebook.com/giangdeptraibodoiqua" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.tiktok.com/@@nggiangxclapw_7" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="https://www.youtube.com/@@gxxtenclqp" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="https://www.instagram.com/gxxtenclqp/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Đường dẫn nhanh -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Khám Phá</h6>
                    <ul class="footer-link-list small">
                        <li><a href="#home">Trang chủ</a></li>
                        <li><a href="#about">Về câu lạc bộ</a></li>
                        <li><a href="#pricing">Bảng giá bàn</a></li>
                        <li><a href="#services">Dịch vụ</a></li>
                        <li><a href="#tournaments">Giải đấu</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Dịch vụ & Hỗ trợ -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Dịch Vụ</h6>
                    <ul class="footer-link-list small">
                        <li><a href="#booking">Đặt bàn trước</a></li>
                        <li><a href="#services">Gậy & Phụ kiện</a></li>
                        <li><a href="#pricing">Phòng VIP riêng</a></li>
                        <li><a href="#tournaments">Đăng ký giải</a></li>
                        <li><a href="tel:0362870986">Hotline hỗ trợ</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Liên hệ trực tiếp tại Đồng Nai -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white mb-3 font-heading" style="font-size: 0.95rem;">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2 d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt" style="color: var(--bolt-neon);"></i>
                            <span>Số 168 Đường Đồng Khởi, Phường Tân Hiệp, TP. Biên Hòa, Tỉnh Đồng Nai</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-telephone" style="color: var(--bolt-neon);"></i>
                            <strong class="text-white">Hotline Đặt Bàn: 0362 870 986</strong>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-clock" style="color: var(--bolt-neon);"></i>
                            <span>Giờ mở cửa: <strong class="text-white">24/7 (Phục vụ xuyên đêm)</strong></span>
                        </li>
                        <li class="mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-envelope" style="color: var(--bolt-neon);"></i>
                            <span>contact@boltbilliards.vn</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr style="border-color: var(--bolt-border);" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-2 small text-secondary">
                <div>&copy; 2026 <strong>BOLT BILLIARDS CLUB</strong> • Chi nhánh Đồng Nai.</div>
                <div class="mt-2 mt-md-0">
                    <span class="fw-bold text-uppercase" style="color: var(--bolt-neon); letter-spacing: 0.8px;"><i class="bi bi-patch-check-fill me-1"></i> Đẳng cấp số 1 Việt Nam</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- 4. FLOATING HOTLINE (Góc trái dưới) -->
    <a href="tel:0362870986" class="floating-hotline" title="Gọi Hotline đặt bàn ngay!">
        <div class="hotline-circle">
            <i class="bi bi-telephone"></i>
        </div>
        <div class="hotline-label d-none d-md-block">
            <small style="color: var(--bolt-neon); font-size: 0.7rem;">HOTLINE 24/7</small><br />
            <span>0362 870 986</span>
        </div>
    </a>

    <!-- 5. FLOATING LIVE CHAT 24/7 WIDGET (Góc phải dưới) -->
    <div class="floating-chat">
        <!-- Nút tròn bật Chat -->
        <button class="chat-toggle-btn" id="chatToggleBtn" title="Hỗ trợ & Đặt bàn 24/7">
            <i class="bi bi-chat-text" id="chatIcon"></i>
        </button>

        <!-- Khung Chat Box thu nhỏ -->
        <div class="chat-box" id="chatBox" style="display: none;">
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="chat-status-dot"></div>
                    <div>
                        <div class="fw-bold text-white small">Trợ lý BOLT BILLIARDS</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Sẵn sàng giải đáp 24/7</div>
                    </div>
                </div>
                <button class="btn-close-chat" id="chatCloseBtn">&times;</button>
            </div>
            
            <div class="chat-body" id="chatBody">
                <div class="chat-msg chat-msg-bot">
                    Xin chào cơ thủ! 🎱 Bạn cần tư vấn loại bàn, đặt bàn trước hay xem menu đồ uống món ăn tại Bolt Billiards Đồng Nai ạ?
                </div>
            </div>
            
            <div class="chat-footer">
                <form id="chatForm" onsubmit="handleSendChat(event)">
                    <div class="input-group">
                        <input type="text" id="chatInput" class="form-control form-control-sm form-control-bolt" placeholder="Nhập câu hỏi của bạn..." />
                        <button type="submit" class="btn btn-bolt-neon btn-sm">Gửi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Chat Widget Script -->
    <script>
        const chatToggleBtn = document.getElementById('chatToggleBtn');
        const chatCloseBtn = document.getElementById('chatCloseBtn');
        const chatBox = document.getElementById('chatBox');
        const chatBody = document.getElementById('chatBody');
        const chatInput = document.getElementById('chatInput');

        if (chatToggleBtn && chatBox) {
            chatToggleBtn.addEventListener('click', () => {
                const isHidden = chatBox.style.display === 'none';
                chatBox.style.display = isHidden ? 'flex' : 'none';
                if (isHidden && chatInput) chatInput.focus();
            });
        }

        if (chatCloseBtn && chatBox) {
            chatCloseBtn.addEventListener('click', () => {
                chatBox.style.display = 'none';
            });
        }

        function handleSendChat(e) {
            e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            // Tin nhắn của khách
            const userMsg = document.createElement('div');
            userMsg.className = 'chat-msg chat-msg-user';
            userMsg.textContent = text;
            chatBody.appendChild(userMsg);
            chatInput.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Tin nhắn phản hồi tự động
            setTimeout(() => {
                const botMsg = document.createElement('div');
                botMsg.className = 'chat-msg chat-msg-bot';
                
                let reply = "Dạ BOLT BILLIARDS Đồng Nai đã nhận câu hỏi! Nhân viên sẽ hỗ trợ bạn ngay hoặc gọi Hotline <strong>0362 870 986</strong> để giữ bàn tức thì nhé!";
                const lower = text.toLowerCase();
                if (lower.includes('giá') || lower.includes('bao nhiêu')) {
                    reply = "Bảng giá giờ chơi: Bàn Pool 9-Ball: 60k/h, Carom 3C: 80k/h, Phòng VIP Smart TV: 120k/h ạ!";
                } else if (lower.includes('đặt bàn') || lower.includes('bàn trống')) {
                    reply = "Hiện quán đang mở 24/7 và còn bàn trống! Bạn có thể điền form Đặt Bàn ngay trên trang để nhận ưu đãi 10% nhé!";
                } else if (lower.includes('địa chỉ') || lower.includes('ở đâu')) {
                    reply = "Quán tọa lạc tại: Số 168 Đường Đồng Khởi, Phường Tân Hiệp, TP. Biên Hòa, Tỉnh Đồng Nai ạ!";
                }
                
                botMsg.innerHTML = reply;
                chatBody.appendChild(botMsg);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 600);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
