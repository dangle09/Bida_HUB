@model QuanLyQuanBida.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa Danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning-subtle text-dark py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa Danh mục: @Model.Name
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">ID Hệ thống</label>
                            <input type="text" class="form-control bg-light" value="@Model.Id" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-semibold">
                                Mã danh mục <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Code" class="form-control form-control-lg font-monospace text-uppercase" />
                            <div class="form-text">Mã định danh danh mục (duy nhất).</div>
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Tên danh mục <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" />
                            <div class="form-text">Tên hiển thị danh mục trên menu gọi món.</div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
