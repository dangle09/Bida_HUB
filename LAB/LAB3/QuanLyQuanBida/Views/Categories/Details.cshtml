@model QuanLyQuanBida.Models.Category

@{
    ViewData["Title"] = "Chi tiết Danh mục: " + Model.Name;
    var serviceItems = ViewBag.ServiceItems as List<QuanLyQuanBida.Models.ServiceItem> ?? new List<QuanLyQuanBida.Models.ServiceItem>();
}

<div class="container py-4">
    <!-- Thẻ thông tin danh mục -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-info-subtle text-dark py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-info-circle me-2 text-info"></i>Thông tin Chi tiết Danh mục
            </h5>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded">
                        <small class="text-muted d-block">ID Hệ thống</small>
                        <strong class="fs-5">#@Model.Id</strong>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded">
                        <small class="text-muted d-block">Mã Danh mục</small>
                        <span class="badge bg-dark font-monospace fs-6">@Model.Code</span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 bg-light rounded">
                        <small class="text-muted d-block">Tên Danh mục</small>
                        <strong class="fs-5 text-primary">@Model.Name</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm/dịch vụ thuộc danh mục -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="card-title mb-0 fw-bold">
                <i class="bi bi-cup-straw me-2 text-primary"></i>Danh sách Món / Sản phẩm thuộc danh mục này
                <span class="badge bg-primary ms-1">@serviceItems.Count</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase fs-7 text-muted">
                            <th style="width: 60px;" class="text-center">#</th>
                            <th style="width: 140px;">Mã món</th>
                            <th>Tên món / Sản phẩm</th>
                            <th style="width: 120px;" class="text-center">Đơn vị</th>
                            <th style="width: 160px;" class="text-end">Đơn giá</th>
                            <th style="width: 140px;" class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!serviceItems.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                    Chưa có món hay dịch vụ nào được gán vào danh mục này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            foreach (var item in serviceItems)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(index++)</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary border font-monospace">@item.Code</span></td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                    <td class="text-end fw-bold text-success">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Đang bán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
