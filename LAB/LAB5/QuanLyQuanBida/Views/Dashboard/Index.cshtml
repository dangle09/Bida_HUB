@model QuanLyQuanBida.ViewModels.DashboardOverviewViewModel
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isAdminOrManager = isAdmin || User.IsInRole("Manager");
    ViewData["Title"] = isAdminOrManager ? "Trang chủ Tổng quan - BOLT BILLIARDS" : "Bàn làm việc Thu ngân - BOLT BILLIARDS";
    Layout = "_AdminLayout";
    int occupancyPct = Model.TotalTables > 0 ? (int)Math.Round(Model.PlayingTables * 100.0 / Model.TotalTables) : 0;
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">@(isAdminOrManager ? "Tổng quan vận hành CLB" : "Bàn làm việc Thu ngân ca trực")</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-10 border-success text-success d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-10 border-danger text-danger d-flex align-items-center gap-2 py-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- HERO CHÀO MỪNG & LỐI TẮT NHANH THEO PHÂN QUYỀN -->
    <div class="card detail-hero-card mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-12 col-lg-7">
                    <div class="badge text-uppercase fw-bold px-2 py-1 mb-2" style="background: rgba(166, 255, 0, 0.14); color: var(--primary-neon);">
                        <i class="bi bi-lightning-charge-fill me-1"></i>
                        @(isAdmin ? "TRUNG TÂM ĐIỀU HÀNH QUẢN TRỊ VIÊN" : isAdminOrManager ? "TRUNG TÂM ĐIỀU HÀNH QUẢN LÝ CƠ SỞ" : "BÀN LÀM VIỆC THU NGÂN CA TRỰC")
                    </div>
                    <h2 class="h3 fw-bold text-white mb-1 font-heading">
                        Xin chào, <span style="color: var(--primary-neon);">@(User.Identity?.Name ?? "Nhân viên")</span>
                    </h2>
                    <div class="text-muted small">
                        @if (isAdminOrManager)
                        {
                            <span>Theo dõi nhanh toàn cảnh hoạt động câu lạc bộ gồm doanh thu, công suất bàn bida, tồn kho, hội viên và vận hành.</span>
                        }
                        else
                        {
                            <span>Bảng tác nghiệp thu ngân ca trực: theo dõi bàn đang chơi, tra cứu hóa đơn tại quầy và món gọi phổ biến.</span>
                        }
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-controller="Pos" asp-action="Index" class="dash-shortcut-btn">
                                <i class="bi bi-grid-3x3-gap-fill text-warning fs-5"></i>
                                <span>Mở Sơ Đồ Bàn</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Menu" asp-action="Index" class="dash-shortcut-btn">
                                <i class="bi bi-cup-straw text-info fs-5"></i>
                                <span>Thực Đơn F&amp;B</span>
                            </a>
                        </div>
                        @if (isAdminOrManager)
                        {
                            <div class="col-6">
                                <a asp-controller="Inventory" asp-action="Index" class="dash-shortcut-btn">
                                    <i class="bi bi-box-seam text-primary fs-5"></i>
                                    <span>Kho &amp; Nhập Hàng</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Reports" asp-action="Index" class="dash-shortcut-btn">
                                    <i class="bi bi-bar-chart-line-fill text-success fs-5"></i>
                                    <span>Báo Cáo Doanh Thu</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="col-6">
                                <a asp-controller="Invoices" asp-action="Index" class="dash-shortcut-btn">
                                    <i class="bi bi-receipt text-success fs-5"></i>
                                    <span>Hóa Đơn POS</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Customers" asp-action="Index" class="dash-shortcut-btn">
                                    <i class="bi bi-award-fill text-warning fs-5"></i>
                                    <span>Khách &amp; Gửi Cơ</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isAdminOrManager)
    {
        <!-- ====================================================================== -->
        <!-- CHẾ ĐỘ ADMIN / MANAGER: 6 THẺ KPI TỔNG HỢP QUẢN TRỊ                    -->
        <!-- ====================================================================== -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="Reports" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.12);">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Tổng doanh thu đã thu</p>
                                <div class="kpi-value text-white">@Model.TotalRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                                <div class="small" style="color: var(--primary-neon);">Hôm nay: @Model.TodayRevenue.ToString("N0") đ</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="Pos" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #38bdf8; background: rgba(56, 189, 248, 0.12);">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Công suất bàn Bida</p>
                                <div class="kpi-value text-info">@Model.PlayingTables / @Model.TotalTables <small class="fs-6 text-muted fw-normal">Bàn (@occupancyPct%)</small></div>
                                <div class="small text-muted">Đang chơi thực tế trên hệ thống</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="Invoices" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #22c55e; background: rgba(34, 197, 94, 0.12);">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Hóa đơn hoàn tất</p>
                                <div class="kpi-value text-success">@Model.PaidInvoicesCount <small class="fs-6 text-muted fw-normal">Bill</small></div>
                                <div class="small text-warning">@Model.PlayingInvoicesCount hóa đơn đang mở bàn</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="Menu" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #c084fc; background: rgba(192, 132, 252, 0.12);">
                                <i class="bi bi-cup-straw"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Thực đơn &amp; Danh mục</p>
                                <div class="kpi-value" style="color: #c084fc;">@Model.ActiveMenuItems / @Model.TotalMenuItems <small class="fs-6 text-muted fw-normal">Món</small></div>
                                <div class="small text-muted">Thuộc @Model.TotalCategories nhóm danh mục</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="Inventory" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #ef4444; background: rgba(239, 68, 68, 0.12);">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Cảnh báo tồn kho</p>
                                <div class="kpi-value text-danger">@Model.LowStockCount <small class="fs-6 text-danger fw-normal">Mặt hàng cần nhập</small></div>
                                <div class="small text-muted">Giá trị kho: @Model.TotalInventoryValue.ToString("N0") đ</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <a asp-controller="@(isAdmin ? "Staff" : "Customers")" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.12);">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div>
                                @if (isAdmin)
                                {
                                    <p class="kpi-label">Nhân sự &amp; Hội viên CLB</p>
                                    <div class="kpi-value text-warning">@Model.ActiveStaff <small class="fs-6 text-muted fw-normal">NV</small> • @Model.TotalCustomers <small class="fs-6 text-muted fw-normal">KH</small></div>
                                }
                                else
                                {
                                    <p class="kpi-label">Hội viên CLB Bida</p>
                                    <div class="kpi-value text-warning">@Model.TotalCustomers <small class="fs-6 text-muted fw-normal">Thành viên</small></div>
                                }
                                <div class="small text-muted">@Model.VipCustomers hội viên VIP Vàng &amp; Kim Cương</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>
        </div>

        <!-- HÀNG 2A (ADMIN/MANAGER): HÓA ĐƠN GẦN ĐÂY & MẶT HÀNG CẦN NHẬP GẤP -->
        <div class="row g-3 mb-4 align-items-stretch">
            <div class="col-12 col-xl-7">
                <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-receipt text-success me-2"></i>GIAO DỊCH HÓA ĐƠN GẦN ĐÂY
                        </span>
                        <a asp-controller="Invoices" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Xem tất cả</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 small">
                            <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                                <tr>
                                    <th class="ps-3">MÃ HĐ</th>
                                    <th>BÀN</th>
                                    <th>KHÁCH HÀNG</th>
                                    <th>THỜI GIAN</th>
                                    <th class="text-end">TỔNG TIỀN</th>
                                    <th class="text-center pe-3">TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace fw-bold text-info">@inv.InvoiceCode</td>
                                        <td>@inv.TableName</td>
                                        <td class="text-white">@inv.CustomerName</td>
                                        <td class="text-muted">@inv.StartTime.ToString("dd/MM HH:mm")</td>
                                        <td class="text-end fw-bold" style="color: var(--primary-neon);">@inv.TotalPayment.ToString("N0") đ</td>
                                        <td class="text-center pe-3">
                                            <span class="badge @(inv.Status == "Đã thanh toán" ? "bg-success text-dark" : "bg-warning text-dark") fw-bold">@inv.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>MẶT HÀNG CẦN NHẬP GẤP (@Model.LowStockItems.Count)
                        </span>
                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-danger btn-sm py-0 px-2 small">Nhập kho ngay</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 small">
                            <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                                <tr>
                                    <th class="ps-3">SẢN PHẨM</th>
                                    <th class="text-center">TỒN HIỆN TẠI</th>
                                    <th class="text-center">AN TOÀN</th>
                                    <th class="text-end pe-3">XEM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LowStockItems.Any())
                                {
                                    foreach (var it in Model.LowStockItems)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-bold text-white">@it.Name</div>
                                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">@it.Code</div>
                                            </td>
                                            <td class="text-center fw-bold text-danger">@it.StockQuantity @it.Unit</td>
                                            <td class="text-center text-muted">@it.ReorderLevel</td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@it.ServiceItemId" class="btn btn-outline-info action-btn" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-success py-4"><i class="bi bi-check-circle me-1"></i>Tất cả mặt hàng đều đủ tồn kho an toàn!</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- HÀNG 2B (ADMIN/MANAGER): TRẠNG THÁI BÀN THEO KHU VỰC & TOP MÓN BÁN CHẠY -->
        <div class="row g-3 mb-4 align-items-stretch">
            <div class="col-12 col-xl-7">
                <div class="card bg-dark border-secondary border-opacity-50 h-100 d-flex flex-column">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-building text-info me-2"></i>TRẠNG THÁI BÀN THEO KHU VỰC
                        </span>
                        <a asp-controller="Pos" asp-action="Index" class="btn btn-outline-warning btn-sm py-0 px-2 small">Mở POS</a>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-center flex-grow-1">
                        <div class="row g-3">
                            @foreach (var area in Model.AreaOccupancies)
                            {
                                <div class="col-12 col-md-4">
                                    <div class="detail-info-tile h-100 d-flex flex-column justify-content-between">
                                        <div class="small fw-bold text-white mb-2" style="min-height: 2.4em;">@area.AreaName</div>
                                        <div>
                                            <div class="d-flex justify-content-between small text-muted mb-2">
                                                <span>Đang chơi: <strong class="text-info">@area.PlayingCount/@area.TotalCount</strong></span>
                                                <span>Trống: <strong class="text-success">@area.AvailableCount</strong></span>
                                            </div>
                                            <div class="progress bg-black" style="height: 6px;">
                                                <div class="progress-bar bg-info" style="width: @area.OccupancyPercent%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="p-3 border-top border-secondary border-opacity-25">
                        <div class="row g-2 align-items-stretch">
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #38bdf8;">
                                    <div class="detail-info-label text-nowrap">Công suất chung</div>
                                    <div class="fw-bold text-info lh-1 mt-1" style="font-size: 1.12rem;">@occupancyPct%</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #22c55e;">
                                    <div class="detail-info-label text-nowrap">Bàn sẵn sàng</div>
                                    <div class="fw-bold text-success lh-1 mt-1" style="font-size: 1.12rem;">@Model.AreaOccupancies.Sum(a => a.AvailableCount) bàn</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #eab308;">
                                    <div class="detail-info-label text-nowrap">Bàn đặt trước</div>
                                    <div class="fw-bold text-warning lh-1 mt-1" style="font-size: 1.12rem;">@Model.AreaOccupancies.Sum(a => a.ReservedCount) bàn</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: var(--primary-neon);">
                                    <div class="detail-info-label text-nowrap">Tổng chi phí</div>
                                    <div class="fw-bold text-white lh-1 mt-1 text-nowrap" style="font-size: 1.05rem;">@Model.TotalExpenses.ToString("N0") đ</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100 d-flex flex-column">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-fire text-warning me-2"></i>TOP MÓN BÁN CHẠY NHẤT
                        </span>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Xem thực đơn</a>
                    </div>
                    <div class="card-body p-0 flex-grow-1 d-flex flex-column justify-content-between">
                        @{ int topRank = 1; }
                        @foreach (var top in Model.TopSellingItems)
                        {
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom border-secondary border-opacity-15 small flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(topRank == 1 ? "bg-warning text-dark" : "bg-black border border-secondary text-secondary") font-monospace" style="width: 26px;">#@(topRank++)</span>
                                    <div>
                                        <div class="fw-bold text-white">@top.Name</div>
                                        <div class="text-muted" style="font-size: 0.74rem;">@top.Code • Đã bán <strong class="text-info">@top.TotalQty @top.Unit</strong></div>
                                    </div>
                                </div>
                                <span class="fw-bold font-monospace" style="color: var(--primary-neon);">@top.TotalRevenue.ToString("N0") đ</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- HÀNG 3 (ADMIN: VIP + NHẬT KÝ BẢO MẬT | MANAGER: CHỈ TOP 7 VIP FULL RỘNG) -->
        <div class="row g-3">
            <div class="col-12 @(isAdmin ? "col-xl-5" : "col-xl-12")">
                <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-award-fill text-warning me-2"></i>TOP 7 HỘI VIÊN VIP TÍCH ĐIỂM
                        </span>
                        <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-warning btn-sm py-0 px-2 small">Xem hội viên</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 small">
                            <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                                <tr>
                                    <th class="ps-3" style="@(isAdmin ? "" : "width: 270px;")">CƠ THỦ</th>
                                    <th class="text-start">HẠNG</th>
                                    <th class="text-end pe-3" style="@(isAdmin ? "" : "width: 150px;")">ĐIỂM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.TopCustomers)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-white">@c.FullName</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@c.Code • @c.PhoneNumber</div>
                                        </td>
                                        <td class="text-start"><span class="badge bg-info text-dark fw-bold">@c.TierName</span></td>
                                        <td class="text-end pe-3 fw-bold text-warning">@c.AccumulatedPoints.ToString("N0") pts</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (isAdmin)
            {
                <div class="col-12 col-xl-7">
                    <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100">
                        <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-white small text-uppercase font-heading">
                                <i class="bi bi-shield-check text-info me-2"></i>NHẬT KÝ HOẠT ĐỘNG HỆ THỐNG MỚI NHẤT
                            </span>
                            <a asp-controller="Staff" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Xem nhật ký</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 small">
                                <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                                    <tr>
                                        <th class="ps-3">THỜI GIAN</th>
                                        <th>NGƯỜI THỰC HIỆN</th>
                                        <th>HÀNH ĐỘNG</th>
                                        <th class="pe-3">NỘI DUNG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.RecentLogs)
                                    {
                                        string uname = Model.UserNameDict.ContainsKey(l.UserId) ? Model.UserNameDict[l.UserId] : $"User #{l.UserId}";
                                        <tr>
                                            <td class="ps-3 text-muted font-monospace">@l.CreatedAt.ToString("dd/MM HH:mm")</td>
                                            <td class="fw-semibold text-white">@uname</td>
                                            <td><span class="badge bg-black border border-info text-info font-monospace">@l.Action</span></td>
                                            <td class="pe-3 text-light">@l.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- ====================================================================== -->
        <!-- CHẾ ĐỘ THU NGÂN (CASHIER): CHỈ HIỂN THỊ TÁC VỤ CA TRỰC & QUẦY POS      -->
        <!-- TUYỆT ĐỐI ẨN: DOANH THU TỔNG CLB, CHI PHÍ, GIÁ TRỊ KHO, NHÂN SỰ, AUDIT  -->
        <!-- ====================================================================== -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <a asp-controller="Invoices" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.12);">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Doanh thu ca hôm nay</p>
                                <div class="kpi-value text-white">@Model.TodayRevenue.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                                <div class="small" style="color: var(--primary-neon);">Cập nhật theo bill thanh toán hôm nay</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a asp-controller="Pos" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #38bdf8; background: rgba(56, 189, 248, 0.12);">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Bàn đang hoạt động</p>
                                <div class="kpi-value text-info">@Model.PlayingTables / @Model.TotalTables <small class="fs-6 text-muted fw-normal">Bàn (@occupancyPct%)</small></div>
                                <div class="small text-muted">@Model.AreaOccupancies.Sum(a => a.AvailableCount) bàn trống sẵn sàng đón khách</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a asp-controller="Menu" asp-action="Index" class="dash-kpi-link">
                    <div class="kpi-stat-card d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.12);">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>
                            <div>
                                <p class="kpi-label">Bàn đang mở &amp; Thực đơn</p>
                                <div class="kpi-value text-warning">@Model.PlayingInvoicesCount <small class="fs-6 text-muted fw-normal">Bill mở</small></div>
                                <div class="small text-muted">@Model.ActiveMenuItems/@Model.TotalMenuItems món đang sẵn sàng phục vụ</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>
        </div>

        <!-- TRẠNG THÁI BÀN THEO KHU VỰC (KHÔNG HIỆN CHI PHÍ) & TOP MÓN GỌI NHIỀU -->
        <div class="row g-3 mb-4 align-items-stretch">
            <div class="col-12 col-xl-7">
                <div class="card bg-dark border-secondary border-opacity-50 h-100 d-flex flex-column">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-building text-info me-2"></i>TRẠNG THÁI BÀN THEO KHU VỰC
                        </span>
                        <a asp-controller="Pos" asp-action="Index" class="btn btn-outline-warning btn-sm py-0 px-2 small">Mở POS</a>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-center flex-grow-1">
                        <div class="row g-3">
                            @foreach (var area in Model.AreaOccupancies)
                            {
                                <div class="col-12 col-md-4">
                                    <div class="detail-info-tile h-100 d-flex flex-column justify-content-between">
                                        <div class="small fw-bold text-white mb-2" style="min-height: 2.4em;">@area.AreaName</div>
                                        <div>
                                            <div class="d-flex justify-content-between small text-muted mb-2">
                                                <span>Đang chơi: <strong class="text-info">@area.PlayingCount/@area.TotalCount</strong></span>
                                                <span>Trống: <strong class="text-success">@area.AvailableCount</strong></span>
                                            </div>
                                            <div class="progress bg-black" style="height: 6px;">
                                                <div class="progress-bar bg-info" style="width: @area.OccupancyPercent%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="p-3 border-top border-secondary border-opacity-25">
                        <div class="row g-2 align-items-stretch">
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #38bdf8;">
                                    <div class="detail-info-label text-nowrap">Công suất chung</div>
                                    <div class="fw-bold text-info lh-1 mt-1" style="font-size: 1.12rem;">@occupancyPct%</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: var(--primary-neon);">
                                    <div class="detail-info-label text-nowrap">Đang chơi</div>
                                    <div class="fw-bold text-white lh-1 mt-1" style="font-size: 1.12rem;">@Model.PlayingTables bàn</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #22c55e;">
                                    <div class="detail-info-label text-nowrap">Bàn sẵn sàng</div>
                                    <div class="fw-bold text-success lh-1 mt-1" style="font-size: 1.12rem;">@Model.AreaOccupancies.Sum(a => a.AvailableCount) bàn</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="detail-mini-kpi py-2" style="border-left-color: #eab308;">
                                    <div class="detail-info-label text-nowrap">Bàn đặt trước</div>
                                    <div class="fw-bold text-warning lh-1 mt-1" style="font-size: 1.12rem;">@Model.AreaOccupancies.Sum(a => a.ReservedCount) bàn</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden h-100 d-flex flex-column">
                    <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white small text-uppercase font-heading">
                            <i class="bi bi-fire text-warning me-2"></i>MÓN KHÁCH GỌI NHIỀU NHẤT
                        </span>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Xem thực đơn</a>
                    </div>
                    <div class="card-body p-0 flex-grow-1 d-flex flex-column justify-content-between">
                        @{ int cashierRank = 1; }
                        @foreach (var top in Model.TopSellingItems)
                        {
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom border-secondary border-opacity-15 small flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(cashierRank == 1 ? "bg-warning text-dark" : "bg-black border border-secondary text-secondary") font-monospace" style="width: 26px;">#@(cashierRank++)</span>
                                    <div>
                                        <div class="fw-bold text-white">@top.Name</div>
                                        <div class="text-muted font-monospace" style="font-size: 0.72rem;">@top.Code</div>
                                    </div>
                                </div>
                                <span class="badge bg-black border border-info text-info fw-semibold">Đã gọi @top.TotalQty @top.Unit</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- GIAO DỊCH HÓA ĐƠN GẦN ĐÂY (FULL NGANG CHO THU NGÂN TRA CỨU) -->
        <div class="card bg-dark border-secondary border-opacity-50 overflow-hidden">
            <div class="card-header bg-black bg-opacity-40 py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-white small text-uppercase font-heading">
                    <i class="bi bi-receipt text-success me-2"></i>GIAO DỊCH HÓA ĐƠN GẦN ĐÂY TẠI QUẦY
                </span>
                <a asp-controller="Invoices" asp-action="Index" class="btn btn-outline-info btn-sm py-0 px-2 small">Mở sổ hóa đơn</a>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 small">
                    <thead class="bg-black text-secondary text-uppercase" style="font-size: 0.7rem;">
                        <tr>
                            <th class="ps-3">MÃ HĐ</th>
                            <th>BÀN</th>
                            <th>KHÁCH HÀNG</th>
                            <th>THỜI GIAN</th>
                            <th class="text-end">TỔNG TIỀN</th>
                            <th class="text-center pe-3">TRẠNG THÁI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.RecentInvoices)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-info">@inv.InvoiceCode</td>
                                <td>@inv.TableName</td>
                                <td class="text-white">@inv.CustomerName</td>
                                <td class="text-muted">@inv.StartTime.ToString("dd/MM HH:mm")</td>
                                <td class="text-end fw-bold" style="color: var(--primary-neon);">@inv.TotalPayment.ToString("N0") đ</td>
                                <td class="text-center pe-3">
                                    <span class="badge @(inv.Status == "Đã thanh toán" ? "bg-success text-dark" : "bg-warning text-dark") fw-bold">@inv.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
