                    <label class="form-label small text-muted">Lý do điều chỉnh:</label>
                    <input type="text" class="form-control bg-black text-light border-secondary" placeholder="Tặng điểm sinh nhật, giải đấu, đền bù..." style="border-radius: 2px !important;" />
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 2px !important;">Hủy</button>
                <button type="button" class="btn btn-bolt-neon btn-sm px-3" data-bs-dismiss="modal" onclick="alert('Đã cập nhật điểm thưởng hội viên thành công!');" style="border-radius: 2px !important;">
                    <i class="bi bi-check-lg"></i> Xác nhận cộng điểm
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewAvatar(input, previewImgId, hideElementId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById(previewImgId);
                    var hideEl = document.getElementById(hideElementId);
                    if (img) {
                        img.src = e.target.result;
                        img.style.display = 'block';
                    }
                    if (hideEl) {
                        hideEl.style.display = 'none';
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // QUẢN LÝ PHÂN TRANG VÀ BỘ LỌC 156 HỘI VIÊN
        var currentPage = 1;
        var pageSize = 15;
        var allRows = [];
        var filteredRows = [];

        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('customerSearchInput');
            var tierFilter = document.getElementById('customerTierFilter');
            allRows = Array.from(document.querySelectorAll('#customersTable tbody tr.member-row'));
            filteredRows = allRows.slice();

            function applyFilter() {
                var query = (searchInput.value || '').trim().toLowerCase();
                var selectedTier = (tierFilter.value || '').trim();

                filteredRows = allRows.filter(function (row) {
                    var tier = row.getAttribute('data-tier') || '';
                    var text = row.textContent.toLowerCase();
                    var matchesQuery = !query || text.includes(query);
                    var matchesTier = !selectedTier || tier === selectedTier;
                    return matchesQuery && matchesTier;
                });

                currentPage = 1;
                renderPage();
            }

            window.renderPage = function() {
                var total = filteredRows.length;
                var totalPages = Math.ceil(total / pageSize) || 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                var startIdx = (currentPage - 1) * pageSize;
                var endIdx = startIdx + pageSize;

                allRows.forEach(function (row) {
                    row.style.display = 'none';
                });

                filteredRows.slice(startIdx, endIdx).forEach(function (row) {
                    row.style.display = '';
                });

                // Cập nhật số liệu hiển thị
                document.getElementById('showingCount').textContent = total;
                document.getElementById('currentPageNum').textContent = currentPage;
                document.getElementById('totalPageNum').textContent = totalPages;

                // Nút Trước / Sau
                document.getElementById('btnPrevPage').disabled = (currentPage === 1);
                document.getElementById('btnNextPage').disabled = (currentPage === totalPages);

                // Tạo số trang
                var container = document.getElementById('pageNumbersContainer');
                container.innerHTML = '';
                var maxButtons = 5;
                var startPage = Math.max(1, currentPage - 2);
                var endPage = Math.min(totalPages, startPage + maxButtons - 1);
                if (endPage - startPage < maxButtons - 1) {
                    startPage = Math.max(1, endPage - maxButtons + 1);
                }

                for (var i = startPage; i <= endPage; i++) {
                    var btn = document.createElement('button');
                    btn.className = 'btn btn-sm ' + (i === currentPage ? 'btn-bolt-neon' : 'btn-dark border-secondary text-light');
                    btn.style.borderRadius = '2px';
                    btn.textContent = i;
                    btn.onclick = (function(p) {
                        return function() {
                            currentPage = p;
                            renderPage();
                        };
                    })(i);
                    container.appendChild(btn);
                }
            };

            window.changePage = function(delta) {
                currentPage += delta;
                renderPage();
            };

            if (searchInput) searchInput.addEventListener('input', applyFilter);
            if (tierFilter) tierFilter.addEventListener('change', applyFilter);

            renderPage();

            // SỰ KIỆN NÚT CHỈNH SỬA
            document.querySelectorAll('.btn-edit-customer').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var name = this.getAttribute('data-name');
                    var card = this.getAttribute('data-card');
                    var phone = this.getAttribute('data-phone');
                    var tier = this.getAttribute('data-tier');
                    var spend = this.getAttribute('data-spend');

                    document.getElementById('editMemberName').value = name;
                    document.getElementById('editMemberCard').value = card;
                    document.getElementById('editMemberPhone').value = phone;
                    document.getElementById('editMemberTier').value = tier;
                    document.getElementById('editMemberSpend').value = Number(spend).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('textEditMemberInitial').textContent = name.substring(0, 1);

                    var modal = new bootstrap.Modal(document.getElementById('modalSuaHoiVien'));
                    modal.show();
                });
            });

            // SỰ KIỆN NÚT CỘNG ĐIỂM
            document.querySelectorAll('.btn-add-points').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var name = this.getAttribute('data-name');
                    var card = this.getAttribute('data-card');
                    var points = this.getAttribute('data-points');

                    document.getElementById('pointMemberName').textContent = name;
                    document.getElementById('pointMemberCard').textContent = card;
                    document.getElementById('pointMemberCurrent').textContent = Number(points).toLocaleString('vi-VN') + ' Pts';

                    var modal = new bootstrap.Modal(document.getElementById('modalCongDiem'));
                    modal.show();
                });
            });
        });
    </script>
}
