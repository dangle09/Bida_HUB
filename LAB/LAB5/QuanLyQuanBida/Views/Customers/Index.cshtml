@* ===================================================================================
   WEB QUẢN LÝ (BIDA POS & ADMIN DASHBOARD) - HỘI VIÊN & GIẢI ĐẤU: KHÁCH HÀNG & VIP
   - Tên file: Views/Customers/Index.cshtml
   - Vai trò: Quản lý đầy đủ 156 hội viên CLB, tích lũy điểm thưởng, quản lý tủ đồ cơ
   - Đồng bộ 100% với số liệu KPI: 156 Hội viên (14 Kim Cương, 38 Vàng, 42 Bạc, 62 Standard)
   - Layout: Views/Shared/_AdminLayout.cshtml
   - CSS: wwwroot/css/admin-pos.css (Chuẩn bo góc 2px radius toàn trang)
   =================================================================================== *@
@{
    ViewData["Title"] = "Khách hàng & VIP - BOLT BILLIARDS";
    Layout = "_AdminLayout";

    // Xây dựng danh sách chuẩn xác ĐỦ 156 HỘI VIÊN đồng bộ toàn diện với hệ thống
    var memberList = new List<dynamic>();

    // 14 VIP KIM CƯƠNG (DIAMOND)
    var diamondNames = new[] {
        ("VIP-8888", "Đào Ngọc Giang", "0347.987.360", 4850, 18600000, "01/01/2026", "Cơ thủ thường trực CLB • Tủ cơ #01"),
        ("VIP-8889", "Master Dũng", "0903.111.222", 4200, 16500000, "05/01/2026", "HLV Bida Libre • Tủ cơ #04"),
        ("VIP-8890", "Trần Quốc Bảo", "0918.234.567", 3950, 15200000, "12/01/2026", "VIP Diamond thường trực"),
        ("VIP-8891", "Nguyễn Hoàng Nam", "0909.876.543", 3800, 14800000, "18/01/2026", "VIP Diamond Tầng 1"),
        ("VIP-8892", "Võ Thành Long", "0938.456.789", 3650, 14200000, "25/01/2026", "VIP Diamond Carom"),
        ("VIP-8893", "Đặng Văn Lâm", "0987.654.321", 3500, 13700000, "02/02/2026", "VIP Diamond Phòng VIP"),
        ("VIP-8894", "Bùi Tiến Dũng", "0912.987.654", 3420, 13400000, "10/02/2026", "VIP Diamond"),
        ("VIP-8895", "Phan Văn Đức", "0933.876.543", 3350, 13100000, "15/02/2026", "VIP Diamond"),
        ("VIP-8896", "Lương Xuân Trường", "0977.123.987", 3280, 12800000, "20/02/2026", "VIP Diamond"),
        ("VIP-8897", "Nguyễn Tuấn Anh", "0966.543.210", 3200, 12500000, "25/02/2026", "VIP Diamond"),
        ("VIP-8898", "Đỗ Duy Mạnh", "0944.321.654", 3150, 12300000, "01/03/2026", "VIP Diamond"),
        ("VIP-8899", "Đoàn Văn Hậu", "0919.876.123", 3100, 12100000, "05/03/2026", "VIP Diamond"),
        ("VIP-8900", "Hà Đức Chinh", "0908.654.987", 3050, 11900000, "10/03/2026", "VIP Diamond"),
        ("VIP-8901", "Nguyễn Tiến Linh", "0937.210.987", 3000, 11700000, "15/03/2026", "VIP Diamond")
    };
    foreach (var d in diamondNames) {
        memberList.Add(new { Code = d.Item1, Name = d.Item2, Phone = d.Item3, Tier = "diamond", TierName = "💎 VIP DIAMOND", Points = d.Item4, Discount = "-15% Giờ & F&B", Spend = d.Item5, JoinDate = d.Item6, Note = d.Item7 });
    }

    // 38 VIP VÀNG (GOLD)
    var goldNames = new[] {
        ("VIP-1024", "Lê Nhật Đăng", "0912.334.455", 2340, 9450000, "15/02/2026", "Cơ thủ Carom 3 Băng • Tủ cơ #02"),
        ("VIP-2048", "Hoàng Minh Tuấn", "0908.776.655", 2120, 8500000, "12/03/2026", "Thành viên thường xuyên Tầng 1"),
        ("VIP-1102", "Nguyễn Đình Trọng", "0933.123.456", 1890, 7650000, "20/04/2026", "Cơ thủ 3 Băng Phòng VIP"),
        ("VIP-0888", "Nguyễn Văn Năm (Chú Năm)", "0903.445.667", 2850, 11400000, "10/01/2026", "Cơ thủ kỳ cựu Tầng 2 Carom"),
        ("VIP-1025", "Nguyễn Hữu Thắng", "0945.678.901", 1750, 7000000, "14/03/2026", "Khách VIP quen thuộc"),
        ("VIP-1026", "Trương Đăng Khoa", "0913.456.780", 2200, 8900000, "18/02/2026", "Hạt giống số 2 Giải đấu"),
        ("VIP-1027", "Võ Văn Hoàng", "0978.112.233", 1950, 7800000, "22/03/2026", "Cơ thủ Pool Bàn 02"),
        ("VIP-1028", "Trần Đình Quang", "0989.334.455", 1680, 6700000, "05/04/2026", "Khách thường trực"),
        ("VIP-1029", "Lê Văn Tùng", "0902.556.677", 1820, 7300000, "28/02/2026", "Hội viên VIP Vàng"),
        ("VIP-1030", "Nguyễn Văn Hùng", "0935.778.899", 1600, 6400000, "08/04/2026", "Hội viên VIP Vàng")
    };
    foreach (var g in goldNames) {
        memberList.Add(new { Code = g.Item1, Name = g.Item2, Phone = g.Item3, Tier = "gold", TierName = "⭐ VIP GOLD", Points = g.Item4, Discount = "-10% Giờ chơi", Spend = g.Item5, JoinDate = g.Item6, Note = g.Item7 });
    }
    for (int i = 11; i <= 38; i++) {
        string code = $"VIP-10{30 + i}";
        string phone = $"091{i:00}.{(200 + i * 7):000}.{(300 + i * 11):000}";
        int pts = 1500 - (i * 18);
        long sp = 6000000 - (i * 70000);
        string[] sampleNames = { "Huỳnh Anh Tuấn", "Phạm Quốc Huy", "Ngô Thanh Tùng", "Đỗ Quang Minh", "Vũ Minh Trí", "Dương Quốc Hoàng", "Lý Gia Huy", "Mai Xuân Hùng", "Hồ Văn Cường", "Đặng Đình Phúc" };
        string name = sampleNames[(i - 11) % sampleNames.Length] + $" (V{i})";
        memberList.Add(new { Code = code, Name = name, Phone = phone, Tier = "gold", TierName = "⭐ VIP GOLD", Points = pts, Discount = "-10% Giờ chơi", Spend = sp, JoinDate = $"{(i % 28) + 1:00}/03/2026", Note = "Hội viên VIP Vàng tích cực" });
    }

    // 42 VIP BẠC (SILVER)
    var silverTop = new[] {
        ("VIP-0512", "Phạm Trần Bạch Long", "0982.870.986", 1120, 4200000, "10/05/2026", "Cơ thủ Pool 9-Ball • Tủ cơ #03"),
        ("VIP-0340", "Bùi Đức Thắng", "0971.554.321", 980, 3900000, "05/06/2026", "Cơ thủ trẻ tiềm năng CLB"),
        ("VIP-0513", "Đỗ Hải Đăng", "0934.567.890", 1050, 4100000, "12/05/2026", "Cơ thủ Pool Bàn 12"),
        ("VIP-0514", "Trịnh Công Minh", "0906.789.012", 920, 3700000, "18/05/2026", "Hội viên Bạc"),
        ("VIP-0515", "Vũ Đình Khang", "0917.890.123", 890, 3550000, "25/05/2026", "Cơ thủ Giải đấu Tứ kết")
    };
    foreach (var s in silverTop) {
        memberList.Add(new { Code = s.Item1, Name = s.Item2, Phone = s.Item3, Tier = "silver", TierName = "🥈 VIP SILVER", Points = s.Item4, Discount = "-5% Giờ chơi", Spend = s.Item5, JoinDate = s.Item6, Note = s.Item7 });
    }
    for (int i = 6; i <= 42; i++) {
        string code = $"VIP-05{30 + i}";
        string phone = $"097{i:00}.{(150 + i * 9):000}.{(400 + i * 5):000}";
        int pts = 950 - (i * 12);
        long sp = 3800000 - (i * 45000);
        string[] sampleNames = { "Lâm Gia Huy", "Phan Trí Dũng", "Tạ Quang Bửu", "Cao Minh Thắng", "Đinh Hữu Lộc", "Lê Khánh Toàn", "Hoàng Kim Long", "Bạch Thái Bưởi", "Chu Văn An", "Trần Đại Nghĩa" };
        string name = sampleNames[(i - 6) % sampleNames.Length] + $" (S{i})";
        memberList.Add(new { Code = code, Name = name, Phone = phone, Tier = "silver", TierName = "🥈 VIP SILVER", Points = pts, Discount = "-5% Giờ chơi", Spend = sp, JoinDate = $"{(i % 28) + 1:00}/05/2026", Note = "Hội viên VIP Bạc thân thiết" });
    }

    // 62 TIÊU CHUẨN (STANDARD)
    var standardTop = new[] {
        ("STD-0101", "Trần Quang Huy", "0962.333.888", 320, 1250000, "02/11/2026", "Hội viên mới tháng 11"),
        ("STD-0102", "Nguyễn Thành Nam", "0948.222.111", 150, 600000, "10/11/2026", "Cơ thủ Bàn 05"),
        ("STD-0103", "Phan Văn Hậu", "0915.666.777", 280, 1100000, "04/11/2026", "Khách chơi Pool"),
        ("STD-0104", "Lê Thanh Sơn", "0907.888.999", 220, 880000, "08/11/2026", "Hội viên mới"),
        ("STD-0105", "Ngô Trí Dũng", "0939.000.111", 310, 1200000, "01/11/2026", "Khách chơi Carom")
    };
    foreach (var st in standardTop) {
        memberList.Add(new { Code = st.Item1, Name = st.Item2, Phone = st.Item3, Tier = "standard", TierName = "STANDARD", Points = st.Item4, Discount = "Tích lũy", Spend = st.Item5, JoinDate = st.Item6, Note = st.Item7 });
    }
    for (int i = 6; i <= 62; i++) {
        string code = $"STD-01{i:00}";
        string phone = $"096{i:00}.{(100 + i * 8):000}.{(200 + i * 12):000}";
        int pts = 300 - (i * 3);
        long sp = 1200000 - (i * 12000);
        string[] sampleNames = { "Nguyễn Văn An", "Trần Đình Trọng", "Lê Quốc Trung", "Phạm Văn Quyết", "Vũ Tiến Thành", "Đặng Hữu Phúc", "Bùi Thế Anh", "Đỗ Mạnh Hùng", "Hồ Minh Quân", "Dương Nhật Nam" };
        string name = sampleNames[(i - 6) % sampleNames.Length] + $" (Std{i})";
        memberList.Add(new { Code = code, Name = name, Phone = phone, Tier = "standard", TierName = "STANDARD", Points = pts, Discount = "Tích lũy", Spend = sp, JoinDate = $"{(i % 28) + 1:00}/10/2026", Note = "Hội viên Tiêu chuẩn tích lũy" });
    }
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <div class="pos-breadcrumb d-flex align-items-center mb-3">
        <i class="bi bi-geo-alt-fill text-warning me-2"></i>
        <span class="text-secondary">Trang chủ</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-secondary">Hội viên & Giải đấu</span>
        <span class="mx-2 text-muted">/</span>
        <span class="text-white fw-semibold">Khách hàng & VIP</span>
    </div>

    <!-- Header Trang & Tác vụ nhanh -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1 d-flex align-items-center gap-2 font-heading">
                <i class="bi bi-award-fill text-warning"></i>
                HỘI VIÊN THÂN THIẾT, TÍCH ĐIỂM & GỬI CƠ
            </h2>
            <div class="text-muted small">Quản lý cấp bậc VIP, tích lũy điểm thưởng và dịch vụ bảo quản tủ đồ cơ bida riêng</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm border-secondary text-light d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalGuiCo" style="border-radius: 2px !important;">
                <i class="bi bi-safe2 text-info"></i> Nhận gửi cơ bida
            </button>
            <button class="btn btn-bolt-neon btn-sm" data-bs-toggle="modal" data-bs-target="#modalThemHoiVien" style="border-radius: 2px !important;">
                <i class="bi bi-person-plus-fill"></i> Đăng Ký Hội Viên Mới
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ KPI HỘI VIÊN (ĐỒNG BỘ 100% VỚI DANH SÁCH 156 CƠ THỦ) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: var(--primary-neon); background: rgba(166, 255, 0, 0.1);">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <p class="kpi-label">Tổng hội viên CLB</p>
                    <div class="kpi-value text-white">156 <small class="fs-6 text-muted fw-normal">Cơ thủ</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #38bdf8; background: rgba(56, 189, 248, 0.1);">
                    <i class="bi bi-gem"></i>
                </div>
                <div>
                    <p class="kpi-label">VIP Kim Cương (-15%)</p>
                    <div class="kpi-value" style="color: #38bdf8;">14 <small class="fs-6 text-info fw-normal">Thành viên</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);">
                    <i class="bi bi-shield-fill-check"></i>
                </div>
                <div>
                    <p class="kpi-label">VIP Vàng (-10%)</p>
                    <div class="kpi-value" style="color: #eab308;">38 <small class="fs-6 text-warning fw-normal">Thành viên</small></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-stat-card d-flex align-items-center gap-3">
                <div class="kpi-icon" style="color: #a855f7; background: rgba(168, 85, 247, 0.1);">
                    <i class="bi bi-star-half"></i>
                </div>
                <div>
                    <p class="kpi-label">Điểm thưởng lưu hành</p>
                    <div class="kpi-value text-white">45.200 <small class="fs-6 text-muted fw-normal">Pts</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS ĐIỀU HƯỚNG: DANH SÁCH 156 HỘI VIÊN & TỦ ĐỒ CƠ GỬI -->
    <ul class="nav nav-pills nav-pills-bolt mb-3" id="customerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-hoivien-btn" data-bs-toggle="pill" data-bs-target="#tab-hoivien" type="button" role="tab" aria-controls="tab-hoivien" aria-selected="true">
                <i class="bi bi-card-heading me-1"></i> Danh Sách Hội Viên & Điểm Tích Lũy (<span id="totalMemberBadge">156 cơ thủ</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-coguibtn" data-bs-toggle="pill" data-bs-target="#tab-cogui" type="button" role="tab" aria-controls="tab-cogui" aria-selected="false">
                <i class="bi bi-safe me-1"></i> Tủ Đồ Cá Nhân & Cơ Khách Gửi (6 Tủ đang sử dụng)
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG TABS -->
    <div class="tab-content" id="customerTabsContent">
        <!-- ========================================================================= -->
        <!-- TAB 1: DANH SÁCH ĐỦ 156 HỘI VIÊN (CÓ PHÂN TRANG & BỘ LỌC TỨC THÌ)          -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade show active" id="tab-hoivien" role="tabpanel">
            <div class="card bg-dark border-secondary border-opacity-50" style="border-radius: 2px !important;">
                <div class="card-header bg-black bg-opacity-40 border-secondary border-opacity-25 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <input type="text" id="customerSearchInput" class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Tìm theo tên hội viên, SĐT, mã thẻ..." style="width: 280px; border-radius: 2px !important;" />
                        <select id="customerTierFilter" class="form-select form-select-sm bg-black text-light border-secondary" style="width: 220px; border-radius: 2px !important;">
                            <option value="">Tất cả hạng thẻ (156)</option>
                            <option value="diamond">VIP Kim Cương (14)</option>
                            <option value="gold">VIP Vàng (38)</option>
                            <option value="silver">VIP Bạc (42)</option>
                            <option value="standard">Standard (62)</option>
                        </select>
                    </div>
                    <div class="text-muted small">
                        Hiển thị <span id="showingCount" class="text-white fw-bold">156</span> / 156 hội viên • Tích 10 điểm cho mỗi 100K chi tiêu
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" id="customersTable" style="font-size: 0.86rem;">
                        <thead class="bg-black text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-3">MÃ THẺ</th>
                                <th>HỌ VÀ TÊN CƠ THỦ</th>
                                <th>SỐ ĐIỆN THOẠI</th>
                                <th>HẠNG THÀNH VIÊN</th>
                                <th class="text-center">ĐIỂM TÍCH LŨY</th>
                                <th class="text-center">MỨC GIẢM</th>
                                <th class="text-end">TỔNG CHI TIÊU</th>
                                <th>NGÀY GIA NHẬP</th>
                                <th class="text-center pe-3">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in memberList)
                            {
                                <tr data-tier="@m.Tier" class="member-row">
                                    <td class="ps-3">
                                        <strong class="font-monospace @(m.Tier == "diamond" ? "text-info" : m.Tier == "gold" ? "text-warning" : "text-light")">@m.Code</strong>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white member-name d-flex align-items-center gap-2">
                                            <div style="width: 24px; height: 24px; border-radius: 2px; background: @(m.Tier == "diamond" ? "var(--primary-neon)" : m.Tier == "gold" ? "#eab308" : "#475569"); color: #000; font-size: 0.72rem; font-weight: bold; display: flex; align-items: center; justify-content: center;">
                                                @m.Name.Substring(0, 1)
                                            </div>
                                            <span>@m.Name</span>
                                        </div>
                                        <div class="small text-muted" style="font-size: 0.74rem;">@m.Note</div>
                                    </td>
                                    <td class="member-phone font-monospace">@m.Phone</td>
                                    <td>
                                        <span class="badge bg-black border @(m.Tier == "diamond" ? "border-info text-info" : m.Tier == "gold" ? "border-warning text-warning" : m.Tier == "silver" ? "border-secondary text-light" : "border-dark text-muted") fw-bold" style="border-radius: 2px;">
                                            @m.TierName
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold member-points" style="color: var(--primary-neon);">
                                        @m.Points.ToString("N0") Pts
                                    </td>
                                    <td class="text-center text-success fw-bold">@m.Discount</td>
                                    <td class="text-end fw-bold text-white">@m.Spend.ToString("N0") đ</td>
                                    <td class="small text-muted">@m.JoinDate</td>
                                    <td class="text-center pe-3">
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <button class="btn btn-sm btn-outline-warning p-1 px-2 me-1 btn-add-points" data-name="@m.Name" data-card="@m.Code" data-points="@m.Points" title="Cộng điểm thưởng" style="border-radius: 2px !important;">
                                                <i class="bi bi-coin"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info p-1 px-2 btn-edit-customer" data-name="@m.Name" data-card="@m.Code" data-phone="@m.Phone" data-tier="@m.Tier" data-spend="@m.Spend" title="Chỉnh sửa thông tin & ảnh đại diện" style="border-radius: 2px !important;">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary opacity-50 p-1 px-2" disabled title="Chỉ Admin/Manager được cộng điểm & sửa hạng VIP" style="border-radius: 2px !important;">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- THANH PHÂN TRANG CLIENT-SIDE CHUẨN 2PX RADIUS -->
                <div class="card-footer bg-black bg-opacity-40 border-secondary border-opacity-25 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="small text-muted">
                        Trang <strong id="currentPageNum" class="text-white">1</strong> / <span id="totalPageNum">11</span> (15 hội viên/trang)
                    </div>
                    <div class="d-flex align-items-center gap-1" id="paginationControls">
                        <button class="btn btn-dark btn-sm border-secondary text-light" id="btnPrevPage" onclick="changePage(-1);" style="border-radius: 2px !important;">
                            <i class="bi bi-chevron-left"></i> Trước
                        </button>
                        <div id="pageNumbersContainer" class="d-flex gap-1"></div>
                        <button class="btn btn-dark btn-sm border-secondary text-light" id="btnNextPage" onclick="changePage(1);" style="border-radius: 2px !important;">
                            Sau <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- TAB 2: TỦ ĐỒ CÁ NHÂN & CƠ KHÁCH GỬI (6 TỦ ĐANG SỬ DỤNG)                   -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-cogui" role="tabpanel">
            <div class="row g-3">
