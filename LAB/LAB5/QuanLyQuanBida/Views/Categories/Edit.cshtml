@model QuanLyQuanBida.Models.Category
@{
    ViewData["Title"] = $"Chỉnh sửa danh mục: {Model.Name}";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0 compact-form-shell">
    <!-- Breadcrumb điều hướng nhấn được -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="pos-breadcrumb d-flex align-items-center mb-0">
            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
            <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <a asp-controller="Categories" asp-action="Index">Danh mục hàng hóa</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-white fw-semibold">Chỉnh sửa (#@Model.Id)</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm action-btn-labeled">
                <i class="bi bi-eye"></i><span>Xem chi tiết</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm action-btn-labeled">
                <i class="bi bi-arrow-left"></i><span>Quay lại</span>
            </a>
        </div>
    </div>

    <div class="row g-3 align-items-start">
        <div class="col-12 col-lg-8">
            <div class="card form-workspace-card mode-edit">
                <div class="card-header bg-black bg-opacity-40 py-2 px-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-warning fs-5"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-white font-heading">CHỈNH SỬA DANH MỤC &amp; ẢNH ĐẠI DIỆN</h6>
                            <div class="small text-muted fw-normal" style="font-size: 0.76rem;">Cập nhật tên gọi, mã phân loại và hình ảnh đại diện của nhóm hàng hóa</div>
                        </div>
                    </div>
                    <span class="badge bg-black border border-warning text-warning font-monospace">AdminOrManager</span>
                </div>
                <div class="card-body p-3">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="ExistingImage" value="@Model.Image" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                        <div class="form-section-title">
                            <i class="bi bi-info-circle text-warning"></i> 1. Thông tin cơ bản
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-1">Mã ID</label>
                                <input class="form-control form-control-bolt font-monospace text-muted" value="#@Model.Id" readonly disabled />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label small fw-bold text-uppercase text-muted mb-1">Mã Code <span class="text-danger">*</span></label>
                                <input asp-for="Code" id="catCodeInput" class="form-control form-control-bolt font-monospace text-uppercase" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Name" class="form-label small fw-bold text-uppercase text-muted mb-1">Tên danh mục <span class="text-danger">*</span></label>
                                <input asp-for="Name" id="catNameInput" class="form-control form-control-bolt" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-section-title">
                            <i class="bi bi-image text-info"></i> 2. Cập nhật hình ảnh đại diện
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-1">Chọn ảnh mới (để trống nếu giữ ảnh cũ)</label>
                                <input type="file" name="ImageFile" id="catImageFile" class="form-control form-control-bolt" accept="image/*" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Image" class="form-label small fw-bold text-uppercase text-muted mb-1">Đường dẫn ảnh hiện tại</label>
                                <input asp-for="Image" id="catImagePath" class="form-control form-control-bolt font-monospace small" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                                <i class="bi bi-x-circle me-1"></i> Hủy thay đổi
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold btn-sm px-4">
                                <i class="bi bi-check-lg me-1"></i> Cập Nhật Danh Mục
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card detail-hero-card">
                <div class="card-body p-3">
                    <div class="form-section-title">
                        <i class="bi bi-eye text-warning"></i> Xem trước cập nhật
                    </div>
                    <div class="text-center mb-3">
                        <div class="detail-avatar-frame mb-2" style="width: 122px; height: 122px;">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img id="catPreviewImg" src="~/@Model.Image" alt="@Model.Name" class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                <img id="catPreviewImg" src="~/images/bolt-billiards-logo.png" alt="Preview" class="w-100 h-100 object-fit-cover" />
                            }
                        </div>
                        <div class="mb-2">
                            <span id="catPreviewCode" class="badge bg-black border border-info text-info font-monospace px-2 py-1">@Model.Code</span>
                        </div>
                        <h5 id="catPreviewName" class="fw-bold text-white font-heading mb-1">@Model.Name</h5>
                        <div class="small text-muted">Mã định danh CSDL: #@Model.Id</div>
                    </div>
                    <div class="p-3 bg-black bg-opacity-50 border border-warning border-opacity-25 small text-muted">
                        <i class="bi bi-arrow-repeat text-warning me-1"></i> Mọi thay đổi tên hoặc ảnh đại diện sẽ lập tức đồng bộ sang trang <strong>Thực đơn</strong> và <strong>Kho hàng</strong>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const codeEl = document.getElementById('catCodeInput');
        const nameEl = document.getElementById('catNameInput');
        const fileEl = document.getElementById('catImageFile');
        const pathEl = document.getElementById('catImagePath');
        const prevImg = document.getElementById('catPreviewImg');

        codeEl.addEventListener('input', () => {
            document.getElementById('catPreviewCode').textContent = (codeEl.value || '').trim().toUpperCase();
        });
        nameEl.addEventListener('input', () => {
            document.getElementById('catPreviewName').textContent = nameEl.value.trim();
        });
        fileEl.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = ev => prevImg.src = ev.target.result;
                reader.readAsDataURL(file);
            }
        });
        pathEl.addEventListener('input', () => {
            if (pathEl.value.trim()) prevImg.src = '/' + pathEl.value.trim().replace(/^\/+/, '');
        });
    </script>
}
