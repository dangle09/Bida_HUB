@model QuanLyQuanBida.ViewModels.StaffViewModel
@{
    ViewData["Title"] = $"Hồ sơ nhân viên: {Model.FullName}";
    Layout = "_AdminLayout";
    int invoiceCount = ViewBag.InvoiceCount ?? 0;
    decimal totalCollected = ViewBag.TotalCollected ?? 0m;
    int receiptsCount = ViewBag.ReceiptsCount ?? 0;
    string roleDesc = ViewBag.RoleDescription ?? "Nhân sự vận hành CLB Bida";
    var recentInvoices = ViewBag.RecentInvoices as List<QuanLyQuanBida.Models.Invoice> ?? new List<QuanLyQuanBida.Models.Invoice>();
    var staffLogs = ViewBag.StaffLogs as List<QuanLyQuanBida.Models.ActivityLog> ?? new List<QuanLyQuanBida.Models.ActivityLog>();
    var permissions = ViewBag.Permissions as List<QuanLyQuanBida.Models.Permission> ?? new List<QuanLyQuanBida.Models.Permission>();
}

<div class="container-fluid px-0">
    <!-- Breadcrumb & Header Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="pos-breadcrumb d-flex align-items-center mb-0">
            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
            <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <a asp-controller="Staff" asp-action="Index">Nhân sự &amp; Phân ca</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-white fw-semibold">Hồ sơ chi tiết (#@Model.Id)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm action-btn-labeled">
                <i class="bi bi-arrow-left"></i><span>Quay lại</span>
            </a>
            <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-secondary" : "btn-outline-success") btn-sm action-btn-labeled">
                    <i class="bi @(Model.IsActive ? "bi-lock" : "bi-unlock")"></i><span>@(Model.IsActive ? "Khóa TK" : "Mở khóa")</span>
                </button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark btn-sm action-btn-labeled">
                <i class="bi bi-pencil-square"></i><span>Chỉnh sửa</span>
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm action-btn-labeled">
                <i class="bi bi-trash"></i><span>Xóa</span>
            </a>
        </div>
    </div>

    <div class="row g-3 align-items-start">
        <!-- CỘT TRÁI: THẺ ĐỊNH DANH HỒ SƠ GỌN ÔM KHÍT NỘI DUNG -->
        <div class="col-12 col-lg-4">
            <div class="card detail-hero-card">
                <div class="card-body p-3 text-center">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-black border border-secondary text-secondary font-monospace">ID #@Model.Id</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success text-dark fw-bold px-2 py-1">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i>ĐANG HOẠT ĐỘNG
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger text-light fw-bold px-2 py-1">
                                <i class="bi bi-lock-fill me-1"></i>ĐÃ KHÓA TÀI KHOẢN
                            </span>
                        }
                    </div>

                    <div class="detail-avatar-frame mb-2" style="width: 108px; height: 108px;">
                        @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                        {
                            <img src="~/@Model.Avatar" alt="@Model.FullName" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center fw-black"
                                 style="background: @(Model.RoleName == "Admin" ? "linear-gradient(135deg,#a6ff00,#52b700)" : Model.RoleName == "Manager" ? "linear-gradient(135deg,#38bdf8,#0284c7)" : "linear-gradient(135deg,#fbbf24,#d97706)"); color: #05080c; font-size: 3rem; font-family: 'Montserrat', sans-serif;">
                                @Model.FullName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>

                    <h5 class="fw-bold text-white mb-1 font-heading">@Model.FullName</h5>
                    <div class="mb-2">
                        <span class="badge bg-black border border-info text-info font-monospace px-2 py-1">@@@Model.Username</span>
                    </div>
                    <div class="mb-2">
                        @if (Model.RoleName == "Admin")
                        {
                            <span class="badge bg-danger text-light px-3 py-1">👑 Quản trị viên (Admin)</span>
                        }
                        else if (Model.RoleName == "Manager")
                        {
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1">⭐ Quản lý Cơ sở (Manager)</span>
                        }
                        else if (Model.RoleName == "Cashier")
                        {
                            <span class="badge bg-info text-dark fw-bold px-3 py-1">👤 Thu ngân POS (Cashier)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-light px-3 py-1">🎱 Nhân viên (@Model.RoleName)</span>
                        }
                    </div>
                    <p class="text-muted small mb-0 px-2">@roleDesc</p>

                    <div class="mt-3 pt-3 border-top border-secondary border-opacity-25 text-start">
                        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.7rem; letter-spacing: 0.8px;">
                            <i class="bi bi-shield-check text-info me-1"></i>QUYỀN HẠN ĐƯỢC CẤP (RBAC)
                        </div>
                        @if (permissions.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var p in permissions)
                                {
                                    <span class="badge bg-black border border-secondary text-light fw-normal" style="font-size: 0.72rem;" title="@p.Name">
                                        <i class="bi bi-check2 text-success me-1"></i>@p.Code
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted">Quyền vận hành cơ bản theo vai trò @Model.RoleName.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KPI HIỆU SUẤT + THÔNG TIN TÀI KHOẢN + HOẠT ĐỘNG (ĐỒNG BỘ NỀN TỐI SÂU & RÚT GỌN) -->
        <div class="col-12 col-lg-8">
            <div class="card form-workspace-card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-vcard text-info fs-5"></i>
                        <div>
                            <h6 class="mb-0 fw-bold text-white font-heading">HỒ SƠ TÀI KHOẢN &amp; HIỆU SUẤT LÀM VIỆC</h6>
                            <div class="small text-muted fw-normal" style="font-size: 0.76rem;">Tổng hợp thông tin liên hệ, bảo mật tài khoản và kết quả vận hành của nhân viên</div>
                        </div>
                    </div>
                    <span class="badge bg-black border border-info text-info font-monospace">@@@Model.Username</span>
                </div>
                <div class="card-body p-3">
                    <!-- 3 KPI NHANH ĐỀU CHIỀU CAO -->
                    <div class="row g-2 mb-3 align-items-stretch">
                        <div class="col-12 col-md-4">
                            <div class="detail-mini-kpi" style="border-left-color: var(--primary-neon);">
                                <div class="detail-info-label text-nowrap"><i class="bi bi-cash-coin" style="color: var(--primary-neon);"></i>Doanh thu đã thu</div>
                                <div class="fs-5 fw-bold text-white font-heading lh-1 mt-1">@totalCollected.ToString("N0") <small class="fs-6 text-muted fw-normal">đ</small></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="detail-mini-kpi" style="border-left-color: #38bdf8;">
                                <div class="detail-info-label text-nowrap"><i class="bi bi-receipt text-info"></i>Hóa đơn đã lập</div>
                                <div class="fs-5 fw-bold text-info font-heading lh-1 mt-1">@invoiceCount <small class="fs-6 text-muted fw-normal">Bill</small></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="detail-mini-kpi" style="border-left-color: #eab308;">
                                <div class="detail-info-label text-nowrap"><i class="bi bi-box-seam text-warning"></i>Phiếu nhập kho</div>
                                <div class="fs-5 fw-bold text-warning font-heading lh-1 mt-1">@receiptsCount <small class="fs-6 text-muted fw-normal">Phiếu</small></div>
                            </div>
                        </div>
                    </div>

                    <!-- LƯỚI THÔNG TIN HỒ SƠ -->
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <div class="detail-info-tile py-2">
                                <div class="detail-info-label"><i class="bi bi-envelope-fill text-info"></i>Email cấp lại mật khẩu (SMTP)</div>
                                <div class="detail-info-value">@Model.Email</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="detail-info-tile py-2">
                                <div class="detail-info-label"><i class="bi bi-telephone-fill text-warning"></i>Số điện thoại liên hệ</div>
                                <div class="detail-info-value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="detail-info-tile py-2">
                                <div class="detail-info-label"><i class="bi bi-person-badge text-success"></i>Tên đăng nhập</div>
                                <div class="detail-info-value text-info font-monospace">@Model.Username</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="detail-info-tile py-2">
                                <div class="detail-info-label"><i class="bi bi-shield-lock text-danger"></i>Bảo mật mật khẩu</div>
                                <div class="detail-info-value text-success">SHA-256 Hash</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="detail-info-tile py-2">
                                <div class="detail-info-label"><i class="bi bi-calendar-check text-primary"></i>Ngày gia nhập</div>
                                <div class="detail-info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HÓA ĐƠN & HOẠT ĐỘNG GẦN ĐÂY CỦA NHÂN VIÊN NÀY -->
            <div class="card form-workspace-card overflow-hidden">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <ul class="nav nav-pills nav-pills-bolt" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active py-1 px-3 small" data-bs-toggle="pill" data-bs-target="#staff-inv-pane" type="button">
                                <i class="bi bi-receipt me-1"></i>Hóa đơn gần đây (@recentInvoices.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-1 px-3 small" data-bs-toggle="pill" data-bs-target="#staff-log-pane" type="button">
                                <i class="bi bi-clock-history me-1"></i>Nhật ký thao tác (@staffLogs.Count)
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="staff-inv-pane">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 small">
                                <thead class="text-secondary text-uppercase" style="font-size: 0.72rem;">
                                    <tr>
                                        <th class="ps-3">MÃ HÓA ĐƠN</th>
                                        <th>THỜI GIAN</th>
                                        <th class="text-end">TIỀN BÀN</th>
                                        <th class="text-end">F&amp;B</th>
                                        <th class="text-end">TỔNG THU</th>
                                        <th class="text-center pe-3">TRẠNG THÁI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (recentInvoices.Any())
                                    {
                                        foreach (var inv in recentInvoices)
                                        {
                                            <tr>
                                                <td class="ps-3 font-monospace fw-bold text-info">@inv.InvoiceCode</td>
                                                <td class="text-muted">@inv.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-end">@inv.TableAmount.ToString("N0") đ</td>
                                                <td class="text-end">@inv.ServiceAmount.ToString("N0") đ</td>
                                                <td class="text-end fw-bold" style="color: var(--primary-neon);">@inv.TotalPayment.ToString("N0") đ</td>
                                                <td class="text-center pe-3">
                                                    <span class="badge @(inv.Status == "Đã thanh toán" ? "bg-success text-dark" : "bg-warning text-dark")">@inv.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">Nhân viên này chưa lập hóa đơn POS nào.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="staff-log-pane">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 small">
                                <thead class="text-secondary text-uppercase" style="font-size: 0.72rem;">
                                    <tr>
                                        <th class="ps-3">THỜI GIAN</th>
                                        <th>HÀNH ĐỘNG</th>
                                        <th>MÔ TẢ</th>
                                        <th class="text-end pe-3">IP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (staffLogs.Any())
                                    {
                                        foreach (var l in staffLogs)
                                        {
                                            <tr>
                                                <td class="ps-3 font-monospace text-muted">@l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td><span class="badge bg-black border border-info text-info font-monospace">@l.Action</span></td>
                                                <td class="text-light">@l.Description</td>
                                                <td class="text-end pe-3 text-muted font-monospace">@(l.IpAddress ?? "127.0.0.1")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-4">Chưa có bản ghi nhật ký nào.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
